# dictee.conf — Voice dictation configuration
# This file is generated by dictee-setup but can be edited manually.
# Location: ~/.config/dictee.conf
# After manual edits, restart the daemon:
#   dictee-switch-backend asr <backend>

# ============================================================================
# ASR (speech recognition)
# ============================================================================

# Active ASR backend: parakeet | canary | whisper | whisper-rust | vosk
DICTEE_ASR_BACKEND=parakeet

# Audio source language (ISO 639-1 code)
DICTEE_LANG_SOURCE=fr

# Target language for translation (used by translation backends)
DICTEE_LANG_TARGET=en

# ── Whisper ──────────────────────────────────────────────────────────────────
# faster-whisper model: tiny, small, medium, large-v3-turbo, large-v3
# or a HuggingFace CTranslate2 repo: Systran/faster-distil-whisper-large-v3
DICTEE_WHISPER_MODEL=small

# Whisper transcription language (empty = use DICTEE_LANG_SOURCE)
#DICTEE_WHISPER_LANG=

# Whisper performance profile (HardwareProfile pattern) — controls beam_size:
# auto (detected from cores+RAM+VRAM) | ultra (beam=5) | high (beam=3) |
# medium (beam=2) | low (beam=1). Higher = more accurate, slower.
#DICTEE_HW_TIER=auto

# ── Whisper-Rust (whisper.cpp / Vulkan GPU) ──────────────────────────────────
# Separate backend from faster-whisper above. Variables are prefixed
# DICTEE_WHISPER_RUST_ so they never clash with the Python faster-whisper ones.
# Model id + resolved ggml path are written here automatically by dictee-setup:
#DICTEE_WHISPER_RUST_MODEL=large-v3
#DICTEE_WHISPER_RUST_GGML=/usr/share/dictee/whisper-rust/ggml-large-v3-q5_0.bin
#
# Decoding knobs (all optional; defaults below = the committed β / Meetily
# anti-hallucination strategy). Leave unset to keep defaults. The daemon reads
# them at startup — restart dictee-whisper-rust.service after changing.
#   DICTEE_WHISPER_RUST_TEMPERATURE_INC   0.2   α/β switch: -1 = α (no temperature
#                                               fallback, deterministic, no loops);
#                                               0.2 = β (fallback recovers hard audio)
#   DICTEE_WHISPER_RUST_TEMPERATURE       0.3   base sampling temperature
#   DICTEE_WHISPER_RUST_BEAM_SIZE         5     beam width (1 = greedy, fastest)
#   DICTEE_WHISPER_RUST_NO_SPEECH_THOLD   0.55  silence detection threshold
#   DICTEE_WHISPER_RUST_ENTROPY_THOLD     2.4   anti-loop entropy threshold
#   DICTEE_WHISPER_RUST_LOGPROB_THOLD    -1.0   confidence threshold
#   DICTEE_WHISPER_RUST_AUDIO_CTX               encoder context: unset = adaptive
#                                               (capped per clip, floored); 0 = full
#                                               (1500); N = fixed value
#
# Ready-made profiles — uncomment ONE block:
#   • Dictation (short, low-latency, loop-proof — α):
#DICTEE_WHISPER_RUST_TEMPERATURE_INC=-1
#DICTEE_WHISPER_RUST_TEMPERATURE=0
#DICTEE_WHISPER_RUST_BEAM_SIZE=1
#   • Meeting (long audio, recover hard passages — β, the defaults):
#DICTEE_WHISPER_RUST_TEMPERATURE_INC=0.2
#DICTEE_WHISPER_RUST_TEMPERATURE=0.3
#DICTEE_WHISPER_RUST_BEAM_SIZE=5

# ── Vosk ─────────────────────────────────────────────────────────────────────
# Vosk model: language code (fr, en, de, es, it, pt, ru, zh, ja)
# The daemon automatically resolves to vosk-model-small-<lang>-x.xx
DICTEE_VOSK_MODEL=fr

# ── Audio source ─────────────────────────────────────────────────────────────
# Audio source: empty = default microphone, or app:<name> (e.g. app:firefox)
#DICTEE_AUDIO_SOURCE=

# ============================================================================
# Live meetings
# ============================================================================

# Audio source for live meetings: empty = default microphone, a microphone
# device name, "<sink>.monitor" = system audio, "app:<name>" = capture ONE
# application in isolation (e.g. app:firefox) without grabbing other apps or
# disrupting playback, or "mix" = microphone + system audio.
#DICTEE_MEETING_AUDIO_SOURCE=
#
# Add your microphone on top of the captured application/system audio
# (the "Add microphone" checkbox in the meeting window). true or false.
#DICTEE_MEETING_INCLUDE_MIC=false

# ============================================================================
# Translation
# ============================================================================

# Translation backend: disabled | trans | libretranslate | ollama
DICTEE_TRANSLATE_BACKEND=disabled

# translate-shell engine (if backend=trans): google | bing
#DICTEE_TRANS_ENGINE=google

# LibreTranslate: local port and installed languages
#DICTEE_LIBRETRANSLATE_PORT=5000
#DICTEE_LIBRETRANSLATE_LANGS=de,en,fr,it,pt

# Ollama: translation model and forced CPU mode
#DICTEE_OLLAMA_MODEL=translategemma
#OLLAMA_NUM_GPU=0

# ============================================================================
# Push-to-talk (keyboard shortcuts)
# ============================================================================

# Mode: hold (press and hold) | toggle (press to start/stop)
DICTEE_PTT_MODE=hold

# PTT key (evdev code, 67=F9)
DICTEE_PTT_KEY=67

# Translation PTT key (0 = disabled)
#DICTEE_PTT_KEY_TRANSLATE=0

# Translation modifier: alt | ctrl | shift (with same PTT key).
# Use the bare modifier name only. Do NOT use a "same_" prefix here (e.g.
# "same_ctrl"): that is an internal dictee-setup UI encoding, not a valid
# config value. dictee-ptt silently ignores an unrecognized modifier, so
# translation would never fire. Write "ctrl", not "same_ctrl".
#DICTEE_PTT_MOD_TRANSLATE=

# Extra input devices to listen to (push-to-talk via virtual keyboards).
# By default, dictee-ptt excludes devices whose name contains "virtual",
# "uinput", "dotool" or "dictee-ptt" to avoid feedback loops. If you remap
# mouse buttons or keys via logiops, keyd, evsieve, kmonad, etc., add the
# device name substring(s) here (comma-separated, case-insensitive).
# Find your device name with: cat /proc/bus/input/devices
#DICTEE_PTT_EXTRA_DEVICES="LogiOps Virtual Input,keyd virtual keyboard"

# Typing settle delay, in seconds (default 0 = off). dictee types the
# transcript through a virtual keyboard it creates for each dictation. On some
# Wayland setups a tool like input-remapper installs a udev rule that runs on
# every new input device, delaying the compositor binding past the built-in
# settle, so the keystrokes are emitted before anything listens and the text is
# lost. Set 1-2 s to give the compositor time to bind. Most users leave this 0.
#DICTEE_DOTOOL_SETTLE=0

# Keyboard layout for typing (dotool). dictee types via dotool, which sends raw
# key codes that your compositor decodes with its ACTIVE keyboard layout. Since
# v1.3.6 dictee auto-detects your active layout and variant on KDE and GNOME. On
# other compositors (sway, Hyprland, ...), or if the wrong characters are typed
# (e.g. commas or question marks come out as other characters on a non-US layout
# such as Neo, or accents are dropped on US/Dvorak/AZERTY), set these to match
# the layout you actually type under. Both lines are needed when a variant is
# used. Setting DOTOOL_XKB_LAYOUT here turns OFF auto-detection (the value is
# then fixed and no longer follows layout switches). Check your active layout
# with: localectl status   (or: setxkbmap -query)
# Examples:  German Neo -> layout=de, variant=neo   |   plain German -> layout=de
#DOTOOL_XKB_LAYOUT=de
#DOTOOL_XKB_VARIANT=neo

# ============================================================================
# Display and feedback
# ============================================================================

# Copy transcription to clipboard.
# WARNING: on Wayland with wl-clipboard < 2.3.0, enabling this can prevent
# the transcript from being typed into some Electron apps. See README.
DICTEE_CLIPBOARD=false

# How the transcription reaches you (issue #28):
#   type      - simulate key presses via dotool (default). Requires dotool to
#               know your exact keyboard layout; exotic layouts (Neo, ...)
#               may get some punctuation wrong.
#   paste     - copy to clipboard then paste with Shift+Insert. Works with
#               any keyboard layout, in GUI apps AND in most terminals
#               (Konsole, GNOME Terminal, ...). Overwrites the clipboard
#               (and the primary selection) on every dictation. On Wayland
#               with wl-clipboard < 2.3.0 the paste mode can lose text in
#               some Electron apps (brief focus steal by wl-copy, same
#               mechanism as the DICTEE_CLIPBOARD warning above);
#               "clipboard" is not affected.
#   clipboard - copy to clipboard only, nothing is typed or pasted. You paste
#               the text yourself. Cross-push continuation is disabled (each
#               dictation is independent).
DICTEE_OUTPUT_MODE=type

# Speech animation overlay (Wayland layer-shell: KDE, Sway, Hyprland)
DICTEE_ANIM_SPEECH=true

# KDE Plasma widget (panel / taskbar)
DICTEE_ANIM_PLASMOID=false

# ============================================================================
# Text post-processing
# ============================================================================

# Enable post-processing (punctuation, rules, etc.)
DICTEE_POSTPROCESS=true

# Language-specific rules (false to disable)
#DICTEE_PP_ELISIONS=true
#DICTEE_PP_ELISIONS_IT=true
#DICTEE_PP_SPANISH=true
#DICTEE_PP_PORTUGUESE=true
#DICTEE_PP_GERMAN=true
#DICTEE_PP_DUTCH=true
#DICTEE_PP_ROMANIAN=true

# General rules
#DICTEE_PP_NUMBERS=true
#DICTEE_PP_TYPOGRAPHY=true
#DICTEE_PP_CAPITALIZATION=true
#DICTEE_PP_DICT=true
#DICTEE_PP_RULES=true
#DICTEE_PP_CONTINUATION=true
#DICTEE_PP_SHORT_TEXT=true

# LLM post-processing (requires ollama)
#DICTEE_LLM_POSTPROCESS=false
#DICTEE_LLM_MODEL=gemma3:4b
#DICTEE_LLM_TIMEOUT=10
#DICTEE_LLM_CPU=false
#DICTEE_LLM_SYSTEM_PROMPT=default
#DICTEE_LLM_POSITION=hybrid

# ============================================================================
# Voice command suffixes
# ============================================================================

# Keyword appended after a voice command to distinguish it from dictation
# One per language (regex, empty = no suffix)
#DICTEE_COMMAND_SUFFIX_FR=finale?s?
#DICTEE_COMMAND_SUFFIX_EN=done
#DICTEE_COMMAND_SUFFIX_ES=listo
#DICTEE_COMMAND_SUFFIX_DE=weiter
#DICTEE_COMMAND_SUFFIX_IT=seguito
#DICTEE_COMMAND_SUFFIX_PT=pronto
#DICTEE_COMMAND_SUFFIX_UK=далі

# ============================================================================
# Notifications
# ============================================================================

# Enable desktop notifications (recording start/end, errors)
#DICTEE_NOTIFICATIONS=true

# Display transcribed text in notification
#DICTEE_NOTIFICATIONS_TEXT=true

# ============================================================================
# Audio context buffer
# ============================================================================

# Enable audio buffer (concatenates previous recording for context)
# Improves homophones and words split between two pushes
DICTEE_AUDIO_CONTEXT=true

# Max buffer duration in seconds (beyond this, the buffer is cleared)
DICTEE_AUDIO_CONTEXT_TIMEOUT=30

# ============================================================================
# GPU / CPU mode (advanced)
# ============================================================================

# Force CPU mode for all ASR backends, even if a GPU is detected.
# Truthy values: 1, true, yes (case-insensitive).
# Anything else (0, false, no, empty, unset) → GPU used if available.
# Use cases:
#   - laptop on battery (CPU mode is more power-efficient)
#   - GPU shared with other workloads (Ollama, games)
#   - debugging GPU-specific issues
# WARNING: Canary 1B is very slow on CPU (~5 s for 16 s audio, vs 0.65 s GPU).
#DICTEE_FORCE_CPU=0

# ============================================================================
# Parakeet quantization (advanced)
# ============================================================================

# Parakeet TDT model variant: int8 | fp32
# - int8: ~670 MB, faster on CPU with AVX-VNNI (-38 % latency measured),
#   negligible WER loss (~0-1 % depending on audio).
# - fp32: ~2.4 GB, best accuracy and fastest on GPU (CUDA Tensor Cores
#   don't benefit from int8 quantization in current ONNX Runtime).
# Recommended:
#   - CPU-only or low-VRAM GPU (< 4 GB): int8
#   - GPU with ≥ 4 GB VRAM: fp32
# The model files must be present on disk (~/.local/share/dictee/tdt/
# or /usr/share/dictee/tdt/). If both variants are installed, this var
# selects which one the daemon loads at startup.
#DICTEE_PARAKEET_QUANT=int8

# ============================================================================
# ORT threading (advanced)
# ============================================================================

# Number of ONNX Runtime threads for Parakeet/Canary transcription.
# Default: auto-detect (min(8, CPU thread count)).
# ⚠ DO NOT exceed your CPU's thread count (use `nproc` to check),
#   otherwise oversubscription → worse performance than default.
# Useful overrides:
#   - laptop on battery: low value (2-4) to save power
#   - container/VM with misconfigured cgroups
#   - shared workload (compilation, encoding) alongside dictation
# Valid range: 1 to 64
#DICTEE_INTRA_THREADS=8

# ============================================================================
# Debug
# ============================================================================

# Enable debug logs (shell + Rust + Python)
# Logs in /tmp/dictee-debug-<uid>.log
#DICTEE_DEBUG=false

# ============================================================================
# Diarization (internal)
# ============================================================================

# ASR backend used before switching to diarization mode (restored after)
# Managed automatically by dictee-switch-backend, do not modify
#DICTEE_PRE_DIARIZE_BACKEND=

# ============================================================================
# Internal marker — do not modify
# ============================================================================
DICTEE_SETUP_DONE=true
