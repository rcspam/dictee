class MeetingWindow(QWidget):
    """Minimal meeting capture window with collapsible live preview accordion.

    Captures audio with pw-record until the user clicks Stop, then launches
    `dictee-transcribe --file <audio.wav> --diarize` to open the familiar
    transcription window for diarization + LLM analysis + export.

    The live preview accordion streams chunk-by-chunk transcript during
    recording — it is a bonus preview only.
    """

    SPEAKER_COLORS = [
        "#1976D2",  # blue
        "#388E3C",  # green
        "#F57C00",  # orange
        "#C62828",  # red
    ]

    def __init__(self):
        super().__init__()
        self.setWindowTitle("Réunion live — capture")
        # Minimum width 800; compact height while the accordion is collapsed,
        # 800 tall when it opens (see _on_preview_toggled). The window stays
        # user-resizable beyond these.
        self.setMinimumWidth(800)
        self.resize(800, 220)

        self.audio_worker = None
        self._meter_mic = None       # LevelMeterWorker for the 🎤 flow
        self._meter_sys = None       # LevelMeterWorker for the 🔊 flow
        # Dedicated dictee-app-capture for an app source's ISOLATED 🔊 meter
        # preview (before recording) — so the meter shows only that app.
        self._preview_proc = None    # QProcess
        self._preview_app = None
        self._preview_sink = None
        self._preview_ready = False
        self.meeting_dir = None
        self.audio_wav = None
        self.transcript_path = None
        self.elapsed_seconds = 0
        self.speakers_seen = set()
        self._state = "idle"         # idle | recording | paused | stopped

        # Speaker naming (purely visual for live preview)
        self._speaker_name_map = {}      # {speaker_id: user_provided_name}
        self._speaker_row_widgets = {}   # {speaker_id: QLineEdit} for dynamic update

        self.chunker = None
        self.transcriber = None
        self.diarizer = None
        self.aligner = None

        self._tick_timer = QTimer(self)
        self._tick_timer.timeout.connect(self._tick)
        self._tick_timer.setInterval(1000)

        self._build_ui()
        self._populate_sources()
        self._init_levels()            # 🎤 ← system mic, 🔊 ← remembered level
        self._update_level_sliders()   # reflect the populated/selected source
        self._apply_window_behavior()
        self._set_state("idle")

        # Signal to plasmoid/tray that meeting-live UI is open
        try:
            Path("/dev/shm/.dictee_state").write_text("meeting-ui-open\n")
        except OSError:
            pass

    def _apply_icon(self, recording):
        # Red icon while recording, black otherwise — on the window AND the
        # QApplication (taskbar). Works because we don't call setDesktopFileName.
        icon = _meeting_icon(recording)
        self.setWindowIcon(icon)
        app = QApplication.instance()
        if app is not None:
            app.setWindowIcon(icon)

    def _blink_rec_dot(self):
        # Blink the COLOR (not visibility) so the dot keeps its width and the
        # status text never shifts. Red while recording, themed while paused.
        self._dot_on = not getattr(self, "_dot_on", True)
        on_color = "#E53935" if self._state == "recording" else "#EF9A9A"  # red / pale-red
        self.rec_dot.setStyleSheet(
            (f"color: {on_color};" if self._dot_on else "color: transparent;")
            + " font-size: 16pt;")

    def _set_state(self, state):
        self._state = state
        recording = state == "recording"
        paused = state == "paused"

        # (btn_start text, tooltip, start_enabled, stop_enabled, analyze_enabled)
        cfg = {
            "idle":      ("▶", "Démarrer",  True,  False, False),
            "recording": ("⏸", "Pause",     True,  True,  False),
            "paused":    ("▶", "Reprendre", True,  True,  False),
            "stopped":   ("▶", "Démarrer",  False, False, True),
        }
        text, tip, start_on, stop_on, analyze_on = cfg[state]
        self.btn_start.setText(text)
        self.btn_start.setToolTip(tip)
        self.btn_start.setEnabled(start_on)
        self.btn_stop.setEnabled(stop_on)
        self.btn_analyze.setEnabled(analyze_on)
        # Source and title can't change mid-capture: only editable when idle/stopped.
        self.cmb_source.setEnabled(state in ("idle", "stopped"))
        self.chk_include_mic.setEnabled(state in ("idle", "stopped"))
        self._title_edit.setEnabled(state in ("idle", "stopped"))
        # Live chunking indicators: only meaningful while capturing.
        if getattr(self, "_chunk_indicators", None) is not None:
            self._chunk_indicators.setVisible(state in ("recording", "paused"))

        self.status_label.setText({
            "idle": "Prêt à enregistrer",
            "recording": "Enregistrement en cours",
            "paused": "Enregistrement en pause",
            "stopped": "Enregistrement arrêté",
        }[state])

        if recording or paused:
            # Glyph only; _blink_rec_dot owns the colour (red vs pale-red).
            self.rec_dot.setText("●" if recording else "❚❚")
            self.rec_dot.setVisible(True)
            self._dot_on = False
            self._blink_rec_dot()        # paint lit immediately
            self._blink_timer.start()
        else:
            self._blink_timer.stop()
            self.rec_dot.setVisible(False)

        self._apply_icon(recording)      # red icon only while recording

    def _on_start_pause(self):
        if self._state == "idle":
            self.start_meeting()
        elif self._state == "recording":
            if self.audio_worker:
                self.audio_worker.pause()
            self._tick_timer.stop()
            self._set_state("paused")
        elif self._state == "paused":
            if self.audio_worker:
                self.audio_worker.resume()
            self._tick_timer.start()
            self._set_state("recording")

    def _build_ui(self):
        # No SetFixedSize here: the window must stay user-resizable. We grow it
        # when the preview accordion opens and shrink it back when it closes
        # (in _on_preview_toggled). NOTE: any transient "stretch" of the top
        # zone during the resize is KWin's "Geometry Change" desktop effect
        # animating the window resize — NOT this layout (the top zone measures
        # rock-steady). Disable that effect (globally, or via a KWin window
        # rule on this window) to remove it.
        layout = QVBoxLayout(self)

        # ── Top zone: left controls column + right "Niveaux" column ──
        top_row = QHBoxLayout()
        left_col = QVBoxLayout()

        status_row = QHBoxLayout()
        self.rec_dot = QLabel("●")
        self.rec_dot.setStyleSheet("color: #E53935; font-size: 16pt;")
        self.rec_dot.setAlignment(Qt.AlignmentFlag.AlignCenter)
        # Reserve a fixed slot so the glyph (●/❚❚) and its show/hide never shift
        # the status text — picto and text don't fight over each other's space.
        self.rec_dot.setFixedWidth(34)
        _rdsp = self.rec_dot.sizePolicy()
        _rdsp.setRetainSizeWhenHidden(True)
        self.rec_dot.setSizePolicy(_rdsp)
        self.rec_dot.setVisible(False)
        status_row.addWidget(self.rec_dot)
        self.status_label = QLabel("Prêt à enregistrer")
        self.status_label.setStyleSheet("font-size: 14pt; padding: 12px;")
        status_row.addWidget(self.status_label, 1)
        left_col.addLayout(status_row)

        # Blinking red dot timer (active only while recording)
        self._blink_timer = QTimer(self)
        self._blink_timer.setInterval(500)
        self._blink_timer.timeout.connect(self._blink_rec_dot)

        self.duration_label = QLabel("00:00")
        self.duration_label.setStyleSheet("font-size: 24pt; font-family: monospace; padding: 8px;")
        left_col.addWidget(self.duration_label)

        # Title field: editable before/after capture, frozen during recording
        title_row = QHBoxLayout()
        title_row.addWidget(QLabel("Titre :"))
        self._title_edit = QLineEdit()
        self._title_edit.setPlaceholderText("Titre de la réunion (optionnel)")
        self._title_edit.setText("Réunion " + datetime.now().strftime("%Y-%m-%d %H:%M"))
        title_row.addWidget(self._title_edit, 1)
        left_col.addLayout(title_row)

        # Audio source selector (populated from dictee-audio-sources)
