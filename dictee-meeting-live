        self._speakers_form = QFormLayout(speakers_group)
        self._speakers_form.setLabelAlignment(Qt.AlignmentFlag.AlignRight)
        # Empty by default — filled dynamically by _on_aligned
        preview_layout.addWidget(speakers_group)

        layout.addWidget(self.preview_content)
        # Absorb any transient slack AT THE BOTTOM during the show/hide relayout.
        # SetFixedSize re-sizes the window on the NEXT event loop, so for one
        # frame there is extra space; without this stretch it is distributed
        # over the widgets and the top zone visibly stretches (Qt forum: a child
        # smaller than its cell is placed per alignment). The stretch has
        # sizeHint 0, so it doesn't affect the final compact size.
        layout.addStretch(1)

        # Plain show/hide, exactly like dictee-setup's accordions (_on_info_toggled:
        # just box.setVisible(on) — no animation, no manual resize). The central
        # layout's SetFixedSize then snaps the window to the new content size.
        self.preview_content.setVisible(False)
        self.preview_toggle.toggled.connect(self._on_preview_toggled)

    def _build_level_slider(self, emoji):
        """One vertical volume slider + % label. Disabled (greyed) until the
