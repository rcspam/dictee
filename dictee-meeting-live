        btn_row.addWidget(self.btn_analyze)

        self._btn_open_transcribe = QPushButton("Ouvrir l'analyse…")
        self._btn_open_transcribe.setToolTip(
            "Ouvrir dictee-transcribe pour analyser / ré-transcrire un fichier")
        self._btn_open_transcribe.clicked.connect(self._on_open_transcribe)
        btn_row.addWidget(self._btn_open_transcribe)

        btn_row.addStretch(1)
        left_col.addLayout(btn_row)
        top_row.addLayout(left_col, 1)

        # Right column — "Niveaux": per-flow volume sliders + meters.
        # Backend (per-source volume + live peak meter) not wired yet → greyed.
        levels_group = QGroupBox("Niveaux")
        levels_group.setStyleSheet("QGroupBox { font-weight: bold; }")
        levels_layout = QHBoxLayout(levels_group)
        self.slider_mic = self._build_level_slider("🎤")
        self.slider_sys = self._build_level_slider("🔊")
        self.slider_mic["slider"].valueChanged.connect(self._on_mic_slider)
        self.slider_sys["slider"].valueChanged.connect(self._on_sys_slider)
        # Debounce the (subprocess) volume application so dragging stays smooth:
        # the label tracks live, pactl/wpctl runs only when the drag pauses.
        self._mic_vol_timer = QTimer(self)
        self._mic_vol_timer.setSingleShot(True)
        self._mic_vol_timer.setInterval(60)
        self._mic_vol_timer.timeout.connect(self._apply_mic_vol)
        self._sys_vol_timer = QTimer(self)
        self._sys_vol_timer.setSingleShot(True)
        self._sys_vol_timer.setInterval(60)
        self._sys_vol_timer.timeout.connect(self._apply_sys_vol)
        # Live-sync the 🎤 slider with the system mic level so an external change
        # (plasmoid, system mixer, dictee-setup) is reflected here too. Instant
        # via 'pactl subscribe'; the timer is a slow safety-net fallback.
        self._mic_sync_timer = QTimer(self)
        self._mic_sync_timer.setInterval(2000)
        self._mic_sync_timer.timeout.connect(self._poll_mic_level)
        self._mic_sync_timer.start()
        self._mic_watcher = SourceVolumeWatcher()
        self._mic_watcher.source_changed.connect(self._poll_mic_level)
        self._mic_watcher.start()
        levels_layout.addLayout(self.slider_mic["col"])
        levels_layout.addLayout(self.slider_sys["col"])
        top_row.addWidget(levels_group)

        # Wrap the top zone so it does NOT stretch vertically — only the
        # accordion below absorbs extra height. The vertical level sliders
        # (Expanding) then track the left column's height instead of inflating
        # the window. (kde-plasmoid skill: "constrain aux columns to the main
        # content height" — Qt-widgets equivalent of binding to implicitHeight.)
        header = QWidget()
        header.setLayout(top_row)
        # Fixed vertical policy: the top zone keeps EXACTLY its sizeHint height
        # and can neither stretch nor compress during the accordion's show/hide
        # relayout — so it never moves, open or closed.
        header.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Fixed)
        layout.addWidget(header)

        # Live preview accordion (clickable header + collapsible content)
        self.preview_toggle = QToolButton()
        self.preview_toggle.setText("Aperçu en direct")
        self.preview_toggle.setCheckable(True)
        self.preview_toggle.setChecked(False)
        self.preview_toggle.setArrowType(Qt.ArrowType.RightArrow)
        self.preview_toggle.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextBesideIcon)
        self.preview_toggle.setStyleSheet(
            "QToolButton { border: none; font-weight: bold; padding: 6px; text-align: left; }"
            "QToolButton:hover { background-color: rgba(0,0,0,0.05); }"
        )

        # Live chunking indicators (thin bars + small fonts) just above the
        # "Aperçu en direct" accordion. Bar 1 ("Chunk en cours") = the new audio
        # accumulating toward the next live update (also = the tail still pending
        # if you stop now). Bar 2 ("Contexte") = the overlap window reused as
        # look-back context by the model. Driven by _tick, visible while recording.
        self._chunk_indicators = QWidget()
        _ind = QVBoxLayout(self._chunk_indicators)
        _ind.setContentsMargins(6, 0, 6, 2)
        _ind.setSpacing(1)
        _SMALL = "font-size: 8pt; color: gray;"

        def _ind_row(caption, color):
            row = QHBoxLayout()
            row.setSpacing(4)
            cap = QLabel(caption)
            cap.setStyleSheet(_SMALL)
            cap.setFixedWidth(90)
            bar = QProgressBar()
            bar.setTextVisible(False)
            bar.setRange(0, 100)
            bar.setFixedHeight(5)
            bar.setStyleSheet(
                "QProgressBar { border: none; background: rgba(0,0,0,0.08); "
                "border-radius: 2px; }"
                f"QProgressBar::chunk {{ background-color: {color}; border-radius: 2px; }}")
            val = QLabel("")
            val.setStyleSheet(_SMALL)
            val.setFixedWidth(70)
            val.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
            row.addWidget(cap)
            row.addWidget(bar, 1)
            row.addWidget(val)
            _ind.addLayout(row)
            return bar, val, cap

        # Chunk caption is dynamic ("Chunk N", updated in _update_chunk_indicators);
        # its fixed width reserves space so the bar never shifts as N grows.
        self._bar_chunk, self._chunk_val, self._lbl_chunk = _ind_row("Chunk 1", "#e74c3c")
        self._bar_ctx, self._ctx_val, _ = _ind_row("Contexte", "#27ae60")
        # Smooth the per-second jumps: animate each bar toward its new target
        # over ~1 s (linear) instead of snapping. _update_chunk_indicators sets
        # the targets once per tick; these slide there continuously.
        self._anim_chunk = QPropertyAnimation(self._bar_chunk, b"value")
        self._anim_chunk.setDuration(950)
        self._anim_chunk.setEasingCurve(QEasingCurve.Type.Linear)
        self._anim_ctx = QPropertyAnimation(self._bar_ctx, b"value")
        self._anim_ctx.setDuration(950)
        self._anim_ctx.setEasingCurve(QEasingCurve.Type.Linear)
        self._chunk_indicators.setVisible(False)   # only while recording
        layout.addWidget(self._chunk_indicators)

        layout.addWidget(self.preview_toggle)

        self.preview_content = QFrame()
        self.preview_content.setFrameShape(QFrame.Shape.StyledPanel)
        preview_layout = QVBoxLayout(self.preview_content)
        preview_layout.setContentsMargins(4, 4, 4, 4)
        self.transcript_view = QTextEdit()
        self.transcript_view.setReadOnly(True)
        self.transcript_view.setStyleSheet("font-family: monospace; font-size: 10pt;")
        self.transcript_view.setMinimumHeight(180)
        # stretch=1: the transcript fills the accordion's vertical space (the
        # speakers panel below keeps its sizeHint), so it grows with the window.
        preview_layout.addWidget(self.transcript_view, 1)

        # Speakers naming panel (inside accordion, below transcript view)
        speakers_group = QGroupBox("Speakers détectés")
        speakers_group.setStyleSheet("QGroupBox { font-weight: bold; }")
        self._speakers_form = QFormLayout(speakers_group)
        self._speakers_form.setLabelAlignment(Qt.AlignmentFlag.AlignRight)
        # Empty by default — filled dynamically by _on_aligned
        preview_layout.addWidget(speakers_group)

        # stretch=1: the accordion absorbs all extra window height. When OPEN it
        # makes the transcript fill down to the bottom and resize with the
        # window; when CLOSED (hidden, size 0) its stretchy empty cell still
        # soaks up any slack so the top zone stays pinned and never stretches.
        # This replaces the previous bottom addStretch(1).
        layout.addWidget(self.preview_content, 1)

        # Plain show/hide, exactly like dictee-setup's accordions (_on_info_toggled:
        # just box.setVisible(on) — no animation, no manual resize). The central
        # layout's SetFixedSize then snaps the window to the new content size.
        self.preview_content.setVisible(False)
        self.preview_toggle.toggled.connect(self._on_preview_toggled)

        self._update_level_sliders()   # set initial enabled/greyed state

    def _build_level_slider(self, emoji):
        """A native QSlider (volume) next to a vertical QProgressBar (live VU
        meter) + % label. Enabled/greyed per source by _update_level_sliders."""
        col = QVBoxLayout()
        top = QLabel(emoji)
        top.setAlignment(Qt.AlignmentFlag.AlignHCenter)
        col.addWidget(top)

        row = QHBoxLayout()
        row.setSpacing(3)
        slider = QSlider(Qt.Orientation.Vertical)
        slider.setRange(0, 100)
        slider.setValue(70)
        slider.setMinimumHeight(130)
        meter = QProgressBar()
        meter.setOrientation(Qt.Orientation.Vertical)
        meter.setRange(0, 100)
        meter.setValue(0)
        meter.setTextVisible(False)
        meter.setFixedWidth(10)
        meter.setMinimumHeight(130)
        # green → yellow → red gradient, bottom-to-top
        meter.setStyleSheet(
            "QProgressBar { background: palette(base); border: 1px solid "
            "palette(mid); border-radius: 3px; }"
            "QProgressBar::chunk { border-radius: 3px; background: "
            "qlineargradient(x1:0, y1:1, x2:0, y2:0, stop:0 #2ecc71, "
            "stop:0.6 #f1c40f, stop:0.85 #e67e22, stop:1 #e74c3c); }"
        )
        slider.setFixedWidth(20)
        row.addWidget(slider, 0, Qt.AlignmentFlag.AlignHCenter)
        row.addWidget(meter, 0, Qt.AlignmentFlag.AlignHCenter)
        col.addLayout(row, 1)

        pct = QLabel("—")
        pct.setEnabled(False)
        pct.setAlignment(Qt.AlignmentFlag.AlignHCenter)
        # Fixed width so the "70%"→"100%"→"5%" text changes during a drag don't
        # reflow the column (which made the Niveaux pad jitter horizontally).
        pct.setFixedWidth(48)
        col.addWidget(pct)
        return {"col": col, "slider": slider, "meter": meter, "label": pct}

    def _meeting_source(self):
        """Read DICTEE_MEETING_AUDIO_SOURCE from conf (default 'mix')."""
        conf = Path.home() / ".config/dictee.conf"
        if conf.is_file():
            try:
                for line in conf.read_text(encoding="utf-8").splitlines():
                    s = line.strip()
                    if s.startswith("DICTEE_MEETING_AUDIO_SOURCE="):
                        v = s.split("=", 1)[1].strip().strip('"').strip("'")
                        return v or "mix"
            except OSError:
                pass
        return "mix"

    def _meeting_include_mic(self):
        conf = Path.home() / ".config/dictee.conf"
        if conf.is_file():
            try:
                for line in conf.read_text(encoding="utf-8").splitlines():
                    s = line.strip()
                    if s.startswith("DICTEE_MEETING_INCLUDE_MIC="):
                        return s.split("=", 1)[1].strip().strip('"').strip("'").lower() in ("true", "1", "yes")
            except OSError:
                pass
        return False

    def _populate_sources(self):
        """Fill the source combo from the single source of truth
        (dictee-audio-sources), then select the saved meeting source."""
        self.cmb_source.blockSignals(True)
        self.cmb_source.clear()
        # 'mix' is meeting-only — added here, NOT in the shared
        # dictee-audio-sources helper (which also feeds the F9 selector, where
        # 'mix' would be invalid and break dictee's source resolution).
        self.cmb_source.addItem("🎙 Mix micro + audio système", "mix")
        try:
            out = subprocess.check_output(
                ["dictee-audio-sources"], timeout=3, text=True,
                stderr=subprocess.DEVNULL)
        except Exception:
            out = ""
        for line in out.splitlines():
            parts = line.split("|", 2)
            if len(parts) != 3:
                continue
            value, _icon, label = parts
            if value == "mix":          # guard, should never come from helper
                continue
            self.cmb_source.addItem(label, value)
        idx = self.cmb_source.findData(self._meeting_source())
        if idx >= 0:
            self.cmb_source.setCurrentIndex(idx)
        self.cmb_source.blockSignals(False)

    def _on_source_changed(self, _idx):
        value = self.cmb_source.currentData()
        if value is not None:
            self._write_conf_key("DICTEE_MEETING_AUDIO_SOURCE", value)
        self._load_sys_level_for_source()   # restore this source's 🔊 level
        self._update_level_sliders()

    def _on_include_mic_toggled(self, on):
        self._write_conf_key("DICTEE_MEETING_INCLUDE_MIC",
                             "true" if on else "false")
        self._update_level_sliders()

    # ── Level sliders (🎤 mic / 🔊 selected output) ─────────────────────────
    def _active_flows(self):
        """Return (mic_active, sys_active) for the current source + add-mic.

        mix → both; app: → system (+ mic if 'add mic'); *.monitor → system;
        microphone / default → mic only.
        """
        src = self.cmb_source.currentData() or ""
        if src == "mix":
            return True, True
        if src.startswith("app:"):
            return self.chk_include_mic.isChecked(), True
        if src.endswith(".monitor"):
            return False, True
        return True, False

    def _update_level_sliders(self):
        """Enable/grey each slider+meter for the current source; refresh labels,
        then (re)start the live meters for the active flows."""
        mic_on, sys_on = self._active_flows()
        for d, on in ((self.slider_mic, mic_on), (self.slider_sys, sys_on)):
            d["slider"].setEnabled(on)
            d["meter"].setEnabled(on)
            d["label"].setEnabled(on)
            d["label"].setText(f"{d['slider'].value()}%" if on else "—")
            if not on:
                d["meter"].setValue(0)
        self._refresh_meters()

    def _pactl_vol(self, args):
        # Fire-and-forget so the GUI thread never blocks on the subprocess.
        try:
            subprocess.Popen(["pactl", *args],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def _on_mic_slider(self, v):
        # Live label only; the actual volume change is debounced (see __init__).
        self.slider_mic["label"].setText(f"{v}%")
        self._mic_vol_timer.start()

    def _on_sys_slider(self, v):
        self.slider_sys["label"].setText(f"{v}%")
        self._sys_vol_timer.start()

    def _apply_mic_vol(self):
        # The mic level IS the system @DEFAULT_SOURCE@ level — shared with the
        # plasmoid, dictee-setup and the system mixer (single source of truth).
        # Permanent, like the plasmoid (no snapshot/restore). In mix / app+mic
        # the mic loopback stays at 100%, so this governs the captured mic too.
        v = self.slider_mic["slider"].value()
        self._pactl_vol(["set-source-volume", "@DEFAULT_SOURCE@", f"{v}%"])

    def _system_mic_percent(self, default=70):
        """Current system mic volume (% of @DEFAULT_SOURCE@) so the meeting
        slider starts aligned with the plasmoid / dictee-setup / system mixer."""
        try:
            out = subprocess.check_output(
                ["wpctl", "get-volume", "@DEFAULT_SOURCE@"], text=True, timeout=2)
            m = re.search(r"([0-9]+(?:\.[0-9]+)?)", out)   # "Volume: 0.60"
            if m:
                return max(0, min(150, round(float(m.group(1)) * 100)))
        except Exception:
            pass
        try:
            out = subprocess.check_output(
                ["pactl", "get-source-volume", "@DEFAULT_SOURCE@"],
                text=True, env=dict(os.environ, LC_ALL="C"), timeout=2)
            m = re.search(r"(\d+)%", out)
            if m:
                return max(0, min(150, int(m.group(1))))
        except Exception:
            pass
        return default

    def _poll_mic_level(self):
        """Keep the 🎤 slider live-synced with the system mic level (shared with
        the plasmoid / system mixer): an external change (plasmoid, mixer) is
        reflected here too. Skipped while the user drags the slider."""
        s = self.slider_mic["slider"]
        if s.isSliderDown():
            return
        cur = self._system_mic_percent(default=s.value())
        if cur != s.value():
            s.blockSignals(True)
            s.setValue(cur)
            s.blockSignals(False)
            if s.isEnabled():
                self.slider_mic["label"].setText(f"{cur}%")

    def _apply_sys_vol(self):
        v = self.slider_sys["slider"].value()
        src = self.cmb_source.currentData() or ""
        self._save_source_level(src, v)   # remember across sessions
        w = self.audio_worker
        if w and w._sys_input_id:
            # mix, or app+mic: the system/app contribution is a dedicated
            # loopback whose volume is independent of the mic.
            w.set_system_volume(v)
        elif src.startswith("app:"):
            # app-only (no mic): attenuate the private isolated capture sink
            # (does NOT touch the app's real playback).
            if w and w._appcap_sink:
                self._pactl_vol(
                    ["set-sink-volume", w._appcap_sink, f"{v}%"])
        elif src.endswith(".monitor"):
            self._pactl_vol(
                ["set-sink-volume", src[:-len(".monitor")], f"{v}%"])

    def _apply_mix_levels(self):
        """Push the 🔊 slider value onto the system/app loopback. The mic is
        governed by the system @DEFAULT_SOURCE@ level (its loopback stays at
        100%), so it is NOT pushed here."""
        if self.audio_worker:
            self.audio_worker.set_system_volume(self.slider_sys["slider"].value())

    # ── Per-source 🔊 level persistence (meeting-only JSON, not dictee.conf
    #    which is bash-sourced) ────────────────────────────────────────────────
    def _levels_path(self):
        return Path.home() / ".config/dictee/meeting-levels.json"

    def _load_source_level(self, source, default=70):
        try:
            data = json.loads(self._levels_path().read_text(encoding="utf-8"))
            return max(0, min(100, int(data.get(source, default))))
        except Exception:
            return default

    def _save_source_level(self, source, level):
        p = self._levels_path()
        try:
            data = json.loads(p.read_text(encoding="utf-8")) if p.is_file() else {}
        except Exception:
            data = {}
        data[source] = max(0, min(100, int(level)))
        try:
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(json.dumps(data, ensure_ascii=False, indent=2),
                         encoding="utf-8")
        except OSError:
            pass

    def _load_sys_level_for_source(self):
        """Set the 🔊 slider to the remembered level for the current source."""
        lvl = self._load_source_level(self.cmb_source.currentData() or "")
        s = self.slider_sys["slider"]
        s.blockSignals(True)
        s.setValue(lvl)
        s.blockSignals(False)
        self.slider_sys["label"].setText(f"{lvl}%")

    def _init_levels(self):
        """Start the 🎤 slider aligned with the system mic and the 🔊 slider at
        the remembered level for the selected source. Labels are refreshed by
        the _update_level_sliders() call that follows."""
        m = self.slider_mic["slider"]
        m.blockSignals(True)
        m.setRange(0, 150)                       # mic can be boosted past 100%
        m.setValue(self._system_mic_percent())
        m.blockSignals(False)
        s = self.slider_sys["slider"]
        s.blockSignals(True)
        s.setValue(self._load_source_level(self.cmb_source.currentData() or ""))
        s.blockSignals(False)

    def _on_capture_ready(self):
        """Capture resolved (worker signal): apply mix levels + re-point meters
        (for an app source the 🔊 meter now reads the private isolated sink)."""
        if self.audio_worker and self.audio_worker._sys_input_id:
            # mix, or app+mic: push the initial 🔊 level onto the system loopback.
            self._apply_mix_levels()
        self._refresh_meters()

    # ── Live VU meters (one parec reader per active flow) ───────────────────
    def _sys_meter_device(self):
        """parec --device for the 🔊 flow: the monitor of the captured sink.
        mix/system → default sink monitor; app: → the app's sink monitor;
        a '*.monitor' source → itself. None if unresolved."""
        src = self.cmb_source.currentData() or ""
        if src.endswith(".monitor"):
            return src
        if src.startswith("app:"):
            # ALWAYS isolated: while recording, the worker's private sink; before
            # recording, a dedicated preview sink (handled by _ensure_preview_appcap,
            # not here). Never the whole device sink, so other apps never move it.
            if self.audio_worker and self.audio_worker._appcap_sink:
                return f"{self.audio_worker._appcap_sink}.monitor"
            return None
        try:
            sink = subprocess.check_output(
                ["pactl", "get-default-sink"], text=True, timeout=3).strip()
            return f"{sink}.monitor"
        except Exception:
            return None

    def _meter_apply(self, meter, level):
        """VU ballistics: instant attack, smooth decay (×1.5 like the plasmoid)."""
        target = int(min(100, level * 150))
        cur = meter.value()
        meter.setValue(target if target >= cur else int(cur * 0.82))

    def _on_mic_level(self, level):
        self._meter_apply(self.slider_mic["meter"], level)

    def _on_sys_level(self, level):
        self._meter_apply(self.slider_sys["meter"], level)

    def _refresh_meters(self):
        """(Re)start a parec peak-meter per active flow — runs live whenever the
        window is visible, so the VU bars move even before recording."""
        self._stop_meters()
        if not self.isVisible():
            self._stop_preview_appcap()
            return
        mic_on, sys_on = self._active_flows()
        if mic_on:
            self._meter_mic = LevelMeterWorker(None)   # None = default mic
            self._meter_mic.level.connect(self._on_mic_level)
            self._meter_mic.start()
        if sys_on:
            src = self.cmb_source.currentData() or ""
            recording = bool(self.audio_worker and self.audio_worker._appcap_sink)
            if src.startswith("app:") and not recording:
                # Isolated preview: run a dedicated dictee-app-capture for this
                # app so the 🔊 meter shows ONLY it (not every app on the sink).
                self._ensure_preview_appcap(src[4:])
            else:
                self._stop_preview_appcap()
                dev = self._sys_meter_device()
                # None would make parec read the DEFAULT SOURCE (the mic) — only
                # start when a real sink/monitor is resolved.
                if dev:
                    self._start_sys_meter_on(dev)

    def _start_sys_meter_on(self, device):
        if self._meter_sys:
            return
        self._meter_sys = LevelMeterWorker(device)
        self._meter_sys.level.connect(self._on_sys_level)
        self._meter_sys.start()

    def _ensure_preview_appcap(self, name):
        """Keep a dedicated dictee-app-capture running for app `name` and meter
        its private sink — the isolated 🔊 preview before recording."""
        if self._preview_app == name and self._preview_proc is not None:
            if self._preview_ready:
                self._start_sys_meter_on(f"{self._preview_sink}.monitor")
            return
        self._stop_preview_appcap()
        if shutil.which("dictee-app-capture") is None:
            return
        from PyQt6.QtCore import QProcess
        self._preview_app = name
        self._preview_sink = f"dictee_cap_prev_{os.getpid()}"
        self._preview_ready = False
        self._preview_proc = QProcess(self)
        self._preview_proc.readyReadStandardOutput.connect(self._on_preview_output)
        self._preview_proc.start(
            "dictee-app-capture", ["--sink-name", self._preview_sink, "--match", name])

    def _on_preview_output(self):
        if not self._preview_proc:
            return
        out = bytes(self._preview_proc.readAllStandardOutput()).decode("utf-8", "replace")
        if "READY" in out and not self._preview_ready:
            self._preview_ready = True
            self._start_sys_meter_on(f"{self._preview_sink}.monitor")

    def _stop_preview_appcap(self):
        if self._preview_proc is not None:
            try:
                self._preview_proc.readyReadStandardOutput.disconnect()
            except (TypeError, RuntimeError):
                pass
            self._preview_proc.terminate()
            if not self._preview_proc.waitForFinished(1000):
                self._preview_proc.kill()
                self._preview_proc.waitForFinished(500)
            self._preview_proc = None
        self._preview_app = None
        self._preview_sink = None
        self._preview_ready = False

    def _stop_meters(self):
        for attr in ("_meter_mic", "_meter_sys"):
            m = getattr(self, attr, None)
            if m:
                m.stop()
                setattr(self, attr, None)
        self.slider_mic["meter"].setValue(0)
        self.slider_sys["meter"].setValue(0)

    def showEvent(self, e):
        super().showEvent(e)
        self._refresh_meters()

    def hideEvent(self, e):
        super().hideEvent(e)
        self._stop_meters()
        self._stop_preview_appcap()

    def _conf_dict(self):
        """Parse ~/.config/dictee.conf into a {KEY: value} dict (DICTEE_* keys)."""
        conf = Path.home() / ".config/dictee.conf"
        out = {}
        if conf.is_file():
            try:
                for line in conf.read_text(encoding="utf-8").splitlines():
                    s = line.strip()
                    if s.startswith("DICTEE_") and "=" in s:
                        k, v = s.split("=", 1)
                        out[k.strip()] = v.strip().strip('"').strip("'")
            except OSError:
                pass
        return out

    def _write_conf_key(self, key, value):
        """Replace-or-append a key in ~/.config/dictee.conf, no duplicate line."""
        conf = Path.home() / ".config/dictee.conf"
        lines = []
        if conf.is_file():
            try:
                lines = conf.read_text(encoding="utf-8").splitlines()
            except OSError:
                return
        prefix = key + "="
        replaced = False
        for i, line in enumerate(lines):
            if line.strip().startswith(prefix):
                lines[i] = prefix + value
                replaced = True
                break
        if not replaced:
            lines.append(prefix + value)
        try:
            conf.write_text("\n".join(lines) + "\n", encoding="utf-8")
        except OSError:
            pass

    def _apply_window_behavior(self):
        """Apply always-on-top and all-virtual-desktops options from conf."""
        conf_path = Path.home() / ".config/dictee.conf"
        always_on_top = True   # default
        all_desktops = False   # default
        if conf_path.is_file():
            try:
                for line in conf_path.read_text(encoding="utf-8").splitlines():
                    line = line.strip()
                    if line.startswith("DICTEE_MEETING_ALWAYS_ON_TOP="):
                        v = line.split("=", 1)[1].strip().strip('"').strip("'").lower()
                        always_on_top = v in ("true", "1", "yes")
                    elif line.startswith("DICTEE_MEETING_ALL_DESKTOPS="):
                        v = line.split("=", 1)[1].strip().strip('"').strip("'").lower()
                        all_desktops = v in ("true", "1", "yes")
            except OSError:
                pass

        if always_on_top:
            self.setWindowFlag(Qt.WindowType.WindowStaysOnTopHint, True)

        if all_desktops:
            QTimer.singleShot(100, self._set_on_all_desktops)

    def _set_on_all_desktops(self):
        """Set the window visible on all virtual desktops.

        On X11: uses wmctrl (add,sticky).
        On Wayland/KDE: not yet supported — shows a notify-send notice.
        Silently no-ops on unsupported platforms.
        """
        try:
            win_id = int(self.winId())
        except Exception:
            return

        if os.environ.get("XDG_SESSION_TYPE", "") == "x11":
            try:
                subprocess.run(
                    ["wmctrl", "-i", "-r", str(win_id), "-b", "add,sticky"],
                    timeout=2, capture_output=True,
                )
                return
            except (FileNotFoundError, subprocess.TimeoutExpired):
                pass

        # Wayland: no reliable cross-compositor API without KWindowSystem (PyKF5).
        try:
            subprocess.run(
                ["notify-send", "-t", "5000",
                 "dictee-meeting-live",
                 "All desktops option not yet supported on Wayland — "
                 "window will only show on current desktop."],
                timeout=2, capture_output=True,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired):
            pass

    def start_meeting(self):
        # Re-entrancy guard: never start a second capture over a live one
        # (would orphan the previous worker/chunker/diarizer/executor).
        if self._state in ("recording", "paused") or self.audio_worker:
            return
        # Guard rail: an "app:" source needs the dictee-app-capture helper.
        # If it's missing (not installed / not in PATH), refuse to start with a
        # clear message instead of silently recording the microphone in place of
        # the chosen application (which looks like it "works" but captures the
        # wrong source).
        # Single source of truth = the combo the user sees (not the conf, which
        # can name a source that vanished from the rescanned list).
        source = self.cmb_source.currentData() or ""
        if source.startswith("app:") and shutil.which("dictee-app-capture") is None:
            QMessageBox.critical(
                self,
                "Capture d'application indisponible",
                "Le composant « dictee-app-capture » est introuvable sur le "
                "système.\n\nL'enregistrement n'a pas démarré pour éviter de "
                "capter le micro à la place de l'application. Réinstallez dictee, "
                "ou choisissez une autre source audio (micro, audio système…).",
            )
            return

        self.meeting_dir = meeting_dir(title=self._title_edit.text())
        self._title = self._title_edit.text().strip()
        self.audio_wav = self.meeting_dir / "audio.wav"
        chunks_dir = self.meeting_dir / "chunks"
        self.transcript_path = self.meeting_dir / "transcript-live.md"

        # Init transcript markdown header
        _header = self._title or ("Réunion " + datetime.now().strftime("%Y-%m-%d %H:%M"))
        self.transcript_path.write_text(
            f"# {_header}\n\n",
            encoding="utf-8",
        )

        # PTT mutex
        try:
            Path("/dev/shm/.dictee_state").write_text("meeting-recording\n")
        except OSError:
            pass

        self.elapsed_seconds = 0

        # Reset speaker state for new meeting
        self._speaker_name_map.clear()
        for le in self._speaker_row_widgets.values():
            self._speakers_form.removeRow(le)
        self._speaker_row_widgets.clear()
        self.speakers_seen = set()

        # Audio capture — honor the selected meeting source (incl. 'mix')
        self.audio_worker = AudioCaptureWorker(self.audio_wav, source,
                                               self.chk_include_mic.isChecked())
        self.audio_worker.error.connect(self._on_capture_failed)
        # When the capture is actually resolved (mix inputs / app private sink
        # ready), apply mix levels and re-point the meters — driven by the
        # worker's signal, not a fixed-delay guess that races on slow systems.
        self.audio_worker.ready.connect(self._on_capture_ready)
        self.audio_worker.start()

        # Read chunk duration from conf (default 40s, range 20-60)
        chunk_duration = 40
        try:
            conf_path = Path.home() / ".config/dictee.conf"
            if conf_path.exists():
                for line in conf_path.read_text().splitlines():
                    if line.startswith("DICTEE_MEETING_CHUNK_S="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        chunk_duration = max(20, min(60, int(val)))
                        break
        except (OSError, ValueError):
            pass
        self.chunk_duration = chunk_duration
        self._last_emit_elapsed = 0   # for the "chunk en cours" indicator bar
        self._finalized = False       # stop-finalize guard (tail flush flow)
        self._finalizing = False
        self._tail_chunk_id = None

        # Workers for live preview
        self.chunker = ChunkerWorker(self.audio_wav, chunks_dir,
                                     chunk_duration=chunk_duration, overlap=10)
        self.chunker.chunk_ready.connect(self._on_chunk_ready)
        self.chunker.error.connect(self._on_error_msg)
        self.chunker.start()

        # If the chosen ASR model is Whisper or Nemotron, spawn a dedicated
        # isolated daemon (private socket) for the live preview so the live text
        # comes out in the right language — the F9 daemon is Parakeet, which
        # anglicizes French. Other models keep using the F9 daemon for the live
        # preview.
        self._live_asr_proc = None
        self._live_asr_sock = None
        self._daemon_was_active = False   # F9 services stopped to free VRAM
        _spec = self._model_combo.currentData()
        if _spec and _spec.startswith("whisper-"):
            self._live_asr_sock = f"/tmp/dictee-meeting-whisper-{os.getpid()}.sock"
            _env = _build_subprocess_env()
            _env["DICTEE_WHISPER_MODEL"] = _spec.split("-", 1)[1]
            _env["DICTEE_TRANSCRIBE_SOCKET"] = self._live_asr_sock
            _env["DICTEE_DAEMON_NO_PROVIDER"] = "1"   # never clobber the F9 badge
            try:
                os.unlink(self._live_asr_sock)
            except OSError:
                pass
            try:
                self._live_asr_proc = subprocess.Popen(
                    ["transcribe-daemon-whisper"], env=_env,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except FileNotFoundError:
                self._on_error_msg("transcribe-daemon-whisper introuvable — live en Parakeet")
                self._live_asr_sock = None
        elif _spec == "nemotron":
            # Nemotron emits no word timestamps, so the live preview switches to
            # per-Sortformer-segment transcription on this private daemon (see
            # TranscriptionWorker.transcribe_segments). Recipe mirrors
            # dictee-transcribe's IsolatedAsrDaemon.
            self._live_asr_sock = f"/tmp/dictee-meeting-nemotron-{os.getpid()}.sock"
            self._free_vram_for_live_daemon()
            _env = _build_subprocess_env()
            _env["DICTEE_ASR_BACKEND"] = "nemotron"
            _env["DICTEE_DAEMON_NO_PROVIDER"] = "1"   # never clobber the F9 badge
            _ort = "/usr/lib/dictee/libonnxruntime.so"
            if os.path.isfile(_ort):
                _env.setdefault("ORT_DYLIB_PATH", _ort)
            try:
                os.unlink(self._live_asr_sock)
            except OSError:
                pass
            try:
                self._live_asr_proc = subprocess.Popen(
                    ["transcribe-daemon", "--socket", self._live_asr_sock],
                    env=_env,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except FileNotFoundError:
                self._on_error_msg("transcribe-daemon introuvable — live en Parakeet")
                self._live_asr_sock = None

        self._nemotron_live = bool(self._live_asr_sock) and _spec == "nemotron"
        self._chunk_paths = {}            # chunk_id → wav path (nemotron live)
        _whisper_sock = (self._live_asr_sock
                         if (_spec or "").startswith("whisper-") else None)
        _nemotron_sock = self._live_asr_sock if self._nemotron_live else None
        self.transcriber = TranscriptionWorker(whisper_sock=_whisper_sock,
                                               nemotron_sock=_nemotron_sock)
        self.diarizer = DiarizationWorker()
        self._diarizer_ready = False
        self.diarizer.ready.connect(self._on_diarizer_ready)
        if not self.diarizer.start():   # non-blocking: model loads in background
            self._on_error_msg("Failed to start diarize-only --stream")

        self.aligner = AlignerWorker()
        self.aligner.chunk_offset = {}

        self.transcriber.transcribed.connect(self.aligner.on_transcribed)
        if self._nemotron_live:
            # Per-segment mode: the diarizer drives transcription and the
            # aligner is bypassed (Nemotron has no word timestamps).
            self.diarizer.diarized.connect(self._on_diarized_nemotron)
            self.transcriber.aligned_direct.connect(self._on_aligned)
        else:
            self.diarizer.diarized.connect(self.aligner.on_diarized)
        self.aligner.aligned.connect(self._on_aligned)
        self.transcriber.error.connect(self._on_chunk_error)
        self.diarizer.error.connect(self._on_chunk_error)

        # Background executor for blocking subprocess calls
        import concurrent.futures
        self._executor = concurrent.futures.ThreadPoolExecutor(max_workers=2)

        # File watcher for the preview view
        self.watcher = QFileSystemWatcher([str(self.transcript_path)])
        self.watcher.fileChanged.connect(self._reload_transcript)

        self._tick_timer.start()
        self._set_state("recording")
        # Models load in the background (no UI freeze); keep the user informed.
        _loading = ["diarisation"]
        if self._live_asr_proc is not None:
            _loading.append("Nemotron" if self._nemotron_live else "Whisper")
        self.status_label.setText("⏳ Chargement du modèle : " + " + ".join(_loading) + "…")

    def _on_diarizer_ready(self):
        self._diarizer_ready = True
        if self._state == "recording":
            self.status_label.setText("Enregistrement en cours — modèles prêts")

    def _on_diarized_nemotron(self, chunk_id: int, segments: list):
        """Nemotron live: a chunk's Sortformer segments just arrived — launch
        the per-segment transcription (the aligner is bypassed)."""
        if getattr(self, "_finalized", False):
            return
        chunk_path = self._chunk_paths.pop(chunk_id, None)
        if chunk_path is None:
            return
        offset = self.aligner.chunk_offset.get(chunk_id, 0.0)
        self._executor.submit(self.transcriber.transcribe_segments,
                              chunk_id, chunk_path, segments, offset)

    def _free_vram_for_live_daemon(self):
        """Stop the F9 daemon services when free VRAM is too tight for the
        isolated live nemotron daemon (~3.5 GB) next to streaming Sortformer.
        Mirrors dictee-transcribe's VRAM-free block; services are restarted in
        _stop_live_asr_daemon()."""
        try:
            result = subprocess.run(
                ["nvidia-smi", "--query-gpu=memory.free",
                 "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=5)
            free_str = (result.stdout.strip().split("\n")[0]
                        if result.returncode == 0 else "")
            if not (free_str and free_str.isdigit()):
                return
            if int(free_str) >= 5120:   # nemotron ~3.5 GB + Sortformer margin
                return
            result2 = subprocess.run(
                ["nvidia-smi", "--query-compute-apps=name",
                 "--format=csv,noheader"],
                capture_output=True, text=True, timeout=5)
            gpu_procs = result2.stdout.strip() if result2.returncode == 0 else ""
            if "transcribe-daemon" in gpu_procs:
                self._daemon_was_active = True
                subprocess.run(
                    ["systemctl", "--user", "stop",
                     "dictee", "dictee-vosk", "dictee-whisper",
                     "dictee-canary", "dictee-nemotron"],
                    timeout=10)
                time.sleep(1)
        except Exception:
            pass

    def _on_chunk_ready(self, chunk_id: int, chunk_path: str):
        # Guard against a tail chunk_ready that arrives after the pipeline was
        # already finalized (e.g. the chunker join timed out and _on_stop took
        # the no-tail path): submitting to the shut-down executor would raise.
        if getattr(self, "_finalized", False):
            return
        # A chunk was just extracted → reset the "chunk en cours" bar baseline.
        self._last_emit_elapsed = self.elapsed_seconds
        # Compute absolute offset for aligner: chunk N starts at N * advance
        self.aligner.chunk_offset[chunk_id] = chunk_id * (self.chunk_duration - 10)
        if getattr(self, "_nemotron_live", False):
            # Per-segment mode: transcription waits for this chunk's Sortformer
            # segments (_on_diarized_nemotron); only the diarizer runs now.
            self._chunk_paths[chunk_id] = chunk_path
        else:
            self._executor.submit(self.transcriber.transcribe, chunk_id, chunk_path)
        self._executor.submit(self.diarizer.diarize, chunk_id, chunk_path)
        if not getattr(self, "_finalizing", False):
            self.status_label.setText(
                f"⚙ Chunk {chunk_id + 1} : transcription + diarisation…")

    def _on_aligned(self, chunk_id: int, lines: list):
        with open(self.transcript_path, "a", encoding="utf-8") as f:
            for ln in lines:
                spk = ln["speaker"]
                if spk == -1:
                    continue
                f.write(f"[{ln['start_s']:.3f}s - {ln['end_s']:.3f}s] Speaker {spk}: {ln['text']}\n")

                # NEW: if this is a brand-new speaker, add a naming row in the panel
                if spk not in self.speakers_seen:
                    self.speakers_seen.add(spk)
                    self._add_speaker_row(spk)
        if not getattr(self, "_finalizing", False):
            self.status_label.setText(f"✓ Chunk {chunk_id + 1} ajouté à l'aperçu")
        # The tail chunk (flushed on stop) just landed → finalize the stop.
        if getattr(self, "_finalizing", False) and chunk_id == getattr(self, "_tail_chunk_id", None):
            self._finalize_stop()

    def _add_speaker_row(self, spk_id: int):
        """Add a QLineEdit row for naming a newly detected speaker."""
        if spk_id in self._speaker_row_widgets:
            return
        label_text = f"Speaker {spk_id}"
        line_edit = QLineEdit()
        line_edit.setPlaceholderText("(nommer ce locuteur…)")
        line_edit.editingFinished.connect(
            lambda sid=spk_id, le=line_edit: self._on_speaker_renamed(sid, le.text().strip())
        )
        self._speakers_form.addRow(label_text, line_edit)
        self._speaker_row_widgets[spk_id] = line_edit

    def _on_speaker_renamed(self, spk_id: int, name: str):
        if name:
            self._speaker_name_map[spk_id] = name
        else:
            self._speaker_name_map.pop(spk_id, None)
        # Trigger transcript view re-render to reflect the new name
        self._reload_transcript()

    def _on_chunk_error(self, chunk_id: int, msg: str):
        print(f"[meeting-live] chunk {chunk_id}: {msg}", file=sys.stderr)
        # Surface transient chunk issues (e.g. Whisper model still cold-loading)
        # in the status bar so the user knows what's happening.
        if not getattr(self, "_finalizing", False):
            self.status_label.setText(f"⚠ Chunk {chunk_id + 1} : {msg}")

    def _reload_transcript(self):
        if not self.transcript_path:
            return
        spk_pattern = re.compile(
            r"^\[(\d+\.?\d*)s\s*-\s*(\d+\.?\d*)s\]\s*Speaker\s+(\d+):\s*(.*)$"
        )
        try:
            content = self.transcript_path.read_text(encoding="utf-8")
            html_lines = []
            for line in content.split("\n"):
                m = spk_pattern.match(line)
                if m:
                    start_s, _end_s, spk_id, text = m.groups()
                    spk_id = int(spk_id)
                    color = self.SPEAKER_COLORS[spk_id % len(self.SPEAKER_COLORS)]
                    t = self._fmt_time(float(start_s))
                    display_name = self._speaker_name_map.get(spk_id, f"Speaker {spk_id}")
                    html_lines.append(
                        f'<p style="color:{color}"><b>[{display_name}]</b> '
                        f'<span style="color:#888">({t})</span> {text}</p>'
                    )
                else:
                    html_lines.append(f"<p>{line}</p>")
            self.transcript_view.setHtml("\n".join(html_lines))
            sb = self.transcript_view.verticalScrollBar()
            sb.setValue(sb.maximum())
        except FileNotFoundError:
            pass

    @staticmethod
    def _fmt_time(seconds: float) -> str:
        m = int(seconds) // 60
        s = int(seconds) % 60
        return f"{m:02d}:{s:02d}"

    def _on_preview_toggled(self, checked: bool):
        # Resize the (user-resizable) window with the accordion: open to 800 px
        # tall, shrink back to the collapsed height on close. The preview_content
        # stretch keeps the top zone pinned; the transcript fills the space.
        self.preview_toggle.setArrowType(
            Qt.ArrowType.DownArrow if checked else Qt.ArrowType.RightArrow
        )
        if checked:
            self._collapsed_h = self.height()
            self.preview_content.setVisible(True)
            # Open to a fixed 800 px height (still user-resizable afterwards;
            # the transcript fills the extra space). Width is kept (>= 800 min).
            self.resize(self.width(), 800)
        else:
            self.preview_content.setVisible(False)
            target = getattr(self, "_collapsed_h", None) or 220
            QTimer.singleShot(0, lambda: self.resize(self.width(), target))

    def _extract_speaker_anchors(self, min_duration_s: float = 1.5, max_anchors_per_speaker: int = 5) -> dict:
        """Parse transcript-live.md to extract temporal anchors per speaker_id.

        Returns {speaker_id: [{"start": float, "end": float}, ...]}
        Only keeps segments >= min_duration_s (filters short interjections).
        Sorted by duration descending, capped at max_anchors_per_speaker.
        """
        anchors = {}
        try:
            content = self.transcript_path.read_text(encoding="utf-8")
        except FileNotFoundError:
            return anchors
        line_re = re.compile(r"^\[(\d+\.?\d*)s\s*-\s*(\d+\.?\d*)s\]\s*Speaker\s+(\d+):")
        for line in content.splitlines():
            m = line_re.match(line)
            if not m:
                continue
            start = float(m.group(1))
            end = float(m.group(2))
            spk_id = int(m.group(3))
            duration = end - start
            if duration < min_duration_s:
                continue
            anchors.setdefault(spk_id, []).append({"start": start, "end": end})
        # Sort by duration desc, keep top N per speaker
        for spk_id in list(anchors.keys()):
            anchors[spk_id].sort(key=lambda a: a["end"] - a["start"], reverse=True)
            anchors[spk_id] = anchors[spk_id][:max_anchors_per_speaker]
        return anchors

    def _stop_live_asr_daemon(self):
        """Stop the meeting's isolated live ASR daemon (whisper or nemotron),
        remove its socket, and restart the F9 services if the VRAM guard
        stopped them. Idempotent (safe when no daemon was spawned)."""
        proc = getattr(self, "_live_asr_proc", None)
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
        self._live_asr_proc = None
        sock = getattr(self, "_live_asr_sock", None)
        if sock:
            try:
                os.unlink(sock)
            except OSError:
                pass
        self._live_asr_sock = None
        if getattr(self, "_daemon_was_active", False):
            # Restart the daemon matching the configured F9 backend (same
            # service map as dictee-transcribe's VRAM-free restore).
            self._daemon_was_active = False
            conf = self._conf_dict()
            asr = conf.get("DICTEE_ASR_BACKEND", "parakeet")
            svc_map = {"parakeet": "dictee", "vosk": "dictee-vosk",
                       "whisper": "dictee-whisper", "canary": "dictee-canary",
                       "nemotron": "dictee-nemotron"}
            try:
                subprocess.Popen(["systemctl", "--user", "start",
                                  svc_map.get(asr, "dictee")])
            except OSError:
                pass

    def _on_stop(self):
        # Stop the recording and freeze the WAV. Does NOT launch the analysis —
        # the user clicks "Démarrer l'analyse" (btn_analyze) for that.
        # The chunker flushes a final partial chunk; we keep the live pipeline
        # alive until that tail is transcribed (so the live preview captures the
        # end), showing a pie on the stop button meanwhile, then finalize.
        self._tick_timer.stop()

        if self.audio_worker:
            self.audio_worker.resume()   # ensure not paused so stop() is clean
            self.audio_worker.stop()
            self.audio_worker = None
        self._refresh_meters()           # private app sink gone → re-resolve meters

        # Stop the chunker → it flushes the tail (queued chunk_ready). chunk_id
        # grows iff a tail chunk was actually emitted.
        tail_id = None
        if getattr(self, "chunker", None):
            before = self.chunker.chunk_id
            self.chunker.stop()
            if self.chunker.chunk_id > before:
                tail_id = self.chunker.chunk_id - 1

        if tail_id is not None:
            # Keep diarizer / executor / live ASR daemon ALIVE so the queued tail chunk
            # gets transcribed + diarized; finalize when it aligns (or watchdog).
            self.btn_stop.setEnabled(False)
            self._blink_timer.stop()
            self.rec_dot.setVisible(False)
            self._apply_icon(False)
            self._tail_chunk_id = tail_id
            self._finalizing = True
            self._start_stop_pie()
            self._finalize_watchdog = QTimer(self)
            self._finalize_watchdog.setSingleShot(True)
            self._finalize_watchdog.timeout.connect(self._finalize_stop)
            self._finalize_watchdog.start(25000)   # safety net
            self.status_label.setText("Finalisation du dernier segment…")
        else:
            self._finalize_stop()

    def _start_stop_pie(self):
        """Animate the stop button's pie while the last chunk is processed.
        Creeps toward (but never reaches) full over a few seconds (we lack
        granular daemon progress); _complete_stop_pie sweeps it the rest of the
        way and clears it when the tail actually lands."""
        self._pie_anim = QPropertyAnimation(self.btn_stop, b"pie")
        self._pie_anim.setStartValue(0.0)
        self._pie_anim.setEndValue(0.75)
        self._pie_anim.setDuration(6000)
        self._pie_anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        self._pie_anim.start()

    def _complete_stop_pie(self):
        """Sweep the pie to a full circle (completion gesture) then clear — so
        it always 'fait le tour' even when the tail finished before the slow
        creep did. Called from _finalize_stop."""
        if getattr(self, "_pie_anim", None):
            self._pie_anim.stop()
        self._pie_anim = QPropertyAnimation(self.btn_stop, b"pie")
        self._pie_anim.setStartValue(self.btn_stop.getPie())
        self._pie_anim.setEndValue(1.0)
        self._pie_anim.setDuration(450)
        self._pie_anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        # Hold the full circle briefly, then clear (guard: the button may be
        # gone if the window closed in the meantime).
        self._pie_anim.finished.connect(
            lambda: QTimer.singleShot(
                250, lambda: self.btn_stop.setPie(0.0) if self.btn_stop else None))
        self._pie_anim.start()

    def _stop_stop_pie(self):
        if getattr(self, "_pie_anim", None):
            self._pie_anim.stop()
        self.btn_stop.setPie(0.0)

    def _finalize_stop(self):
        """Tear down the live pipeline and switch to 'stopped'. Idempotent:
        runs when the tail chunk aligns, on the watchdog, or directly when
        there was no tail to flush."""
        if getattr(self, "_finalized", False):
            return
        self._finalized = True
        self._finalizing = False
        self._tail_chunk_id = None
        if getattr(self, "_finalize_watchdog", None):
            self._finalize_watchdog.stop()
        self._complete_stop_pie()   # sweep the pie around, then clear

        if getattr(self, "diarizer", None):
            self.diarizer.stop()
        if getattr(self, "_executor", None):
            self._executor.shutdown(wait=False)
        self._stop_live_asr_daemon()
        try:
            Path("/dev/shm/.dictee_state").write_text("idle\n")
        except OSError:
            pass

        # Write meeting metadata
        try:
            audio_size = self.audio_wav.stat().st_size if self.audio_wav else 0
        except FileNotFoundError:
            audio_size = 0
        meta = {
            "title": self._title,
            "ended_at": datetime.now().isoformat(),
            "duration_s": self.elapsed_seconds,
            "audio_bytes": audio_size,
        }
        try:
            (self.meeting_dir / "meeting.meta.json").write_text(
                json.dumps(meta, indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
        except (OSError, AttributeError):
            pass

        self._set_state("stopped")
        if audio_size < 1024:
            self.status_label.setText(
                f"Enregistrement trop court ({self.elapsed_seconds}s)")
            self.btn_analyze.setEnabled(False)

    def _on_analyze(self):
        # Launch dictee-transcribe on the recorded audio, then close.
        self.status_label.setText("Ouverture de l'analyse…")

        # Write speakers.json next to audio.wav so dictee-transcribe can
        # pre-fill the rename panel with live-session speaker names.
        if self._speaker_name_map and self.transcript_path and self.transcript_path.is_file():
            try:
                anchors = self._extract_speaker_anchors()
                speakers_data = {
                    "name_map": {str(k): v for k, v in self._speaker_name_map.items()},
                    "anchors": {
                        str(k): v for k, v in anchors.items()
                        if k in self._speaker_name_map  # only named speakers
                    },
                }
                speakers_json_path = self.meeting_dir / "speakers.json"
                speakers_json_path.write_text(
                    json.dumps(speakers_data, indent=2, ensure_ascii=False),
                    encoding="utf-8",
                )
            except Exception as e:
                print(f"[meeting-live] failed to write speakers.json: {e}", file=sys.stderr)

        # Hand off to dictee-transcribe
        try:
            subprocess.Popen(
                ["dictee-transcribe", "--file", str(self.audio_wav), "--diarize",
                 "--asr-model", self._model_combo.currentData()],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except FileNotFoundError:
            self.status_label.setText("Erreur : dictee-transcribe introuvable")
            return

        self.close()

    def _on_open_transcribe(self):
        """Open dictee-transcribe (no file pre-loaded) with the meeting's chosen
        model pre-set; the user picks a past meeting via its History button."""
        try:
            subprocess.Popen(
                ["dictee-transcribe", "--asr-model", self._model_combo.currentData()],
                env=_build_subprocess_env(),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except FileNotFoundError:
            self.status_label.setText("Erreur : dictee-transcribe introuvable")

    def _tick(self):
        self.elapsed_seconds += 1
        m, s = divmod(self.elapsed_seconds, 60)
        h, m = divmod(m, 60)
        if h > 0:
            self.duration_label.setText(f"{h:02d}:{m:02d}:{s:02d}")
        else:
            self.duration_label.setText(f"{m:02d}:{s:02d}")
        self._update_chunk_indicators()

    def _update_chunk_indicators(self):
        """Drive the two thin bars above the accordion (called every second).
        Bar 1 fills over the inter-chunk period (chunk_duration for the very
        first chunk, then the advance = chunk_duration - overlap); at full a new
        live block lands. Bar 2 shows the overlap context buffer (fills once,
        then stays full)."""
        ch = getattr(self, "chunker", None)
        if ch is None or getattr(self, "_chunk_indicators", None) is None:
            return
        advance = ch.advance
        overlap = max(0, self.chunk_duration - advance)
        period = self.chunk_duration if ch.chunk_id == 0 else advance
        since = max(0, self.elapsed_seconds - getattr(self, "_last_emit_elapsed", 0))
        since = min(since, period)
        # 1-indexed current chunk number (chunk_id is the next chunk to emit).
        self._lbl_chunk.setText(f"Chunk {ch.chunk_id + 1}")
        self._smooth_bar(self._anim_chunk, self._bar_chunk,
                         int(100 * since / period) if period else 0)
        self._chunk_val.setText(f"{since}s / {period}s")
        # Contexte = the LAST `overlap` seconds of the current chunk — the slice
        # that overlaps into (and becomes the look-back context of) the next
        # chunk. Empty until the chunk enters its final `overlap` seconds.
        ctx_into = max(0, since - (period - overlap))
        self._smooth_bar(self._anim_ctx, self._bar_ctx,
                         int(100 * ctx_into / overlap) if overlap else 100)
        self._ctx_val.setText(f"{ctx_into}s / {overlap}s")

    @staticmethod
    def _smooth_bar(anim, bar, target):
        """Animate a progress bar toward `target` from its current value."""
        anim.stop()
        anim.setStartValue(bar.value())
        anim.setEndValue(int(target))
        anim.start()

    def _on_error_msg(self, msg: str):
        self.status_label.setText(f"Erreur : {msg}")
        print(f"[meeting-live] {msg}", file=sys.stderr)

    def _on_capture_failed(self, msg: str):
        """Fatal audio-capture error (setup failed, app-capture never became
        READY, or pw-record died): nothing is being recorded, so abort cleanly
        back to idle instead of leaving the window stuck in 'recording'.

        Distinct from _on_error_msg, which handles non-fatal preview/chunk
        errors that must NOT tear down an ongoing recording."""
        self.status_label.setText(f"Erreur : {msg}")
        print(f"[meeting-live] capture failed: {msg}", file=sys.stderr)
        if self._state not in ("recording", "paused"):
            return  # already idle/stopped — nothing to abort
        self._tick_timer.stop()
        if self.audio_worker:
            self.audio_worker.resume()   # unfreeze if paused so stop() is clean
            self.audio_worker.stop()
            self.audio_worker = None
        if getattr(self, "chunker", None):
            self.chunker.stop()
        if getattr(self, "diarizer", None):
            self.diarizer.stop()
        if getattr(self, "_executor", None):
            self._executor.shutdown(wait=False)
        try:
            Path("/dev/shm/.dictee_state").write_text("idle\n")
        except OSError:
            pass
        self._refresh_meters()
        self._set_state("idle")

    def closeEvent(self, event):
        self._mic_sync_timer.stop()
        self._mic_watcher.stop()
        self._stop_meters()
        self._stop_preview_appcap()
        # Stop the stop-button pie + finalize watchdog if a stop was in flight.
        self._stop_stop_pie()
        if getattr(self, "_finalize_watchdog", None):
            self._finalize_watchdog.stop()
        if self.btn_stop.isEnabled() or getattr(self, "_finalizing", False):
            # Capture still running/paused, OR we were finalizing the tail —
            # tear the live pipeline down cleanly either way.
            self._tick_timer.stop()
            if self.audio_worker:
                self.audio_worker.resume()   # unfreeze if paused so stop() works
                self.audio_worker.stop()
                self.audio_worker = None
            # Also tear down the analysis pipeline (else diarize-only --stream,
            # a model subprocess possibly holding VRAM, is orphaned on close).
            if getattr(self, "chunker", None):
                self.chunker.stop()
            if getattr(self, "diarizer", None):
                self.diarizer.stop()
            if getattr(self, "_executor", None):
                self._executor.shutdown(wait=False)
            self._stop_live_asr_daemon()
        # Reset state on window close (regardless of recording state)
        try:
            Path("/dev/shm/.dictee_state").write_text("idle\n")
        except OSError:
            pass
        super().closeEvent(event)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description="Live meeting capture for dictee")
    parser.add_argument("--start", action="store_true", help="Start capture immediately")
    parser.add_argument("--stop", action="store_true", help="Stop running meeting")
    args = parser.parse_args()

    # Keep the lock fd alive for the whole process lifetime (released on exit).
    lock_fd = _acquire_singleton_lock()
    if lock_fd is None:
        print("[meeting-live] already running", file=sys.stderr)
        sys.exit(1)

    app = QApplication(sys.argv)
    win = MeetingWindow()   # sets its own black/idle icon (red while recording)
    win.show()
    if args.start:
        win.start_meeting()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
