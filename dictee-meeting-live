class AudioCaptureWorker(QThread):
    """Continuous audio capture via pw-record into a growing WAV file.

    Honors the selected meeting source: a node.name (mic / *.monitor), an
    'app:<name>' resolved to the sink the app plays to (captured via its
    monitor), an empty value (default mic), or 'mix' — a transient null-sink
    fed by two loopbacks (microphone + system monitor) torn down when capture
    ends. Sink captures use 'pw-record -P stream.capture.sink=true'.
    """

    error = pyqtSignal(str)

    def __init__(self, output_wav: Path, source: str = ""):
        super().__init__()
        self.output_wav = output_wav
        self.source = source or ""
        self.proc = None
        self._stop = False
        # mix lifecycle (populated by _setup_mix_sink, cleared by _teardown_mix)
        self._mix_modules = []      # null-sink + 2 loopback module ids
        self._mic_input_id = None   # sink-input id of the mic loopback
        self._sys_input_id = None   # sink-input id of the system loopback

    def run(self):
        try:
            target, capture_sink = self._resolve_target(self.source)
        except Exception as exc:
            self.error.emit(f"audio source setup failed: {exc}")
            self._teardown_mix()
            return
        cmd = ["pw-record", "--format=s16", "--rate=16000", "--channels=1"]
        if capture_sink:
            # Capturing a sink's monitor (system audio / an app / the mix
            # null-sink) REQUIRES this property. 'pw-record --target=<X>.monitor'
            # does NOT tap the monitor — it silently falls back to the default
            # microphone — so per-app / system / mix capture would be empty.
            cmd += ["-P", "stream.capture.sink=true"]
        cmd += [f"--target={target}", str(self.output_wav)]
        try:
            self.proc = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
            )
            rc = self.proc.wait()
            if rc != 0 and not self._stop:
                err = self.proc.stderr.read().decode("utf-8", "replace")
                self.error.emit(f"pw-record exit {rc}: {err}")
        except FileNotFoundError:
            self.error.emit("pw-record not found. Is PipeWire installed?")
        finally:
            self._teardown_mix()

    # ── source resolution ──────────────────────────────────────────────────
    def _resolve_target(self, source):
        """Resolve a meeting source value to (pw-record target, capture_sink).

        capture_sink=True means the target is a SINK whose monitor we tap with
        'stream.capture.sink=true' (system audio, an app's sink, or the mix
        null-sink). False means a normal capture source (a microphone).
        """
        if source == "mix":
            return self._setup_mix_sink(), True
        if not source:
            return "@DEFAULT_AUDIO_SOURCE@", False
        if source.startswith("app:"):
            sink = self._app_sink(source[4:])
            return (sink, True) if sink else ("@DEFAULT_AUDIO_SOURCE@", False)
        if source.endswith(".monitor"):
            return source[:-len(".monitor")], True   # tap that sink's monitor
        return source, False                         # microphone node.name

    def _app_sink(self, name):
        """Resolve 'app:<name>' to the SINK node.name the app currently plays to.

        An app's audio can only be captured via the monitor of the sink it
        feeds (you can't tap a lone output stream). Returns None if the app is
        not playing. pactl output is localized → LC_ALL=C.
        """
        env = dict(os.environ, LC_ALL="C")
        try:
            si = subprocess.check_output(
                ["pactl", "list", "sink-inputs"], text=True, env=env, timeout=3)
        except Exception:
            return None
        cur = None
        blocks = []
        for line in si.splitlines():
            s = line.strip()
            if s.startswith("Sink Input #"):
                cur = {"sink": None, "app": None}
                blocks.append(cur)
            elif cur is None:
                continue
            elif s.startswith("Sink:"):
                cur["sink"] = s.split(":", 1)[1].strip()
            elif s.startswith("application.name = "):
                cur["app"] = s.split("=", 1)[1].strip().strip('"')
        sink_idx = None
        for b in blocks:
            app = (b["app"] or "").lower().split()
            if app and app[0] == name and b["sink"]:
                sink_idx = b["sink"]
                break
        if not sink_idx:
            return None
        try:
            short = subprocess.check_output(
                ["pactl", "list", "short", "sinks"], text=True, env=env, timeout=3)
        except Exception:
            return None
        for line in short.splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[0] == sink_idx:
                return parts[1]
        return None

    def _setup_mix_sink(self):
        """Build a transient null-sink fed by two loopbacks (mic + system
        monitor) and return the null-sink name 'dictee_mix' (captured by run()
        with stream.capture.sink=true).

        Each loopback's sink-input is tagged with a findable media.name so
        its volume can be controlled independently (set_mic/system_volume).
        Modules are unloaded in _teardown_mix().
        """
        sink = subprocess.check_output(
            ["pactl", "get-default-sink"], text=True, timeout=3).strip()
        src = subprocess.check_output(
            ["pactl", "get-default-source"], text=True, timeout=3).strip()

        def load(*args):
            return subprocess.check_output(
                ["pactl", "load-module", *args], text=True, timeout=3).strip()

        self._mix_modules.append(load(
            "module-null-sink", "sink_name=dictee_mix",
            "sink_properties=device.description=DicteeMix"))
        self._mix_modules.append(load(
            "module-loopback", f"source={src}", "sink=dictee_mix",
            "latency_msec=50",
            "sink_input_properties=media.name=dictee_mix_mic"))
        self._mix_modules.append(load(
            "module-loopback", f"source={sink}.monitor", "sink=dictee_mix",
            "latency_msec=50",
            "sink_input_properties=media.name=dictee_mix_sys"))
        self._mic_input_id, self._sys_input_id = self._find_mix_inputs()
        return "dictee_mix"

    def _find_mix_inputs(self):
        """Map the two tagged loopback sink-inputs to their ids.

        Loopbacks take a moment to attach, so poll briefly. pactl list output
        is LOCALIZED (FR shows 'Entrée de la destination' instead of 'Sink
        Input') → force LC_ALL=C so the parse works on non-English systems.
        """
        env = dict(os.environ, LC_ALL="C")
        for _attempt in range(20):           # up to ~2 s
            out = subprocess.check_output(
                ["pactl", "list", "sink-inputs"], text=True, env=env, timeout=3)
            cur = mic = sysid = None
            for line in out.splitlines():
                line = line.strip()
                if line.startswith("Sink Input #"):
                    cur = line.split("#", 1)[1].strip()
                elif line == 'media.name = "dictee_mix_mic"':
                    mic = cur
                elif line == 'media.name = "dictee_mix_sys"':
                    sysid = cur
            if mic and sysid:
                return mic, sysid
            self.msleep(100)
        return None, None

    def _teardown_mix(self):
        """Unload all mix modules (idempotent)."""
        while self._mix_modules:
            mod = self._mix_modules.pop()
            try:
                subprocess.run(["pactl", "unload-module", mod],
                               timeout=3, capture_output=True)
            except Exception:
                pass
        self._mic_input_id = self._sys_input_id = None

    def set_mic_volume(self, pct):
        """Set the mic loopback volume (mix mode only)."""
        self._set_input_volume(self._mic_input_id, pct)

    def set_system_volume(self, pct):
        """Set the system loopback volume (mix mode only)."""
        self._set_input_volume(self._sys_input_id, pct)

    def _set_input_volume(self, input_id, pct):
        if not input_id:
            return
        try:
            subprocess.run(
                ["pactl", "set-sink-input-volume", input_id, f"{int(pct)}%"],
                timeout=2, capture_output=True)
        except Exception:
            pass

    def stop(self):
        self._stop = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.proc.kill()

    def pause(self):
        # Freeze the WAV: SIGSTOP pw-record (it stops writing). SIGCONT resumes.
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.send_signal(signal.SIGSTOP)
            except (ProcessLookupError, OSError):
                pass

    def resume(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.send_signal(signal.SIGCONT)
            except (ProcessLookupError, OSError):
                pass


class ChunkerWorker(QThread):
    """Splits the growing audio.wav into chunks with overlap via ffmpeg.

    Emits `chunk_ready(int chunk_id, str path)` once each chunk is extracted.
    Strategy: poll every 1 s; once duration >= start_t + chunk_duration,
    extract [start_t, start_t+chunk_duration] into chunk_NNN.wav and advance
    start_t by (chunk_duration - overlap).
    """

    chunk_ready = pyqtSignal(int, str)
    error = pyqtSignal(str)

    def __init__(self, audio_wav: Path, chunks_dir: Path,
                 chunk_duration: int = 40, overlap: int = 10):
        super().__init__()
        self.audio_wav = audio_wav
        self.chunks_dir = chunks_dir
        self.chunk_duration = chunk_duration
        self.overlap = overlap
        self.advance = chunk_duration - overlap
        self._stop = False
        self.chunk_id = 0

    def run(self):
        self.chunks_dir.mkdir(parents=True, exist_ok=True)
        start_t = 0
        while not self._stop:
            duration = self._wav_duration(self.audio_wav)
            if duration >= start_t + self.chunk_duration:
                chunk_path = self.chunks_dir / f"chunk_{self.chunk_id:04d}.wav"
                rc = self._extract(start_t, self.chunk_duration, chunk_path)
                if rc == 0:
                    self.chunk_ready.emit(self.chunk_id, str(chunk_path))
                    self.chunk_id += 1
                    start_t += self.advance
                else:
                    self.error.emit(f"ffmpeg extract failed (chunk {self.chunk_id})")
                    return
            time.sleep(1)

    def _wav_duration(self, path: Path) -> float:
        # 44 byte header + raw PCM s16le mono 16 kHz = 32000 B/s
        try:
            size = path.stat().st_size
            return max(0.0, (size - 44) / 32000.0)
        except FileNotFoundError:
            return 0.0

    def _extract(self, start_s: int, dur_s: int, out_path: Path) -> int:
        cmd = [
            "ffmpeg", "-y",
            "-ss", str(start_s),
            "-t", str(dur_s),
            "-i", str(self.audio_wav),
            "-ar", "16000", "-ac", "1",
            "-c:a", "pcm_s16le",
            str(out_path),
        ]
        proc = subprocess.run(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return proc.returncode

    def stop(self):
        self._stop = True


class TranscriptionWorker(QObject):
    """For each ready chunk, calls transcribe-client and emits (chunk_id, tokens).

    tokens = [{"text": str, "start_s": float, "end_s": float}, ...]
    Uses the existing transcribe-daemon (Parakeet already in RAM via systemd).
    """

    transcribed = pyqtSignal(int, list)
    error = pyqtSignal(int, str)

    def __init__(self):
        super().__init__()
        xdg = os.environ.get("XDG_RUNTIME_DIR")
        if xdg:
            self.daemon_socket = os.path.join(xdg, "transcribe.sock")
        else:
            self.daemon_socket = f"/tmp/transcribe.sock-{os.getuid()}"

    def transcribe(self, chunk_id: int, chunk_path: str):
        if not os.path.exists(self.daemon_socket):
            self.error.emit(
                chunk_id,
                f"socket transcribe-daemon absente ({self.daemon_socket})",
            )
            return
        try:
            proc = subprocess.run(
                ["transcribe-client", chunk_path, "--json-timestamps"],
                capture_output=True,
                text=True,
                timeout=20,
                env=_build_subprocess_env(),
            )
            if proc.returncode != 0:
                self.error.emit(
                    chunk_id,
                    f"transcribe-client exit {proc.returncode}: {proc.stderr.strip()}",
                )
                return
            data = json.loads(proc.stdout)
            tokens = data.get("tokens", [])
            self.transcribed.emit(chunk_id, tokens)
        except subprocess.TimeoutExpired:
            self.error.emit(chunk_id, "transcribe-client timeout (>20 s)")
        except json.JSONDecodeError as e:
            self.error.emit(chunk_id, f"JSON parse error: {e}")


class DiarizationWorker(QObject):
    """Keeps diarize-only --stream alive and sends chunks via stdin.

    Emits (chunk_id, segments) where segments = [{"start_s", "end_s", "speaker_id"}, ...]
    Sortformer state is preserved between chunks → stable speaker IDs.
    """

    diarized = pyqtSignal(int, list)
    error = pyqtSignal(int, str)

    def __init__(self):
        super().__init__()
        self.proc = None

    def start(self) -> bool:
        """Launch the subprocess. Returns True if ready, False on failure."""
        try:
            self.proc = subprocess.Popen(
                ["diarize-only", "--stream"],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
                env=_build_subprocess_env(),
            )
            # Wait for "ready" message on stderr (timeout 30s for slow CPU)
            deadline = time.monotonic() + 30
            while time.monotonic() < deadline:
                line = self.proc.stderr.readline()
                if not line:
                    self.error.emit(0, "diarize-only --stream stderr EOF before ready")
                    return False
                if "ready" in line:
                    return True
            self.error.emit(0, "diarize-only --stream startup timeout (30s)")
            return False
        except FileNotFoundError:
            self.error.emit(0, "diarize-only binary not found. Sortformer feature built?")
            return False

    def diarize(self, chunk_id: int, chunk_path: str):
        if not self.proc:
            self.error.emit(chunk_id, "DiarizationWorker not started")
            return
        if self.proc.poll() is not None:
            self.error.emit(chunk_id, f"diarize-only exited with code {self.proc.returncode}")
            return
        try:
            self.proc.stdin.write(f"FILE: {chunk_path}\n")
            self.proc.stdin.flush()
            self._collect_response(chunk_id)
        except BrokenPipeError:
            self.error.emit(chunk_id, "diarize-only stdin pipe broken")

    def _collect_response(self, chunk_id: int):
        segments = []
        while True:
            line = self.proc.stdout.readline()
            if not line:
                self.error.emit(chunk_id, "diarize-only stdout EOF unexpected")
                return
            line = line.rstrip("\n")
            if line == "":
                self.diarized.emit(chunk_id, segments)
                return
            if line.startswith("ERROR:"):
                self.error.emit(chunk_id, line)
                return
            parts = line.split()
            if len(parts) == 3:
                try:
                    segments.append({
                        "start_s": float(parts[0]),
                        "end_s": float(parts[1]),
                        "speaker_id": int(parts[2]),
                    })
                except ValueError:
                    self.error.emit(chunk_id, f"malformed segment line: {line}")
                    return

    def stop(self):
        if self.proc:
            try:
                if self.proc.stdin and not self.proc.stdin.closed:
                    self.proc.stdin.close()
                self.proc.wait(timeout=5)
            except (subprocess.TimeoutExpired, BrokenPipeError):
                self.proc.kill()
                self.proc.wait()
            self.proc = None


class AlignerWorker(QObject):
    """Aligns Parakeet tokens with Sortformer segments by timestamp overlap.

    For each token, picks the speaker with maximum overlap on [token.start_s, token.end_s].
    Consecutive tokens with the same speaker are grouped into one line.
    Local chunk timestamps are offset to absolute meeting timestamps via chunk_offset.

    Emits aligned(chunk_id, lines) where:
      lines = [{"speaker": int, "text": str, "start_s": float, "end_s": float}, ...]
    """

    aligned = pyqtSignal(int, list)

    def __init__(self):
        super().__init__()
        self.chunk_offset = {}      # chunk_id → absolute offset in seconds
        self._transcription = {}    # chunk_id → tokens
        self._diarization = {}      # chunk_id → segments

    def on_transcribed(self, chunk_id: int, tokens: list):
        self._transcription[chunk_id] = tokens
        self._try_align(chunk_id)

    def on_diarized(self, chunk_id: int, segments: list):
        self._diarization[chunk_id] = segments
        self._try_align(chunk_id)

    def _try_align(self, chunk_id: int):
        if chunk_id not in self._transcription or chunk_id not in self._diarization:
            return
        tokens = self._transcription.pop(chunk_id)
        segments = self._diarization.pop(chunk_id)
        offset = self.chunk_offset.get(chunk_id, 0.0)

        lines = []
        current_speaker = None
        current_text = []
        current_start = None
        current_end = None

        for tok in tokens:
            spk = self._find_speaker(tok["start_s"], tok["end_s"], segments)
            if spk != current_speaker:
                if current_speaker is not None:
                    lines.append({
                        "speaker": current_speaker,
                        "text": " ".join(current_text).strip(),
                        "start_s": current_start + offset,
                        "end_s": current_end + offset,
                    })
                current_speaker = spk
                current_text = [tok["text"]]
                current_start = tok["start_s"]
            else:
                current_text.append(tok["text"])
            current_end = tok["end_s"]

        if current_speaker is not None:
            lines.append({
                "speaker": current_speaker,
                "text": " ".join(current_text).strip(),
                "start_s": current_start + offset,
                "end_s": current_end + offset,
            })

        self.aligned.emit(chunk_id, lines)

    @staticmethod
    def _find_speaker(tok_start: float, tok_end: float, segments: list) -> int:
        best_spk = -1
        best_overlap = 0.0
        for seg in segments:
            overlap = max(0.0, min(tok_end, seg["end_s"]) - max(tok_start, seg["start_s"]))
            if overlap > best_overlap:
                best_overlap = overlap
                best_spk = seg["speaker_id"]
        return best_spk


