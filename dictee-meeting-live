class StopButton(QPushButton):
    """Stop button that can overlay a pie-sector progress in its corner — used
    to show the final ('tail') chunk being flushed and transcribed after the
    user stops. setPie(0..1); 0 hides the overlay. `pie` is a Qt property so a
    QPropertyAnimation can drive it smoothly."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._pie = 0.0

    def getPie(self):
        return self._pie

    def setPie(self, value):
        self._pie = max(0.0, min(1.0, float(value)))
        self.update()

    pie = pyqtProperty(float, getPie, setPie)

    def paintEvent(self, event):
        super().paintEvent(event)
        if self._pie <= 0.0:
            return
        side = min(self.width(), self.height()) * 0.42
        margin = 5.0
        rect = QRectF(self.width() - side - margin,
                      self.height() - side - margin, side, side)
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 40))            # faint track
        p.drawEllipse(rect)
        p.setBrush(QColor(39, 174, 96, 230))       # green filled sector
        # Sweep clockwise from 12 o'clock (Qt angles: 1/16°, CCW-positive).
        p.drawPie(rect, 90 * 16, -int(360 * self._pie) * 16)
        p.end()


