class SourceVolumeWatcher(QThread):
    """Emits source_changed whenever a PulseAudio/PipeWire *source* changes
    (volume/mute), via 'pactl subscribe'. Lets the 🎤 slider refresh instantly
    on an external change (plasmoid, system mixer) instead of polling."""

    source_changed = pyqtSignal()

    def __init__(self):
        super().__init__()
        self.proc = None
        self._stop = False

    def run(self):
        # 'stdbuf -oL' forces pactl to LINE-buffer its stdout — a pipe is
        # otherwise block-buffered, so events would arrive in delayed bursts
        # (the lag). bufsize=1 + iter(readline) keeps delivery line-by-line on
        # our side. Fall back to plain pactl if stdbuf is missing.
        for cmd in (["stdbuf", "-oL", "pactl", "subscribe"],
                    ["pactl", "subscribe"]):
            try:
                self.proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    text=True, bufsize=1, env=dict(os.environ, LC_ALL="C"))
                break
            except (FileNotFoundError, OSError):
                self.proc = None
        if self.proc is None:
            return
        for line in iter(self.proc.stdout.readline, ""):
            if self._stop:
                break
            # "Event 'change' on source #62" — exclude 'source-output' (its line
            # reads 'on source-output #', so 'on source #' never matches it).
            if "'change'" in line and "on source #" in line:
                self.source_changed.emit()

    def stop(self):
        self._stop = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.wait(2000)


