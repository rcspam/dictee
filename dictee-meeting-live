class SoundTestDialog(QDialog):
    """Ear-check of the capture chain before a real meeting.

    Records a short take through the EXACT meeting pipeline (same
    AudioCaptureWorker, same source/mix, same stop-time normalization),
    then plays it back so the user can judge level and clarity by ear.
    No transcription, no diarization — just the sound.

    Non-modal; while it records, the main window's start button is
    disabled (two captures would fight over the dictee_mix null-sink),
    and the main window disables the test button while a meeting runs.
    """

    def __init__(self, parent):
        super().__init__(parent)
        self.setWindowTitle("Test du son")
        self._win = parent
        self._worker = None
        self._play_proc = None
        self._norm_thread = None
        self._elapsed = 0
        import tempfile
        f = tempfile.NamedTemporaryFile(
            prefix="dictee-sound-test-", suffix=".wav", delete=False)
        f.close()
        self._wav = f.name

        col = QVBoxLayout(self)
        self.lbl_status = QLabel(
            "Enregistrez un court essai, puis réécoutez-le.")
        self.lbl_status.setWordWrap(True)
        col.addWidget(self.lbl_status)

        row = QHBoxLayout()
        self.btn_rec = QPushButton("● Enregistrer")
        self.btn_rec.setToolTip(
            "Capture avec la source et les niveaux de la réunion")
        self.btn_rec.clicked.connect(self._toggle_record)
        row.addWidget(self.btn_rec)
        self.btn_play = QPushButton("▶ Réécouter")
        self.btn_play.setEnabled(False)
        self.btn_play.clicked.connect(self._toggle_play)
        row.addWidget(self.btn_play)
        btn_close = QPushButton("Fermer")
        btn_close.clicked.connect(self.close)
        row.addWidget(btn_close)
        col.addLayout(row)

        # One light poller drives the duration counter, the normalization
        # completion and the end-of-playback reset (existing file style:
        # polling over cross-thread signal plumbing for short-lived states).
        self._poll = QTimer(self)
        self._poll.timeout.connect(self._on_poll)
        self._poll.start(250)

    # ── record ──────────────────────────────────────────────────────────────
    def _toggle_record(self):
        if self._worker:                      # recording → stop + normalize
            w = self._worker
            self._worker = None
            w.stop()
            self.btn_rec.setEnabled(False)    # until normalization lands
            self.lbl_status.setText("Normalisation…")
            self._norm_thread = threading.Thread(
                target=normalize_wav, args=(self._wav,), daemon=True)
            self._norm_thread.start()
            return
        self._stop_playback()
        try:
            os.unlink(self._wav)              # pw-record must start clean
        except OSError:
            pass
        self._elapsed = 0
        src = self._win.cmb_source.currentData() or ""
        self._worker = AudioCaptureWorker(
            Path(self._wav), src, self._win.chk_include_mic.isChecked())
        self._worker.error.connect(self._on_error)
        # Same 🔊 level as a real meeting (the worker already pins both mix
        # legs and rebalances before pw-record starts).
        self._worker.ready.connect(
            lambda: self._worker and self._worker.set_system_volume(
                self._win.slider_sys["slider"].value()))
        self._worker.start()
        self.btn_rec.setText("■ Arrêter")
        self.btn_play.setEnabled(False)
        self.lbl_status.setText("Essai en cours — 0 s")
        self._win.btn_start.setEnabled(False)

    def _on_error(self, msg):
        self._worker = None
        self.btn_rec.setText("● Enregistrer")
        self.lbl_status.setText(f"Échec de la capture : {msg}")
        self._win._set_state(self._win._state)

    # ── playback ────────────────────────────────────────────────────────────
    def _toggle_play(self):
        if self._play_proc and self._play_proc.poll() is None:
            self._stop_playback()
            return
        try:
            self._play_proc = subprocess.Popen(
                ["paplay", self._wav],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.btn_play.setText("■ Arrêter la lecture")
            self.lbl_status.setText("Lecture de l'essai…")
        except FileNotFoundError:
            self.lbl_status.setText("paplay introuvable.")

    def _stop_playback(self):
        if self._play_proc and self._play_proc.poll() is None:
            self._play_proc.terminate()
        self._play_proc = None
        self.btn_play.setText("▶ Réécouter")

    # ── poller ──────────────────────────────────────────────────────────────
    def _on_poll(self):
        if self._worker:
            self._elapsed += 0.25
            self.lbl_status.setText(
                f"Essai en cours — {int(self._elapsed)} s")
        if self._norm_thread and not self._norm_thread.is_alive():
            self._norm_thread = None
            self.btn_rec.setEnabled(True)
            self.btn_rec.setText("● Enregistrer")
            self.btn_play.setEnabled(os.path.getsize(self._wav) > 44
                                     if os.path.exists(self._wav) else False)
            self.lbl_status.setText(
                "Prêt — réécoutez l'essai, ou refaites-en un.")
            self._win._set_state(self._win._state)
        if (self._play_proc and self._play_proc.poll() is not None
                and self.btn_play.text() != "▶ Réécouter"):
            self._stop_playback()
            self.lbl_status.setText(
                "Prêt — réécoutez l'essai, ou refaites-en un.")

    # ── teardown ────────────────────────────────────────────────────────────
    def closeEvent(self, event):
        self._poll.stop()
        if self._worker:
            w = self._worker
            self._worker = None
            w.stop()
        self._stop_playback()
        try:
            os.unlink(self._wav)
        except OSError:
            pass
        self._win._set_state(self._win._state)   # restore main buttons
        self._win._sound_test_dialog = None
        event.accept()


