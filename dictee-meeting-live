        _i = self._model_combo.findData(_saved)
        if _i >= 0:
            self._model_combo.setCurrentIndex(_i)
        self._model_combo.currentIndexChanged.connect(
            lambda _i: self._write_conf_key("DICTEE_MEETING_ASR_MODEL",
                                            self._model_combo.currentData()))
        model_row.addWidget(self._model_combo, 1)
        left_col.addLayout(model_row)

        # "Add mic" toggle: when an app source is selected, also mix the
