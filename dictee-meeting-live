class AudioCaptureWorker(QThread):
    """Continuous audio capture via pw-record into a growing WAV file.

    Honors the selected meeting source: a node.name (mic / *.monitor), an
    'app:<name>' resolved to the sink the app plays to (captured via its
    monitor), an empty value (default mic), or 'mix' — a transient null-sink
    fed by two loopbacks (microphone + system monitor) torn down when capture
    ends. Sink captures use 'pw-record -P stream.capture.sink=true'.
    """

    error = pyqtSignal(str)
    ready = pyqtSignal()   # emitted (worker thread) once the source is resolved
                           #   and _appcap_sink / mix sink-input ids are set

    def __init__(self, output_wav: Path, source: str = "",
                 include_mic: bool = False):
        super().__init__()
        self.output_wav = output_wav
        self.source = source or ""
        self._include_mic = include_mic   # add mic to isolated app capture
        self.proc = None
        self._stop = False
        # mix lifecycle (populated by _setup_mix_sink, cleared by _teardown_mix)
        self._mix_modules = []      # null-sink + 2 loopback module ids
        self._mic_input_id = None   # sink-input id of the mic loopback
        self._sys_input_id = None   # sink-input id of the system loopback
        self._sys_pct = 100         # 🔊 slider value, composed in rebalance_sys_leg
        self._appcap_proc = None    # dictee-app-capture subprocess (app sources)
        self._appcap_sink = None    # its virtual sink name

    def run(self):
        try:
            target, capture_sink = self._resolve_target(self.source)
        except Exception as exc:
            self.error.emit(f"audio source setup failed: {exc}")
            self._teardown_mix()
            self._stop_app_capture()
            return
        if target is None:
            # App capture failed — do NOT record anything (never the mic).
            self._teardown_mix()
            self._stop_app_capture()
            return
        # Source resolved: _appcap_sink / mix sink-input ids are now set, so the
        # GUI can safely point meters + apply mix volumes (no fixed-delay guess).
        self.ready.emit()
        cmd = ["pw-record", "--format=s16", "--rate=16000", "--channels=1"]
        if capture_sink:
            # Capturing a sink's monitor (system audio / an app / the mix
            # null-sink) REQUIRES this property. 'pw-record --target=<X>.monitor'
            # does NOT tap the monitor — it silently falls back to the default
            # microphone — so per-app / system / mix capture would be empty.
            cmd += ["-P", "stream.capture.sink=true"]
        cmd += [f"--target={target}", str(self.output_wav)]
        try:
            self.proc = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
            )
            rc = self.proc.wait()
            if rc != 0 and not self._stop:
                err = self.proc.stderr.read().decode("utf-8", "replace")
                self.error.emit(f"pw-record exit {rc}: {err}")
        except FileNotFoundError:
            self.error.emit("pw-record not found. Is PipeWire installed?")
        finally:
            self._teardown_mix()
            self._stop_app_capture()

    # ── source resolution ──────────────────────────────────────────────────
    def _resolve_target(self, source):
        """Resolve a meeting source value to (pw-record target, capture_sink).

        capture_sink=True means the target is a SINK whose monitor we tap with
        'stream.capture.sink=true' (system audio, an app's sink, or the mix
        null-sink). False means a normal capture source (a microphone).
        """
        if source == "mix":
            return self._setup_mix_sink(), True
        if not source:
            return "@DEFAULT_AUDIO_SOURCE@", False
        if source.startswith("app:"):
            # Capture the app ISOLATED (app-only, never the mic) so its meter
            # and its level stay independent of the microphone.
            sink = self._start_app_capture(source[4:], include_mic=False)
            if not sink:
                # NEVER fall back to the mic for an app source — that would
                # silently record the wrong thing. None → run() aborts (the
                # error was already emitted by _start_app_capture).
                return None, False
            if self._include_mic:
                # 'Add mic': mix the isolated app audio with the mic through two
                # independently-controllable loopbacks (same machinery as 'mix'),
                # so the two levels — and the two meters — stay separate.
                return self._setup_mix_sink(system_source=f"{sink}.monitor"), True
            return sink, True
        if source.endswith(".monitor"):
            return source[:-len(".monitor")], True   # tap that sink's monitor
        return source, False                         # microphone node.name

    def _start_app_capture(self, name, include_mic=False):
        """Spawn dictee-app-capture for app `name`; return its private sink
        name once READY, else None (caller falls back to the default mic)."""
        sink = f"dictee_cap_{os.getpid()}"
        cmd = ["dictee-app-capture", "--sink-name", sink, "--match", name]
        if include_mic:
            cmd.append("--include-mic")
        try:
            self._appcap_proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except FileNotFoundError:
            self.error.emit(
                f"Capture de « {name} » impossible : composant "
                "dictee-app-capture introuvable")
            return None
        deadline = time.time() + 4
        while True:
            remaining = deadline - time.time()
            if remaining <= 0:
                break
            if self._appcap_proc.poll() is not None:
                break
            rlist, _, _ = select.select(
                [self._appcap_proc.stdout], [], [], remaining)
            if not rlist:
                continue  # timeout slice; loop re-checks remaining/poll
            line = self._appcap_proc.stdout.readline()
            if not line:           # EOF — process closed stdout
                break
            if line.startswith("READY"):
                self._appcap_sink = sink
                return sink
        self._stop_app_capture()
        self.error.emit(
            f"Capture de « {name} » impossible : la capture d'application "
            "n'a pas démarré")
        return None

    def _stop_app_capture(self):
        if self._appcap_proc and self._appcap_proc.poll() is None:
            self._appcap_proc.terminate()
            try:
                self._appcap_proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self._appcap_proc.kill()
        self._appcap_proc = None
        self._appcap_sink = None

    def _setup_mix_sink(self, system_source=None):
        """Build a transient null-sink fed by two loopbacks (mic + a 'system'
        source) and return the null-sink name 'dictee_mix' (captured by run()
        with stream.capture.sink=true).

        system_source is the second loopback's source: the default sink's
        monitor for the plain 'mix' source, or an isolated app sink's monitor
        for an 'app:' source with 'add mic' (so app + mic mix with independent
        levels). Each loopback's sink-input is tagged with a findable media.name
        so its volume can be controlled independently (set_mic/system_volume).
        Modules are unloaded in _teardown_mix().
        """
        if system_source is None:
            sink = subprocess.check_output(
                ["pactl", "get-default-sink"], text=True, timeout=3).strip()
            system_source = f"{sink}.monitor"
        src = subprocess.check_output(
            ["pactl", "get-default-source"], text=True, timeout=3).strip()

        def load(*args):
            return subprocess.check_output(
                ["pactl", "load-module", *args], text=True, timeout=3).strip()

        self._mix_modules.append(load(
            "module-null-sink", "sink_name=dictee_mix",
            "sink_properties=device.description=DicteeMix"))
        self._mix_modules.append(load(
            "module-loopback", f"source={src}", "sink=dictee_mix",
            "latency_msec=50",
            "sink_input_properties=media.name=dictee_mix_mic"))
        self._mix_modules.append(load(
            "module-loopback", f"source={system_source}", "sink=dictee_mix",
            "latency_msec=50",
            "sink_input_properties=media.name=dictee_mix_sys"))
        self._mic_input_id, self._sys_input_id = self._find_mix_inputs()
        # Pin both leg volumes BEFORE pw-record spawns: stream-restore has
        # already re-applied whatever volumes a past session stored for these
        # media.names (see rebalance_sys_leg), and the GUI-side rebalance only
        # lands a moment after recording starts.
        self.rebalance_sys_leg()
        return "dictee_mix"

    def _find_mix_inputs(self):
        """Map the two tagged loopback sink-inputs to their ids.

        Loopbacks take a moment to attach, so poll briefly. pactl list output
        is LOCALIZED (FR shows 'Entrée de la destination' instead of 'Sink
        Input') → force LC_ALL=C so the parse works on non-English systems.
        """
        env = dict(os.environ, LC_ALL="C")
        for _attempt in range(20):           # up to ~2 s
            out = subprocess.check_output(
                ["pactl", "list", "sink-inputs"], text=True, env=env, timeout=3)
            cur = mic = sysid = None
            for line in out.splitlines():
                line = line.strip()
                if line.startswith("Sink Input #"):
                    cur = line.split("#", 1)[1].strip()
                elif line == 'media.name = "dictee_mix_mic"':
                    mic = cur
                elif line == 'media.name = "dictee_mix_sys"':
                    sysid = cur
            if mic and sysid:
                return mic, sysid
            self.msleep(100)
        return None, None

    def _teardown_mix(self):
        """Unload all mix modules (idempotent)."""
        while self._mix_modules:
            mod = self._mix_modules.pop()
            try:
                subprocess.run(["pactl", "unload-module", mod],
                               timeout=3, capture_output=True)
            except Exception:
                pass
        self._mic_input_id = self._sys_input_id = None

    def set_system_volume(self, pct):
        """Set the system/app loopback volume (mix or app+mic)."""
        self._sys_pct = pct
        self.rebalance_sys_leg()

    def rebalance_sys_leg(self):
        """Lower the SYSTEM loopback down to the mic leg's own level.

        The system @DEFAULT_SOURCE@ sits well below nominal on hot input
        stages (30% cubic = -31.4 dB here, deliberate anti-clipping for
        dictation), while the system leg enters the mix near 0 dB — so
        notifications/visio audio dwarfed the voice by ~30 dB in the file
        (2026-07-19). Boosting the mic leg instead (first attempt) restored
        the hot raw-input level and hard-clipped 15% of the samples: a
        near-full-scale system leg plus a +31 dB mic leg cannot fit in the
        s16 file. Attenuating the system leg keeps both legs near the mic's
        quiet level — the sum physically cannot clip — and the stop-time
        R128 normalization brings the whole file back up for listening.
        The attenuation composes with the 🔊 slider via the cubic mapping
        (dB = 60*log10(pct/100)). Capped at 40 dB so a near-muted mic
        cannot silence the system leg.

        BOTH legs are pinned explicitly: pipewire-pulse's stream-restore
        re-applies the last stored volume per media.name to every new
        loopback, so an untouched leg silently inherits whatever a past
        session set (measured 2026-07-19: a fresh dictee_mix_mic came up
        at 329% / +31 dB, resurrecting the abandoned mic-boost approach
        and clipping the file). Never rely on loopback volume defaults."""
        if not self._sys_input_id:
            return
        self._set_input_volume(self._mic_input_id, 100)
        atten_db = 0.0
        try:
            out = subprocess.check_output(
                ["pactl", "get-source-volume", "@DEFAULT_SOURCE@"],
                text=True, env=dict(os.environ, LC_ALL="C"), timeout=2)
            m = re.search(r"(-?[\d.]+) dB", out)
            if m:
                atten_db = min(40.0, max(0.0, -float(m.group(1))))
        except Exception:
            pass
        pct = round(self._sys_pct * 10 ** (-atten_db / 60))
        self._set_input_volume(self._sys_input_id, pct)

    def _set_input_volume(self, input_id, pct):
        if not input_id:
            return
        try:
            subprocess.run(
                ["pactl", "set-sink-input-volume", input_id, f"{int(pct)}%"],
                timeout=2, capture_output=True)
        except Exception:
            pass

    def stop(self):
        self._stop = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self._stop_app_capture()
        self.wait(5000)   # join the QThread so run()'s teardown is done

    def pause(self):
        # Freeze the WAV: SIGSTOP pw-record (it stops writing). SIGCONT resumes.
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.send_signal(signal.SIGSTOP)
            except (ProcessLookupError, OSError):
                pass

    def resume(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.send_signal(signal.SIGCONT)
            except (ProcessLookupError, OSError):
                pass


class LevelMeterWorker(QThread):
    """Reads the live peak level of a single audio flow via parec and emits it
    (0.0-1.0). One instance per metered flow (🎤 mic / 🔊 selected output) —
    independent of the shared plasmoid level daemon, so they never conflict.

    `device` is a parec --device value (a source or '<sink>.monitor' name);
    None records the default source (the microphone).
    """

    level = pyqtSignal(float)

    def __init__(self, device=None):
        super().__init__()
        self.device = device
        self.proc = None
        self._stop = False

    def run(self):
        cmd = ["parec", "--rate=16000", "--channels=1", "--format=s16le",
               "--latency-msec=50"]
        if self.device:
            cmd.append(f"--device={self.device}")
        try:
            self.proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            return
        chunk = 1600          # 800 samples * 2 bytes ≈ 50 ms at 16 kHz
        while not self._stop:
            data = self.proc.stdout.read(chunk)
            if not data:
                break
            n = len(data) // 2
            if not n:
                continue
            samples = struct.unpack(f"<{n}h", data[:n * 2])
            peak = max(abs(s) for s in samples) / 32768.0
            self.level.emit(peak)

    def stop(self):
        self._stop = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.wait(2500)   # join the QThread (terminate closed the pipe → run() exits)


class LivePreview:
    """The live preview, cut by voices.

    The recording pw-record is writing goes to Nemotron 3 as it grows, the
    new audio of each poll in one file (`diarize-only --stream --engine
    nemotron3 --pieces`, NVIDIA's 1.04 s low-latency setting). Each piece it
    settles, one speaker and at most 30 s, is cut out of the recording and
    sent to the meeting's ASR daemon; its text comes back through on_line a
    second or two after the turn ended. Once the recording has stopped,
    finish(): run() feeds the rest, flushes the stream, transcribes the last
    pieces and returns.

    This replaces the 40 s blocks overlapping by 10 s and the word-by-word
    alignment, which made up for diarizers that could not follow more than
    4 voices in one go. No Qt here: MeetingWindow runs it in a QThread and
    turns the callbacks into signals (on_ready(), on_line(dict),
    on_error(str)).
    """

    def __init__(self, recording, diar_cmd, asr_sock, on_ready, on_line,
                 on_error, env=None, poll=1.0, asr_wait=60.0):
        self.recording = str(recording)
        self.diar_cmd = diar_cmd
        self.asr_sock = asr_sock
        self.on_ready = on_ready
        self.on_line = on_line
        self.on_error = on_error
        self.env = env
        self.poll = poll
        self.asr_wait = asr_wait          # for a daemon still loading its model
        self._finishing = threading.Event()
        self._aborted = threading.Event()
        self._proc = None
        self._drain = None
        self._stderr = collections.deque(maxlen=5)
        self._sock = None
        self._offset = None               # where the samples start in the recording
        self._fed = 0                     # bytes of samples the diarizer has had
        self._asr_deadline = None
        self._asr_missing = False

    def finish(self):
        """The recording has stopped and its file is complete."""
        self._finishing.set()

    def abort(self):
        """Stop at once, leaving the pieces not transcribed yet."""
        self._aborted.set()
        self._finishing.set()
        proc, sock = self._proc, self._sock
        if proc is not None and proc.poll() is None:
            proc.kill()
        if sock is not None:
            try:
                sock.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

    def run(self):
        tmp = tempfile.mkdtemp(prefix="dictee-meeting-live-")
        try:
            self._start_diarizer()
            self.on_ready()
            while not self._aborted.is_set():
                last = self._finishing.is_set()
                pcm = self._read_new()
                if pcm:
                    feed = os.path.join(tmp, "feed.wav")
                    write_wav(feed, pcm)
                    self._transcribe(self._ask(f"FILE: {feed}"), tmp)
                if last:
                    self._transcribe(self._ask("FLUSH"), tmp)
                    return
                self._finishing.wait(self.poll)
        except Exception as e:
            if not self._aborted.is_set():
                self.on_error(str(e))
        finally:
            self._stop_diarizer()
            shutil.rmtree(tmp, ignore_errors=True)

    def _start_diarizer(self):
        self._proc = subprocess.Popen(
            self.diar_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, bufsize=1, env=self.env)
        if self._aborted.is_set():
            raise RuntimeError("aborted")
        # It reads its commands once the model is loaded, and says so on stderr.
        for line in self._proc.stderr:
            self._stderr.append(line.strip())
            if "ready" in line:
                break
        else:
            raise RuntimeError(self._died())
        self._drain = threading.Thread(target=self._drain_stderr, daemon=True)
        self._drain.start()

    def _drain_stderr(self):
        try:
            for line in self._proc.stderr:
                self._stderr.append(line.strip())
        except (OSError, ValueError):
            pass

    def _died(self):
        """Why the diarizer is gone, from its last words on stderr."""
        try:
            code = self._proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            code = None
        if self._drain is not None:
            self._drain.join(1)
        said = " / ".join(line for line in self._stderr if line)
        return (f"diarize-only arrêté (code {code})"
                + (f" : {said}" if said else ""))

    def _stop_diarizer(self):
        proc = self._proc
        if proc is None:
            return
        try:
            proc.stdin.close()             # end of input: diarize-only exits
        except (OSError, ValueError):
            pass
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()

    def _ask(self, command):
        """The pieces the diarizer answers to one command, as (start, end,
        speaker), in seconds since the start of the recording."""
        try:
            self._proc.stdin.write(command + "\n")
            self._proc.stdin.flush()
        except (OSError, ValueError):
            raise RuntimeError(self._died())
        pieces = []
        while True:
            line = self._proc.stdout.readline()
            if not line:
                raise RuntimeError(self._died())
            line = line.strip()
            if not line:
                return pieces
            if line.startswith("ERROR:"):
                raise RuntimeError(f"diarize-only : {line}")
            start, end, speaker = line.split()
            pieces.append((float(start), float(end), int(speaker)))

    def _read_new(self):
        """The samples pw-record has written since the last call (raw s16)."""
        try:
            with open(self.recording, "rb") as f:
                if self._offset is None:
                    self._offset = wav_data_offset(f.read(4096))
                    if self._offset is None:
                        return b""
                start = self._offset + self._fed
                size = f.seek(0, os.SEEK_END)
                if size - start < 2:
                    return b""
                f.seek(start)
                pcm = f.read((size - start) // 2 * 2)
        except FileNotFoundError:
            return b""
        pcm = pcm[:len(pcm) // 2 * 2]
        self._fed += len(pcm)
        return pcm

    def _transcribe(self, pieces, tmp):
        for start, end, speaker in pieces:
            if self._aborted.is_set():
                return
            path = os.path.join(tmp, "piece.wav")
            with open(self.recording, "rb") as f:
                f.seek(self._offset + round(start * 16000) * 2)
                write_wav(path, f.read((round(end * 16000) - round(start * 16000)) * 2))
            text = self._asr(path)
            if text:
                self.on_line({"speaker": speaker, "text": text,
                              "start_s": start, "end_s": end})

    def _asr(self, path):
        """The daemon's text for one piece; "" when it failed, the reason
        going to on_error."""
        if not self._asr_up():
            return ""
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self._sock = sock
        data = b""
        try:
            sock.settimeout(120)
            sock.connect(self.asr_sock)
            sock.sendall((path + "\n").encode("utf-8"))
            while True:
                chunk = sock.recv(4096)
                if not chunk:
                    break
                data += chunk
        except OSError as e:
            if not self._aborted.is_set():
                self.on_error(f"transcription : {e}")
            return ""
        finally:
            self._sock = None
            sock.close()
        text = data.decode("utf-8", errors="replace").strip()
        if text.startswith("ERROR:"):
            self.on_error(f"transcription : {text}")
            return ""
        return text

    def _asr_up(self):
        """Whether the ASR daemon listens, waiting asr_wait seconds from the
        first piece for one still loading its model. A daemon that never
        came is reported once."""
        if self._asr_deadline is None:
            self._asr_deadline = time.monotonic() + self.asr_wait
        while not os.path.exists(self.asr_sock):
            if self._aborted.is_set():
                return False
            if time.monotonic() >= self._asr_deadline:
                if not self._asr_missing:
                    self._asr_missing = True
                    self.on_error("le démon de transcription ne répond pas")
                return False
            time.sleep(0.2)
        return True


class LivePreviewThread(QThread):
    """Runs a LivePreview off the GUI thread, its callbacks as signals.
    QThread.finished: it is over (after finish(), with every piece in)."""

    ready = pyqtSignal()
    line = pyqtSignal(dict)
    error = pyqtSignal(str)

    def __init__(self, recording, diar_cmd, asr_sock, env):
        super().__init__()
        self.preview = LivePreview(recording, diar_cmd, asr_sock,
                                   on_ready=self.ready.emit,
                                   on_line=self.line.emit,
                                   on_error=self.error.emit, env=env)

    def run(self):
        self.preview.run()


def _moss_available():
    """Check if the MOSS one-pass engine is usable (its --check covers the
    model, the native runtime and the python bindings). MOSS has no
    streaming mode: it can only serve the FINAL analysis at Stop, never the
    live preview."""
    exe = shutil.which("dictee-moss-diarize")
    if not exe:
        return False
    try:
        return subprocess.run([exe, "--check"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL,
                              timeout=10).returncode == 0
    except Exception:
        return False


