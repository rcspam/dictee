def _acquire_singleton_lock():
    """Ensure a single meeting window per user via an flock'd lock file.

    The lock is released automatically when the process dies, so there is no
    stale-file problem — unlike the previous os.path.exists guard, which never
    triggered because nothing ever created the file it checked. Returns the
    open file object (keep it alive for the whole process lifetime) or None if
    another instance already holds the lock.
    """
    lock_path = f"/tmp/dictee-meeting-live-{os.getuid()}.lock"
    fd = open(lock_path, "w")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fd.close()
        return None
    return fd


def default_meeting_asr(conf):
    """The meeting's ASR model when none was chosen: the F9 engine when the
    meeting offers it, else Whisper-Rust. Parakeet left meetings on
    2026-10-04 (it turns some recordings into English), faster-whisper too.

    Whisper-Rust is listed per ENGINE: the model size follows the
    dictee-setup selection in dictee.conf, so the combo doesn't duplicate
    the size choice."""
    backend = (conf.get("DICTEE_ASR_BACKEND") or "").strip().lower()
    if backend in ("whisper-rust", "canary", "nemotron", "kyutai"):
        return backend
    return "whisper-rust"


def normalize_asr_spec(spec):
    """Fold the sized whisper specs saved by older versions into the
    engine-level specs the combo exposes now."""
    s = (spec or "").strip()
    if s.startswith("whisper-rust"):
        return "whisper-rust"
    if s.startswith("whisper-"):
        return "whisper"
    return s


def slug_title(title):
    """Lowercase, spaces/non-alnum → '-', collapse repeats, trim, max 40 chars."""
    s = (title or "").strip().lower()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")
    return s[:40].strip("-")


def _conf_value(key):
    """One DICTEE_* value from ~/.config/dictee.conf, or None."""
    conf = Path.home() / ".config/dictee.conf"
    try:
        for line in conf.read_text(encoding="utf-8").splitlines():
            s = line.strip()
            if s.startswith(key + "="):
                return s.split("=", 1)[1].strip().strip('"').strip("'") or None
    except OSError:
        pass
    return None


def meeting_dir(timestamp=None, title=""):
    # The folder chosen in dictee-setup lands in dictee.conf; the environment
    # only carries the key when a caller set it on purpose (tests, scripts).
    base_dir = (os.environ.get("DICTEE_MEETING_DIR")
                or _conf_value("DICTEE_MEETING_DIR")
                or os.path.join(os.path.expanduser("~"),
                                ".local/share/dictee/meetings"))
    ts = timestamp or datetime.now().strftime("%Y-%m-%d-%H%M")
    sl = slug_title(title)
    name = f"{ts}_{sl}" if sl else ts
    base = Path(base_dir) / name
    n = 2
    while base.exists():                      # collision on date+slug → suffix -2, -3…
        base = Path(base_dir) / f"{name}-{n}"
        n += 1
    base.mkdir(parents=True, exist_ok=True)
    return base


def normalize_wav(wav):
    """Bring the SPEECH loudness of a recording up to -16 LUFS (in place).

    Loudness, not peak: one keyboard click near full scale would anchor
    a peak normalization while the speech sits 25+ dB lower (measured
    2026-07-19: peak already at -3 dB yet only -28 LUFS integrated).
    Constant gain from the EBU R128 integrated loudness; the limiter
    only tames the few transients that would otherwise clip.
    Shared by the meeting stop path and the sound-test dialog so the
    test stays representative of a real meeting."""
    if not wav or not Path(wav).is_file():
        return
    try:
        probe = subprocess.run(
            ["ffmpeg", "-i", str(wav),
             "-af", "loudnorm=print_format=json", "-f", "null", "-"],
            capture_output=True, text=True, timeout=300)
        m = re.search(r'"input_i"\s*:\s*"(-?[\d.]+)"', probe.stderr)
        if not m:
            return
        gain = -16.0 - float(m.group(1))
        # Nothing to gain, or a near-silent take (amplifying pure room
        # noise only manufactures hiss): leave the file alone. 50 dB
        # because a real meeting on this rig already needs +40 (voice-only
        # take measured -55.9 LUFS integrated, 2026-07-19), and the system
        # leg is attenuated to that same level (rebalance_sys_leg).
        if gain <= 1.0 or gain > 50.0:
            return
        tmp = f"{wav}.norm.wav"
        rc = subprocess.run(
            ["ffmpeg", "-y", "-v", "error", "-i", str(wav),
             "-af", f"volume={gain:.1f}dB,alimiter=limit=0.708:level=false",
             "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", tmp],
            timeout=600).returncode
        if rc == 0 and os.path.getsize(tmp) > 44:
            os.replace(tmp, wav)
            print(f"[meeting-live] {os.path.basename(str(wav))} normalized "
                  f"(+{gain:.1f} dB)", file=sys.stderr)
        else:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    except Exception as e:
        print(f"[meeting-live] normalization skipped: {e}", file=sys.stderr)


def wav_data_offset(head):
    """Where the samples start in a WAV file whose first bytes are `head`:
    past the RIFF header and every chunk before 'data' (pw-record writes 44
    bytes, ffmpeg adds a LIST chunk). None while the header is incomplete."""
    if len(head) < 12 or head[:4] != b"RIFF" or head[8:12] != b"WAVE":
        return None
    pos = 12
    while pos + 8 <= len(head):
        if head[pos:pos + 4] == b"data":
            return pos + 8
        size = struct.unpack_from("<I", head, pos + 4)[0]
        pos += 8 + size + (size & 1)
    return None


def write_wav(path, pcm):
    """A 16 kHz mono 16-bit WAV of the raw samples `pcm`."""
    with wave.open(str(path), "wb") as out:
        out.setnchannels(1)
        out.setsampwidth(2)
        out.setframerate(16000)
        out.writeframes(pcm)


def _data_dirs(name):
    """A dictee model's directory in the user data dir, then the system one."""
    return (os.path.join(os.environ.get("XDG_DATA_HOME",
                                        os.path.expanduser("~/.local/share")),
                         "dictee", name),
            os.path.join("/usr/share/dictee", name))


def _nemotron3_dir():
    """Directory of Nemotron 3 Diarization (model.onnx and its weights), the
    user's first, as dictee-transcribe finds it; None when it is missing."""
    for d in _data_dirs("nemotron3-diar"):
        if (os.path.isfile(os.path.join(d, "model.onnx"))
                and os.path.isfile(os.path.join(d, "model.onnx_data"))):
            return d
    return None


def _whisper_rust_ggml(conf):
    """The Whisper-Rust model file: the one dictee-setup selected
    (DICTEE_WHISPER_RUST_GGML), else one of the configured size in the user
    or system model dir, as dictee-transcribe resolves it; "" when none."""
    path = (conf.get("DICTEE_WHISPER_RUST_GGML") or "").strip()
    if path and os.path.isfile(path):
        return path
    size = (conf.get("DICTEE_WHISPER_RUST_MODEL") or "large-v3").strip()
    for d in _data_dirs("whisper-rust"):
        for pattern in (f"ggml-{size}-q*.bin", f"ggml-{size}.bin"):
            hits = sorted(glob.glob(os.path.join(d, pattern)))
            if hits:
                return hits[0]
    return ""


def _canary_installed():
    return any(os.path.isfile(os.path.join(d, f)) for d in _data_dirs("canary")
               for f in ("encoder-model.onnx", "encoder-model.int8.onnx"))


def live_asr_daemon(spec, conf, sock):
    """(command, environment additions) of the isolated daemon that
    transcribes the live preview's turns with `spec`, listening on `sock`;
    (None, reason) when this machine cannot. Same recipes as
    dictee-transcribe's IsolatedAsrDaemon; the dictation language reaches
    the daemon with the rest of dictee.conf (_build_subprocess_env)."""
    env = {"DICTEE_DAEMON_NO_PROVIDER": "1"}   # never clobber the F9 badge
    if spec == "whisper-rust":
        ggml = _whisper_rust_ggml(conf)
        if not ggml:
            return None, "aucun modèle Whisper-Rust installé (voir dictee-setup)"
        # DICTEE_ASR_BACKEND=whisper flips the daemon to its whisper branch:
        # a conf-level backend (parakeet…) would silently win otherwise.
        env.update(DICTEE_ASR_BACKEND="whisper", DICTEE_WHISPER_RUST_GGML=ggml)
        cmd = ["transcribe-daemon-whisper-rust", "--socket", sock]
    elif spec == "canary":
        if not _canary_installed():
            return None, "Canary n'est pas installé (voir dictee-setup)"
        env["DICTEE_ASR_BACKEND"] = "canary"
        cmd = ["transcribe-daemon", "--canary", "--socket", sock]
    elif spec == "nemotron":
        env["DICTEE_ASR_BACKEND"] = "nemotron"
        cmd = ["transcribe-daemon", "--socket", sock]
    elif spec == "kyutai":
        env["DICTEE_ASR_BACKEND"] = "kyutai"
        cmd = ["transcribe-daemon-kyutai", "--socket", sock]
    else:
        return None, f"modèle inconnu : {spec}"
    if not shutil.which(cmd[0]):
        return None, f"{cmd[0]} introuvable"
    return cmd, env


def analysis_command(audio, transcript, diar_engine, asr_spec, preview_whole):
    """The dictee-transcribe command that opens a stopped meeting.

    The live preview is the result when it covers the whole meeting with
    Nemotron 3: it is as accurate as a new analysis (SUMM-RE, 2026-10-04:
    WER 31.0 against 31.5 % and 38.6 against 39.2 %, words on the right
    voice 87.5 against 87.8 % and 82.0 against 82.2 %), so the meeting
    opens at once. With MOSS, or a preview that missed turns or holds
    none, the meeting is analysed again."""
    has_lines = False
    try:
        with open(transcript, encoding="utf-8") as f:
            has_lines = any(re.match(r"\[\d+\.?\d*s - \d+\.?\d*s\] Speaker \d+:", line)
                            for line in f)
    except OSError:
        pass
    cmd = ["dictee-transcribe", "--file", str(audio)]
    if preview_whole and diar_engine != "moss" and has_lines:
        cmd += ["--transcript", str(transcript)]
    else:
        cmd += ["--diarize", "--diar-engine", diar_engine or "nemotron3"]
    cmd += ["--asr-model", asr_spec]
    return cmd


def _build_subprocess_env():
    """Returns os.environ + ORT_DYLIB_PATH + all DICTEE_* keys from
    ~/.config/dictee.conf. Used for Rust binaries that need to see
    DICTEE_FORCE_CPU and friends.
    """
    env = os.environ.copy()
    ort_lib = "/usr/lib/dictee/libonnxruntime.so"
    if os.path.isfile(ort_lib):
        env["ORT_DYLIB_PATH"] = ort_lib
    conf_path = Path.home() / ".config/dictee.conf"
    if conf_path.is_file():
        try:
            for line in conf_path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                if k.startswith("DICTEE_"):
                    env[k] = v.strip().strip('"').strip("'")
        except OSError:
            pass
    return env


def _meeting_icon(recording):
    """Window icon: red 'team-meeting.svg' while recording, black otherwise.
    Resolved from the repo (dev) or /usr/share/dictee/assets (installed)."""
    from PyQt6.QtGui import QIcon
    name = "team-meeting.svg" if recording else "team-meeting-black.svg"
    for p in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "assets", name),
              os.path.join("/usr/share/dictee/assets", name)):
        if os.path.isfile(p):
            return QIcon(p)
    return QIcon()


