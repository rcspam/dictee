        self.cmb_source = SourceComboBox(self._populate_sources)
        self.cmb_source.currentIndexChanged.connect(self._on_source_changed)
        src_row.addWidget(self.cmb_source, 1)
        left_col.addLayout(src_row)

        # ASR model selector: persisted in DICTEE_MEETING_ASR_MODEL, defaults to
        # the current F9 model (backend + quant from dictee.conf).
