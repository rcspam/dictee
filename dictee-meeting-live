        left_col.addWidget(self.chk_include_mic)

        btn_row = QHBoxLayout()
        self.btn_start = QPushButton("▶")
        self.btn_start.setToolTip("Démarrer")
        self.btn_start.setFixedSize(64, 64)
        self.btn_start.setStyleSheet("font-size: 22pt;")
        self.btn_start.clicked.connect(self._on_start_pause)
