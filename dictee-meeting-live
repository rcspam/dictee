        # Red icon while recording, black otherwise — on the window AND the
        # QApplication (taskbar). Works because we don't call setDesktopFileName.
        icon = _meeting_icon(recording)
        self.setWindowIcon(icon)
        app = QApplication.instance()
        if app is not None:
            app.setWindowIcon(icon)

    def _blink_rec_dot(self):
        # Blink the COLOR (not visibility) so the dot keeps its width and the
        # status text never shifts. Red while recording, themed while paused.
        self._dot_on = not getattr(self, "_dot_on", True)
        on_color = "#E53935" if self._state == "recording" else "#EF9A9A"  # red / pale-red
        self.rec_dot.setStyleSheet(
            (f"color: {on_color};" if self._dot_on else "color: transparent;")
            + " font-size: 16pt;")

    def _set_state(self, state):
        self._state = state
        recording = state == "recording"
        paused = state == "paused"

        # (btn_start text, tooltip, start_enabled, stop_enabled, analyze_enabled)
        cfg = {
            "idle":      ("▶", "Démarrer",  True,  False, False),
            "recording": ("⏸", "Pause",     True,  True,  False),
            "paused":    ("▶", "Reprendre", True,  True,  False),
            "stopped":   ("▶", "Démarrer",  False, False, True),
        }
        text, tip, start_on, stop_on, analyze_on = cfg[state]
        self.btn_start.setText(text)
        self.btn_start.setToolTip(tip)
        # A running sound test would fight over the dictee_mix null-sink.
        dlg = getattr(self, "_sound_test_dialog", None)
        self.btn_start.setEnabled(start_on and not (dlg and dlg._worker))
        self.btn_stop.setEnabled(stop_on)
        self.btn_analyze.setEnabled(analyze_on)
        self.btn_sound_test.setEnabled(state in ("idle", "stopped"))
        # Source and title can't change mid-capture: only editable when idle/stopped.
        self.cmb_source.setEnabled(state in ("idle", "stopped"))
        self.chk_include_mic.setEnabled(state in ("idle", "stopped"))
        self._title_edit.setEnabled(state in ("idle", "stopped"))

        self.status_label.setText({
            "idle": "Prêt à enregistrer",
            "recording": "Enregistrement en cours",
            "paused": "Enregistrement en pause",
            "stopped": "Enregistrement arrêté",
        }[state])

        if recording or paused:
            # Glyph only; _blink_rec_dot owns the colour (red vs pale-red).
            self.rec_dot.setText("●" if recording else "❚❚")
            self.rec_dot.setVisible(True)
            self._dot_on = False
            self._blink_rec_dot()        # paint lit immediately
            self._blink_timer.start()
        else:
            self._blink_timer.stop()
            self.rec_dot.setVisible(False)

        self._apply_icon(recording)      # red icon only while recording

    def _on_start_pause(self):
        if self._state == "idle":
            self.start_meeting()
        elif self._state == "recording":
            if self.audio_worker:
                self.audio_worker.pause()
            self._tick_timer.stop()
            self._set_state("paused")
        elif self._state == "paused":
            if self.audio_worker:
                self.audio_worker.resume()
            self._tick_timer.start()
            self._set_state("recording")

