class AudioCaptureWorker(QThread):
    """Continuous audio capture via pw-record into a growing WAV file.

    Honors the selected meeting source: a node.name (mic / *.monitor), an
    'app:<name>' resolved to the sink the app plays to (captured via its
    monitor), an empty value (default mic), or 'mix' — a transient null-sink
    fed by two loopbacks (microphone + system monitor) torn down when capture
    ends. Sink captures use 'pw-record -P stream.capture.sink=true'.
    """

    error = pyqtSignal(str)
    ready = pyqtSignal()   # emitted (worker thread) once the source is resolved
                           #   and _appcap_sink / mix sink-input ids are set

    def __init__(self, output_wav: Path, source: str = "",
                 include_mic: bool = False):
        super().__init__()
        self.output_wav = output_wav
        self.source = source or ""
        self._include_mic = include_mic   # add mic to isolated app capture
        self.proc = None
        self._stop = False
        # mix lifecycle (populated by _setup_mix_sink, cleared by _teardown_mix)
        self._mix_modules = []      # null-sink + 2 loopback module ids
        self._mic_input_id = None   # sink-input id of the mic loopback
        self._sys_input_id = None   # sink-input id of the system loopback
        self._appcap_proc = None    # dictee-app-capture subprocess (app sources)
        self._appcap_sink = None    # its virtual sink name

    def run(self):
        try:
            target, capture_sink = self._resolve_target(self.source)
        except Exception as exc:
            self.error.emit(f"audio source setup failed: {exc}")
            self._teardown_mix()
            self._stop_app_capture()
            return
        if target is None:
            # App capture failed — do NOT record anything (never the mic).
            self._teardown_mix()
            self._stop_app_capture()
            return
        # Source resolved: _appcap_sink / mix sink-input ids are now set, so the
        # GUI can safely point meters + apply mix volumes (no fixed-delay guess).
        self.ready.emit()
        cmd = ["pw-record", "--format=s16", "--rate=16000", "--channels=1"]
        if capture_sink:
            # Capturing a sink's monitor (system audio / an app / the mix
            # null-sink) REQUIRES this property. 'pw-record --target=<X>.monitor'
            # does NOT tap the monitor — it silently falls back to the default
            # microphone — so per-app / system / mix capture would be empty.
            cmd += ["-P", "stream.capture.sink=true"]
        cmd += [f"--target={target}", str(self.output_wav)]
        try:
            self.proc = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
            )
            rc = self.proc.wait()
            if rc != 0 and not self._stop:
                err = self.proc.stderr.read().decode("utf-8", "replace")
                self.error.emit(f"pw-record exit {rc}: {err}")
        except FileNotFoundError:
            self.error.emit("pw-record not found. Is PipeWire installed?")
        finally:
            self._teardown_mix()
            self._stop_app_capture()

    # ── source resolution ──────────────────────────────────────────────────
    def _resolve_target(self, source):
        """Resolve a meeting source value to (pw-record target, capture_sink).

        capture_sink=True means the target is a SINK whose monitor we tap with
        'stream.capture.sink=true' (system audio, an app's sink, or the mix
        null-sink). False means a normal capture source (a microphone).
        """
        if source == "mix":
            return self._setup_mix_sink(), True
        if not source:
            return "@DEFAULT_AUDIO_SOURCE@", False
        if source.startswith("app:"):
            # Capture the app ISOLATED (app-only, never the mic) so its meter
            # and its level stay independent of the microphone.
            sink = self._start_app_capture(source[4:], include_mic=False)
            if not sink:
                # NEVER fall back to the mic for an app source — that would
                # silently record the wrong thing. None → run() aborts (the
                # error was already emitted by _start_app_capture).
                return None, False
            if self._include_mic:
                # 'Add mic': mix the isolated app audio with the mic through two
                # independently-controllable loopbacks (same machinery as 'mix'),
                # so the two levels — and the two meters — stay separate.
                return self._setup_mix_sink(system_source=f"{sink}.monitor"), True
            return sink, True
        if source.endswith(".monitor"):
            return source[:-len(".monitor")], True   # tap that sink's monitor
        return source, False                         # microphone node.name

    def _start_app_capture(self, name, include_mic=False):
        """Spawn dictee-app-capture for app `name`; return its private sink
        name once READY, else None (caller falls back to the default mic)."""
        sink = f"dictee_cap_{os.getpid()}"
        cmd = ["dictee-app-capture", "--sink-name", sink, "--match", name]
        if include_mic:
            cmd.append("--include-mic")
        try:
            self._appcap_proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except FileNotFoundError:
            self.error.emit(
                f"Capture de « {name} » impossible : composant "
                "dictee-app-capture introuvable")
            return None
        deadline = time.time() + 4
        while True:
            remaining = deadline - time.time()
            if remaining <= 0:
                break
            if self._appcap_proc.poll() is not None:
                break
            rlist, _, _ = select.select(
                [self._appcap_proc.stdout], [], [], remaining)
            if not rlist:
                continue  # timeout slice; loop re-checks remaining/poll
            line = self._appcap_proc.stdout.readline()
            if not line:           # EOF — process closed stdout
                break
            if line.startswith("READY"):
                self._appcap_sink = sink
                return sink
        self._stop_app_capture()
        self.error.emit(
            f"Capture de « {name} » impossible : la capture d'application "
            "n'a pas démarré")
        return None

    def _stop_app_capture(self):
        if self._appcap_proc and self._appcap_proc.poll() is None:
            self._appcap_proc.terminate()
            try:
                self._appcap_proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self._appcap_proc.kill()
        self._appcap_proc = None
        self._appcap_sink = None

    def _setup_mix_sink(self, system_source=None):
        """Build a transient null-sink fed by two loopbacks (mic + a 'system'
        source) and return the null-sink name 'dictee_mix' (captured by run()
        with stream.capture.sink=true).

        system_source is the second loopback's source: the default sink's
        monitor for the plain 'mix' source, or an isolated app sink's monitor
        for an 'app:' source with 'add mic' (so app + mic mix with independent
        levels). Each loopback's sink-input is tagged with a findable media.name
        so its volume can be controlled independently (set_mic/system_volume).
        Modules are unloaded in _teardown_mix().
        """
        if system_source is None:
            sink = subprocess.check_output(
                ["pactl", "get-default-sink"], text=True, timeout=3).strip()
            system_source = f"{sink}.monitor"
        src = subprocess.check_output(
            ["pactl", "get-default-source"], text=True, timeout=3).strip()

        def load(*args):
            return subprocess.check_output(
                ["pactl", "load-module", *args], text=True, timeout=3).strip()

        self._mix_modules.append(load(
            "module-null-sink", "sink_name=dictee_mix",
            "sink_properties=device.description=DicteeMix"))
        self._mix_modules.append(load(
            "module-loopback", f"source={src}", "sink=dictee_mix",
            "latency_msec=50",
            "sink_input_properties=media.name=dictee_mix_mic"))
        self._mix_modules.append(load(
            "module-loopback", f"source={system_source}", "sink=dictee_mix",
            "latency_msec=50",
            "sink_input_properties=media.name=dictee_mix_sys"))
        self._mic_input_id, self._sys_input_id = self._find_mix_inputs()
        return "dictee_mix"

    def _find_mix_inputs(self):
        """Map the two tagged loopback sink-inputs to their ids.

        Loopbacks take a moment to attach, so poll briefly. pactl list output
        is LOCALIZED (FR shows 'Entrée de la destination' instead of 'Sink
        Input') → force LC_ALL=C so the parse works on non-English systems.
        """
        env = dict(os.environ, LC_ALL="C")
        for _attempt in range(20):           # up to ~2 s
            out = subprocess.check_output(
                ["pactl", "list", "sink-inputs"], text=True, env=env, timeout=3)
            cur = mic = sysid = None
            for line in out.splitlines():
                line = line.strip()
                if line.startswith("Sink Input #"):
                    cur = line.split("#", 1)[1].strip()
                elif line == 'media.name = "dictee_mix_mic"':
                    mic = cur
                elif line == 'media.name = "dictee_mix_sys"':
                    sysid = cur
            if mic and sysid:
                return mic, sysid
            self.msleep(100)
        return None, None

    def _teardown_mix(self):
        """Unload all mix modules (idempotent)."""
        while self._mix_modules:
            mod = self._mix_modules.pop()
            try:
                subprocess.run(["pactl", "unload-module", mod],
                               timeout=3, capture_output=True)
            except Exception:
                pass
        self._mic_input_id = self._sys_input_id = None

    def set_system_volume(self, pct):
        """Set the system/app loopback volume (mix or app+mic). The mic loopback
        stays at 100% — the mic level is the system @DEFAULT_SOURCE@ volume."""
        self._set_input_volume(self._sys_input_id, pct)

    def _set_input_volume(self, input_id, pct):
        if not input_id:
            return
        try:
            subprocess.run(
                ["pactl", "set-sink-input-volume", input_id, f"{int(pct)}%"],
                timeout=2, capture_output=True)
        except Exception:
            pass

    def stop(self):
        self._stop = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self._stop_app_capture()
        self.wait(5000)   # join the QThread so run()'s teardown is done

    def pause(self):
        # Freeze the WAV: SIGSTOP pw-record (it stops writing). SIGCONT resumes.
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.send_signal(signal.SIGSTOP)
            except (ProcessLookupError, OSError):
                pass

    def resume(self):
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.send_signal(signal.SIGCONT)
            except (ProcessLookupError, OSError):
                pass


class LevelMeterWorker(QThread):
    """Reads the live peak level of a single audio flow via parec and emits it
    (0.0-1.0). One instance per metered flow (🎤 mic / 🔊 selected output) —
    independent of the shared plasmoid level daemon, so they never conflict.

    `device` is a parec --device value (a source or '<sink>.monitor' name);
    None records the default source (the microphone).
    """

    level = pyqtSignal(float)

    def __init__(self, device=None):
        super().__init__()
        self.device = device
        self.proc = None
        self._stop = False

    def run(self):
        cmd = ["parec", "--rate=16000", "--channels=1", "--format=s16le",
               "--latency-msec=50"]
        if self.device:
            cmd.append(f"--device={self.device}")
        try:
            self.proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            return
        chunk = 1600          # 800 samples * 2 bytes ≈ 50 ms at 16 kHz
        while not self._stop:
            data = self.proc.stdout.read(chunk)
            if not data:
                break
            n = len(data) // 2
            if not n:
                continue
            samples = struct.unpack(f"<{n}h", data[:n * 2])
            peak = max(abs(s) for s in samples) / 32768.0
            self.level.emit(peak)

    def stop(self):
        self._stop = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.wait(2500)   # join the QThread (terminate closed the pipe → run() exits)


class ChunkerWorker(QThread):
    """Splits the growing audio.wav into chunks with overlap via ffmpeg.

    Emits `chunk_ready(int chunk_id, str path)` once each chunk is extracted.
    Strategy: poll every 1 s; once duration >= start_t + chunk_duration,
    extract [start_t, start_t+chunk_duration] into chunk_NNN.wav and advance
    start_t by (chunk_duration - overlap).
    """

    chunk_ready = pyqtSignal(int, str)
    error = pyqtSignal(str)

    def __init__(self, audio_wav: Path, chunks_dir: Path,
                 chunk_duration: int = 40, overlap: int = 10):
        super().__init__()
        self.audio_wav = audio_wav
        self.chunks_dir = chunks_dir
        self.chunk_duration = chunk_duration
        self.overlap = overlap
        self.advance = chunk_duration - overlap
        self._stop = False
        self.chunk_id = 0

    def run(self):
        self.chunks_dir.mkdir(parents=True, exist_ok=True)
        start_t = 0
        while not self._stop:
            duration = self._wav_duration(self.audio_wav)
            if duration >= start_t + self.chunk_duration:
                chunk_path = self.chunks_dir / f"chunk_{self.chunk_id:04d}.wav"
                rc = self._extract(start_t, self.chunk_duration, chunk_path)
                if rc == 0:
                    self.chunk_ready.emit(self.chunk_id, str(chunk_path))
                    self.chunk_id += 1
                    start_t += self.advance
                else:
                    self.error.emit(f"ffmpeg extract failed (chunk {self.chunk_id})")
                    return
            time.sleep(1)
        # Stopped: flush the final partial chunk so the live preview captures
        # the tail (audio recorded after the last full chunk).
        self._flush_tail(start_t)

    def _flush_tail(self, start_t):
        """Emit a final partial chunk [start_t, end] on stop, but only if there
        is NEW content beyond the overlap the last full chunk already covered."""
        duration = self._wav_duration(self.audio_wav)
        if duration <= start_t + self.overlap:
            return
        chunk_path = self.chunks_dir / f"chunk_{self.chunk_id:04d}.wav"
        if self._extract(start_t, duration - start_t, chunk_path) == 0:
            self.chunk_ready.emit(self.chunk_id, str(chunk_path))
            self.chunk_id += 1

    def _wav_duration(self, path: Path) -> float:
        # 44 byte header + raw PCM s16le mono 16 kHz = 32000 B/s
        try:
            size = path.stat().st_size
            return max(0.0, (size - 44) / 32000.0)
        except FileNotFoundError:
            return 0.0

    def _extract(self, start_s: int, dur_s: int, out_path: Path) -> int:
        cmd = [
            "ffmpeg", "-y",
            "-ss", str(start_s),
            "-t", str(dur_s),
            "-i", str(self.audio_wav),
            "-ar", "16000", "-ac", "1",
            "-c:a", "pcm_s16le",
            str(out_path),
        ]
        proc = subprocess.run(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return proc.returncode

    def stop(self):
        self._stop = True
        self.wait(3000)   # join the QThread (run() checks _stop within ~1 s)


class TranscriptionWorker(QObject):
    """For each ready chunk, calls transcribe-client and emits (chunk_id, tokens).

    tokens = [{"text": str, "start_s": float, "end_s": float}, ...]
    Uses the existing transcribe-daemon (Parakeet already in RAM via systemd).
    """

    transcribed = pyqtSignal(int, list)
    error = pyqtSignal(int, str)

    # Nemotron mode only: pre-aligned lines emitted straight to the preview
    # (same contract as AlignerWorker.aligned — the aligner is bypassed).
    aligned_direct = pyqtSignal(int, list)

    def __init__(self, whisper_sock=None, nemotron_sock=None):
        super().__init__()
        # When set, the live preview transcribes via a dedicated isolated whisper
        # daemon on this private socket (chosen model = Whisper) instead of the F9
        # Parakeet daemon — so the live text matches the final-analysis language.
        self._whisper_sock = whisper_sock
        # When set, the live preview runs per-Sortformer-segment transcription
        # via an isolated nemotron daemon (transcribe_segments); transcribe()
        # is never called in that mode.
        self._nemotron_sock = nemotron_sock
        xdg = os.environ.get("XDG_RUNTIME_DIR")
        if xdg:
            self.daemon_socket = os.path.join(xdg, "transcribe.sock")
        else:
            # Must match the daemon's fallback (transcribe_daemon.rs): the dash
            # goes before the uid, not after ".sock".
            self.daemon_socket = f"/tmp/transcribe-{os.getuid()}.sock"

    def transcribe(self, chunk_id: int, chunk_path: str):
        if self._whisper_sock:
            self._transcribe_whisper(chunk_id, chunk_path)
            return
        if not os.path.exists(self.daemon_socket):
            self.error.emit(
                chunk_id,
                f"socket transcribe-daemon absente ({self.daemon_socket})",
            )
            return
        try:
            proc = subprocess.run(
                ["transcribe-client", chunk_path, "--json-timestamps"],
                capture_output=True,
                text=True,
                timeout=20,
                env=_build_subprocess_env(),
            )
            if proc.returncode != 0:
                self.error.emit(
                    chunk_id,
                    f"transcribe-client exit {proc.returncode}: {proc.stderr.strip()}",
                )
                return
            data = json.loads(proc.stdout)
            tokens = data.get("tokens", [])
            self.transcribed.emit(chunk_id, tokens)
        except subprocess.TimeoutExpired:
            self.error.emit(chunk_id, "transcribe-client timeout (>20 s)")
        except json.JSONDecodeError as e:
            self.error.emit(chunk_id, f"JSON parse error: {e}")

    def _transcribe_whisper(self, chunk_id: int, chunk_path: str):
        """Live transcription via the isolated whisper daemon (private socket).
        Speaks the python daemon protocol directly: '<path>\\ttimestamps' →
        '[start s - end s] word' lines → tokens. The daemon's cold model load
        may not be ready for the first chunk(s); we surface that as a soft error
        and the next chunk retries."""
        import socket as _sock
        if not os.path.exists(self._whisper_sock):
            self.error.emit(chunk_id, "daemon Whisper live pas encore prêt (chargement du modèle)")
            return
        try:
            s = _sock.socket(_sock.AF_UNIX, _sock.SOCK_STREAM)
            s.settimeout(60)
            s.connect(self._whisper_sock)
            s.sendall((chunk_path + "\ttimestamps\n").encode("utf-8"))
            data = b""
            while True:
                buf = s.recv(4096)
                if not buf:
                    break
                data += buf
            s.close()
            text = data.decode("utf-8", errors="replace").strip()
            if text.startswith("ERROR:"):
                self.error.emit(chunk_id, f"Whisper live: {text}")
                return
            self.transcribed.emit(chunk_id, _parse_whisper_tokens(text))
        except (ConnectionRefusedError, OSError) as e:
            self.error.emit(chunk_id, f"Whisper live: {e}")

    def transcribe_segments(self, chunk_id: int, chunk_path: str,
                            segments: list, offset: float = 0.0):
        """Nemotron live: the daemon has no word timestamps (empty tokens), so
        timestamp-overlap alignment is impossible. Instead, cut the chunk wav
        on the Sortformer segments and transcribe each piece separately on the
        private socket — speaker attribution is exact by construction. Emits
        aligned_direct(chunk_id, lines); ALWAYS emits (even empty) because the
        tail-chunk stop-finalize waits on that signal."""
        import socket as _sock
        import tempfile
        import wave as _wave
        if not os.path.exists(self._nemotron_sock):
            self.error.emit(chunk_id,
                            "daemon Nemotron live pas encore prêt (chargement du modèle)")
            self.aligned_direct.emit(chunk_id, [])
            return
        lines = []
        try:
            with _wave.open(chunk_path, "rb") as wf:
                rate = wf.getframerate()
                width = wf.getsampwidth()
                channels = wf.getnchannels()
                total = wf.getnframes()
                for seg in segments:
                    start = max(0.0, float(seg["start_s"]))
                    end = min(float(seg["end_s"]), total / rate)
                    if end - start < 0.3:       # too short to transcribe (noise)
                        continue
                    wf.setpos(int(start * rate))
                    frames = wf.readframes(int((end - start) * rate))
                    tmp = tempfile.NamedTemporaryFile(
                        prefix="dictee-meeting-seg-", suffix=".wav", delete=False)
                    try:
                        with _wave.open(tmp, "wb") as out:
                            out.setnchannels(channels)
                            out.setsampwidth(width)
                            out.setframerate(rate)
                            out.writeframes(frames)
                        tmp.close()
                        s = _sock.socket(_sock.AF_UNIX, _sock.SOCK_STREAM)
                        s.settimeout(60)
                        s.connect(self._nemotron_sock)
                        s.sendall((tmp.name + "\n").encode("utf-8"))
                        data = b""
                        while True:
                            buf = s.recv(4096)
                            if not buf:
                                break
                            data += buf
                        s.close()
                        text = data.decode("utf-8", errors="replace").strip()
                    finally:
                        try:
                            os.unlink(tmp.name)
                        except OSError:
                            pass
                    if text.startswith("ERROR:"):
                        self.error.emit(chunk_id, f"Nemotron live: {text}")
                        continue
                    if text:
                        lines.append({
                            "speaker": seg["speaker_id"],
                            "text": text,
                            "start_s": start + offset,
                            "end_s": end + offset,
                        })
        except (ConnectionRefusedError, OSError, _wave.Error) as e:
            self.error.emit(chunk_id, f"Nemotron live: {e}")
        self.aligned_direct.emit(chunk_id, lines)


class DiarizationWorker(QObject):
    """Keeps diarize-only --stream alive and sends chunks via stdin.

    Emits (chunk_id, segments) where segments = [{"start_s", "end_s", "speaker_id"}, ...]
    Sortformer state is preserved between chunks → stable speaker IDs.
    """

    diarized = pyqtSignal(int, list)
    error = pyqtSignal(int, str)
    ready = pyqtSignal()           # emitted once Sortformer has finished loading

    def __init__(self):
        super().__init__()
        self.proc = None
        # One persistent stdin/stdout pipe shared by the executor's workers:
        # serialize diarize() calls so two chunks can't interleave their
        # request+response (which mis-attributes segments to the wrong chunk).
        self._lock = threading.Lock()

    def start(self) -> bool:
        """Launch diarize-only --stream WITHOUT blocking the caller. The model
        load (a few seconds of Sortformer/ONNX + CUDA init) is awaited on a
        background thread that emits `ready` (or `error`). The first live chunk
        only arrives at chunk_duration (~40 s), so the model has ample time to
        load. Returns True if the process spawned, False on spawn failure."""
        try:
            self.proc = subprocess.Popen(
                ["diarize-only", "--stream"],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
                env=_build_subprocess_env(),
            )
        except FileNotFoundError:
            self.error.emit(0, "diarize-only binary not found. Sortformer feature built?")
            return False
        threading.Thread(target=self._await_ready, daemon=True).start()
        return True

    def _await_ready(self):
        """Background: wait for the 'ready' line on stderr, then keep draining
        stderr so its pipe never fills and blocks the daemon."""
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            line = self.proc.stderr.readline()
            if not line:
                self.error.emit(0, "diarize-only --stream stderr EOF before ready")
                return
            if "ready" in line:
                self.ready.emit()
                break
        else:
            self.error.emit(0, "diarize-only --stream startup timeout (30s)")
            return
        try:
            for _ in self.proc.stderr:   # drain (discard) until the proc exits
                pass
        except Exception:
            pass

    def diarize(self, chunk_id: int, chunk_path: str):
        if not self.proc:
            self.error.emit(chunk_id, "DiarizationWorker not started")
            return
        if self.proc.poll() is not None:
            self.error.emit(chunk_id, f"diarize-only exited with code {self.proc.returncode}")
            return
        try:
            with self._lock:
                self.proc.stdin.write(f"FILE: {chunk_path}\n")
                self.proc.stdin.flush()
                self._collect_response(chunk_id)
        except BrokenPipeError:
            self.error.emit(chunk_id, "diarize-only stdin pipe broken")

    def _collect_response(self, chunk_id: int):
        segments = []
        while True:
            line = self.proc.stdout.readline()
            if not line:
                self.error.emit(chunk_id, "diarize-only stdout EOF unexpected")
                return
            line = line.rstrip("\n")
            if line == "":
                self.diarized.emit(chunk_id, segments)
                return
            if line.startswith("ERROR:"):
                self.error.emit(chunk_id, line)
                return
            parts = line.split()
            if len(parts) == 3:
                try:
                    segments.append({
                        "start_s": float(parts[0]),
                        "end_s": float(parts[1]),
                        "speaker_id": int(parts[2]),
                    })
                except ValueError:
                    self.error.emit(chunk_id, f"malformed segment line: {line}")
                    return

    def stop(self):
        if self.proc:
            try:
                if self.proc.stdin and not self.proc.stdin.closed:
                    self.proc.stdin.close()
                self.proc.wait(timeout=5)
            except (subprocess.TimeoutExpired, BrokenPipeError):
                self.proc.kill()
                self.proc.wait()
            self.proc = None


class AlignerWorker(QObject):
    """Aligns Parakeet tokens with Sortformer segments by timestamp overlap.

    For each token, picks the speaker with maximum overlap on [token.start_s, token.end_s].
    Consecutive tokens with the same speaker are grouped into one line.
    Local chunk timestamps are offset to absolute meeting timestamps via chunk_offset.

    Emits aligned(chunk_id, lines) where:
      lines = [{"speaker": int, "text": str, "start_s": float, "end_s": float}, ...]
    """

    aligned = pyqtSignal(int, list)

    def __init__(self):
        super().__init__()
        self.chunk_offset = {}      # chunk_id → absolute offset in seconds
        self._transcription = {}    # chunk_id → tokens
        self._diarization = {}      # chunk_id → segments

    def on_transcribed(self, chunk_id: int, tokens: list):
        self._transcription[chunk_id] = tokens
        self._try_align(chunk_id)

    def on_diarized(self, chunk_id: int, segments: list):
        self._diarization[chunk_id] = segments
        self._try_align(chunk_id)

    def _try_align(self, chunk_id: int):
        if chunk_id not in self._transcription or chunk_id not in self._diarization:
            return
        tokens = self._transcription.pop(chunk_id)
        segments = self._diarization.pop(chunk_id)
        offset = self.chunk_offset.get(chunk_id, 0.0)

        lines = []
        current_speaker = None
        current_text = []
        current_start = None
        current_end = None

        for tok in tokens:
            spk = self._find_speaker(tok["start_s"], tok["end_s"], segments)
            if spk != current_speaker:
                if current_speaker is not None:
                    lines.append({
                        "speaker": current_speaker,
                        "text": " ".join(current_text).strip(),
                        "start_s": current_start + offset,
                        "end_s": current_end + offset,
                    })
                current_speaker = spk
                current_text = [tok["text"]]
                current_start = tok["start_s"]
            else:
                current_text.append(tok["text"])
            current_end = tok["end_s"]

        if current_speaker is not None:
            lines.append({
                "speaker": current_speaker,
                "text": " ".join(current_text).strip(),
                "start_s": current_start + offset,
                "end_s": current_end + offset,
            })

        self.aligned.emit(chunk_id, lines)

    @staticmethod
    def _find_speaker(tok_start: float, tok_end: float, segments: list) -> int:
        best_spk = -1
        best_overlap = 0.0
        for seg in segments:
            overlap = max(0.0, min(tok_end, seg["end_s"]) - max(tok_start, seg["start_s"]))
            if overlap > best_overlap:
                best_overlap = overlap
                best_spk = seg["speaker_id"]
        return best_spk


class SourceComboBox(QComboBox):
    """Audio-source combo that re-scans the system each time its dropdown opens,
    so apps/sources that appeared after the window opened show up without
    restarting it. `refresh` rebuilds the items while preserving the selection."""

    def __init__(self, refresh):
        super().__init__()
        self._refresh = refresh

    def showPopup(self):
        try:
            self._refresh()
        except Exception:
            pass
        super().showPopup()


class SourceVolumeWatcher(QThread):
    """Emits source_changed whenever a PulseAudio/PipeWire *source* changes
    (volume/mute), via 'pactl subscribe'. Lets the 🎤 slider refresh instantly
    on an external change (plasmoid, system mixer) instead of polling."""

    source_changed = pyqtSignal()

    def __init__(self):
        super().__init__()
        self.proc = None
        self._stop = False

    def run(self):
        # 'stdbuf -oL' forces pactl to LINE-buffer its stdout — a pipe is
        # otherwise block-buffered, so events would arrive in delayed bursts
        # (the lag). bufsize=1 + iter(readline) keeps delivery line-by-line on
        # our side. Fall back to plain pactl if stdbuf is missing.
        for cmd in (["stdbuf", "-oL", "pactl", "subscribe"],
                    ["pactl", "subscribe"]):
            try:
                self.proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    text=True, bufsize=1, env=dict(os.environ, LC_ALL="C"))
                break
            except (FileNotFoundError, OSError):
                self.proc = None
        if self.proc is None:
            return
        for line in iter(self.proc.stdout.readline, ""):
            if self._stop:
                break
            # "Event 'change' on source #62" — exclude 'source-output' (its line
            # reads 'on source-output #', so 'on source #' never matches it).
            if "'change'" in line and "on source #" in line:
                self.source_changed.emit()

    def stop(self):
        self._stop = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.wait(2000)


