        self.btn_start.setFixedSize(64, 64)
        self.btn_start.setStyleSheet("font-size: 22pt;")
        self.btn_start.clicked.connect(self._on_start_pause)
        btn_row.addWidget(self.btn_start)

        self.btn_stop = QPushButton("⏹")
        self.btn_stop.setToolTip("Arrêter")
        self.btn_stop.setFixedSize(64, 64)
        self.btn_stop.setStyleSheet("font-size: 22pt;")
        self.btn_stop.setEnabled(False)
