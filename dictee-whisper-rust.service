[Unit]
Description=Whisper-Rust Transcription Daemon (ASR, whisper.cpp/Vulkan GPU)
After=network.target
Conflicts=dictee.service dictee-vosk.service dictee-canary.service dictee-whisper.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/dictee.conf
Environment=ORT_DYLIB_PATH=/usr/lib/dictee/libonnxruntime.so
Environment=DICTEE_WHISPER_GGML=%h/.local/share/dictee/whisper-rust/ggml-large-v3-q5_0.bin
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/usr/bin/transcribe-daemon --whisper
ExecStartPost=/bin/bash -c 'echo idle > /dev/shm/.dictee_state'
ExecStopPost=/bin/bash -c 'for s in dictee dictee-vosk dictee-whisper dictee-whisper-rust dictee-canary; do systemctl --user is-active --quiet "$s.service" 2>/dev/null && exit 0; done; echo offline > /dev/shm/.dictee_state'
Restart=on-failure
RestartSec=5
