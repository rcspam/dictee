[Unit]
Description=Dictee Push-to-Talk Daemon
After=dictee.service dictee-vosk.service dictee-whisper.service dictee-canary.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# dictee-ptt gains the input group by itself when the session lacks it
# (sg, or newgrp -c on Arch, which has no sg since shadow 4.20; #35).
ExecStart=/usr/bin/dictee-ptt
Restart=on-failure
RestartSec=3
EnvironmentFile=-%h/.config/dictee.conf

[Install]
WantedBy=graphical-session.target
