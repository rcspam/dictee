#!/bin/bash
set -e

# UIDs of the people logged in. The login screen (sddm, gdm, plasmalogin)
# holds a logind session too, under its own system account, with
# Class=greeter: it must not join input/docker nor get dictee's services.
_user_session_uids() {
    loginctl list-sessions --no-legend 2>/dev/null | while read -r sid uid _; do
        [ "$(loginctl show-session "$sid" -p Class --value 2>/dev/null)" = "user" ] && echo "$uid"
    done | sort -u
}

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Stop and disable all user services
    for uid in $(_user_session_uids); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [ "$user" = "root" ] && continue
        [ -d "/run/user/$uid" ] || continue
        _run="sudo -u $user XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus"
        $_run systemctl --user stop dictee-ptt dictee-tray dotoold dictee dictee-vosk dictee-whisper dictee-canary 2>/dev/null || true
        $_run systemctl --user disable dictee-ptt dictee-tray dotoold dictee dictee-vosk dictee-whisper dictee-canary 2>/dev/null || true
        $_run systemctl --user daemon-reload 2>/dev/null || true
    done

    # Locales ship inside the package, so dpkg removes them on its own. Doing it
    # here too would wipe the files the OTHER variant just installed when
    # switching dictee-cpu <-> dictee-cuda (both own the same paths).

    # Reload udev rules
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger /dev/uinput 2>/dev/null || true

    # Remove venv Python (text2num) — créé au postinst, pas tracké par dpkg
    rm -rf /usr/share/dictee/postprocess-env

    # Remove venv CUDA (nvidia-*-cu12 wheels) — créé au postinst de dictee-cuda
    rm -rf /opt/dictee/cuda-venv
    # Clean up dangling symlinks in /usr/lib/dictee/ (pointing to the removed venv)
    if [ -d /usr/lib/dictee ]; then
        find /usr/lib/dictee -maxdepth 1 -type l ! -exec test -e '{}' \; -delete 2>/dev/null || true
    fi
    # Remove empty /opt/dictee if we created it
    rmdir /opt/dictee 2>/dev/null || true
fi

exit 0
