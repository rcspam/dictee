def _env_true(var):
    return os.environ.get(var, "false").lower() in ("1", "true", "yes")


def _load_pp():
    """Import dictee-postprocess in-process (NEVER a subprocess per unit).

    Two candidates are tried in order:
    1. dictee_postprocess.py sibling (dev tree: spec_from_file_location works).
    2. /usr/bin/dictee-postprocess (installed: no .py extension, so
       spec_from_file_location returns None — use SourceFileLoader directly).
    """
    here = os.path.dirname(os.path.realpath(__file__))
    for cand in (os.path.join(here, "dictee_postprocess.py"),
                 "/usr/bin/dictee-postprocess"):
        if not os.path.exists(cand):
            continue
        # spec_from_file_location fails on extension-less paths (returns None).
        # Use SourceFileLoader for those to get a valid spec regardless.
        spec = importlib.util.spec_from_file_location("dictee_postprocess", cand)
        if spec is None:
            loader = importlib.machinery.SourceFileLoader("dictee_postprocess", cand)
            spec = importlib.util.spec_from_loader("dictee_postprocess", loader,
                                                   origin=cand)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    raise SystemExit("dictee-stream: cannot locate dictee-postprocess")


def _active_window():
    """Best-effort focused-window id for the rewrite focus-guard."""
    for cmd in (["kdotool", "getactivewindow"], ["xdotool", "getactivewindow"]):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=1)
            if out.returncode == 0:
                return out.stdout.strip()
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
    return None


def _rms_s16(data: bytes):
    a = array.array("h")
    a.frombytes(data[: len(data) // 2 * 2])
    if not a:
        return 0.0
    return math.sqrt(sum(x * x for x in a) / len(a)) / 32768.0


_LAST_WORD_FILE = f"/dev/shm/.dictee_last_word-{os.getuid()}"


def _build_keyword_matchers(aliases_str):
    """Build (full_match_regex, prefix_possible_fn) for the continuation
    voice keyword ("minuscule", aliases comma-separated — mirror of the
    bash _CONT_KEYWORD_REGEXES build, dictee:384-403: spaces/hyphens become
    [- ]?, an ASR plural 's' and a trailing [.,] are tolerated)."""
    aliases = [a.strip().lower() for a in aliases_str.split(",") if a.strip()]
    parts = []
    for a in aliases:
        kw = re.escape(a).replace(r"\ ", "[- ]?").replace(r"\-", "[- ]?")
        parts.append(kw)
    full = re.compile(r"^(?:" + "|".join(parts) + r")s?[.,]?\s*", re.IGNORECASE)

    def prefix_possible(text):
        t = text.lower()
        for a in aliases:
            if a.startswith(t) or t == a or t == a + "s":
                return True
        return False

    return full, prefix_possible


def _resolve_keyword(lang, pp_mod):
    """Resolve the continuation keyword aliases like the bash does
    (dictee:368-380): [keyword:LANG] then [keyword], user file first then
    system file, default 'minuscule'."""
    files = [pp_mod.USER_CONT] + list(pp_mod.SYSTEM_CONT_CANDIDATES)
    for tag in (f"[keyword:{lang}]", "[keyword]"):
        for path in files:
            try:
                with open(path, encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith(tag):
                            return line[len(tag):].strip() or "minuscule"
            except OSError:
                continue
    return "minuscule"


def _indicator_decision(entry, closed_class_words, indicator):
    """Decide whether to show the continuation indicator at push end.

    Mirror of the bash save_last_word tail (dictee:666-694): when the push
    ends on '.N' or '_' with a closed-class last word, the displayed
    punctuation is erased (N keystrokes) and the indicator is typed in its
    place; the saved marker becomes H<len>_ so the next push erases the
    indicator. Returns (erase_n, indicator, new_entry) or None."""
    marker, _, last_word = entry.partition(":")
    if not indicator or last_word.lower() not in closed_class_words:
        return None
    if marker.startswith("."):
        try:
            erase = int(marker[1:] or "1")
        except ValueError:
            erase = 1
        return (erase, indicator, f"H{len(indicator)}_:{last_word}")
    if marker == "_":
        return (0, indicator, f"H{len(indicator)}_:{last_word}")
    return None


def _parse_continuation_marker(saved, closed_class_words):
    """Decode a LAST_WORD_FILE entry ("marker:last_word") into the actions
    for the start of this push: (pre_backspaces, lead, lowercase_first).

    Mirror of the bash apply_continuation marker semantics (dictee:396+):
      ","  -> space + lowercase
      ".N" -> if the previous push's last word is closed-class, erase the
              period (N backspaces) and continue lowercase; else space +
              keep case (new sentence)
      "F"  -> space + keep case (sentence ended with ! ? ; : » ...)
      "_"  -> space + lowercase (mid-sentence)
      "H<n>" prefix: a continuation indicator of n chars was typed by the
      batch path — erase it first.
    (Refinements not mirrored: keepcaps vocative exception, the "minuscule"
    voice-command keyword — batch-only for now.)
    """
    pre_bs = 0
    marker, _, last_word = saved.partition(":")
    m = re.match(r"^H(\d+)(.*)$", marker)
    if m:
        pre_bs += int(m.group(1))
        marker = m.group(2)
    if marker == ",":
        return (pre_bs, " ", True)
    if marker.startswith("."):
        if last_word.lower() in closed_class_words:
            try:
                pre_bs += int(marker[1:] or "1")
            except ValueError:
                pre_bs += 1
            return (pre_bs, " ", True)
        return (pre_bs, " ", False)
    if marker == "F":
        return (pre_bs, " ", False)
    # "_" or anything unknown: mid-sentence continuation
    return (pre_bs, " ", True)


def _continuation_marker_for(text, lang):
    """Encode the end of this push as a LAST_WORD_FILE entry, mirroring the
    bash save_last_word format (dictee:594+). Returns "marker:last_word" or
    None (text containing a newline: pushes stay independent).
    text is the post-sanitize typed text (what is on screen)."""
    if "\n" in text:
        return None
    trimmed = text.rstrip(" ")
    if not trimmed:
        return None
    if trimmed.endswith("..."):
        marker, stripped = ".3", trimmed[:-3]
    elif trimmed.endswith(".."):
        marker, stripped = ".2", trimmed[:-2]
    else:
        last_char, stripped = trimmed[-1], trimmed[:-1]
        if last_char == ".":
            marker = ".1"
        elif last_char == ",":
            marker = ","
        elif last_char == "?":
            # French typography types an (N)NBSP before ? -> 2 backspaces
            marker = ".2" if lang == "fr" else ".1"
        elif last_char == "!":
            marker = ".2" if lang == "fr" else "F"
        elif last_char in ";:»)":
            marker = "F"
        else:
            marker, stripped = "_", trimmed
    if marker != "_":
        stripped = stripped.rstrip(" ")
    last_word = stripped.rsplit(" ", 1)[-1] if stripped else ""
    if "-" in last_word:
        last_word = last_word.rsplit("-", 1)[-1]
    if last_word or marker != "_":
        return f"{marker}:{last_word}"
    return None


def _with_lead_of(typed, new_text):
    """Re-apply the cross-push leading whitespace to a final rewrite.

    The end-of-push transforms (fix_short_text, the full final pass) work
    on stripped text, but `typed` may start with the separator space that
    detaches us from the previous push — losing it glues the rewritten
    text to the previous sentence."""
    lead_ws = typed[:len(typed) - len(typed.lstrip(" "))]
    if lead_ws and not new_text.startswith(" "):
        return lead_ws + new_text
    return new_text


def _translate_via_dictee(text):
    """Final-pass translation reuses dictee's translate() via a thin subcommand."""
    try:
        out = subprocess.run(["dictee", "--pp-translate"], input=text.encode(),
                             capture_output=True, timeout=30)
        return out.stdout.decode("utf-8", "replace").rstrip("\n") or text
    except (OSError, subprocess.TimeoutExpired):
        return text


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def _main(argv):
    ap = argparse.ArgumentParser()
    ap.add_argument("--socket", required=True)
    ap.add_argument("--lang", default=None)
    ap.add_argument("--source", default=None,
                    help="pw-record --target (mic node or app-capture node id)")
    ap.add_argument("--granularity",
                    choices=("sentence", "word", "live"),
                    default=os.environ.get("DICTEE_STREAMING_GRANULARITY", "live"))
    ap.add_argument("--final-pass", action="store_true",
                    default=_env_true("DICTEE_STREAMING_FINAL_PASS"))
    ap.add_argument("--pause-ms", type=int,
                    default=int(os.environ.get("DICTEE_STREAMING_PAUSE_MS", "700")))
    args = ap.parse_args(argv)
    if args.granularity == "word":
        args.granularity = "live"  # legacy conf value: word mode became live

    pp = _load_pp()
    seg = Segmenter(granularity=args.granularity)

    # Cross-push continuation: the batch path records how the previous push
    # ended in LAST_WORD_FILE; honor it (leading space, lowercase start,
    # possibly erase the previous period after a closed-class word) and
    # write our own entry at the end so the NEXT push continues correctly.
    closed_words = {w.lower() for w in pp.load_continuation()}
    cont_pre_bs, cont_lead, cont_lower = 0, "", False
    saved_entry = ""
    try:
        with open(_LAST_WORD_FILE, encoding="utf-8") as f:
            saved_entry = f.read().strip()
        if saved_entry:
            cont_pre_bs, cont_lead, cont_lower = _parse_continuation_marker(
                saved_entry, closed_words)
    except OSError:
        pass
    pending_pre_bs = [cont_pre_bs]

    lang2 = (args.lang or os.environ.get("DICTEE_LANG_SOURCE", "") or "fr")[:2]

    def _on_keyword():
        """The push starts with the continuation keyword: erase the previous
        push's punctuation/indicator regardless of the closed-class check
        (mirror of the bash keyword branch, dictee:473-491)."""
        marker = saved_entry.partition(":")[0]
        m = re.match(r"^H(\d+)(.*)$", marker)
        hold = int(m.group(1)) if m else 0
        base = m.group(2) if m else marker
        if base.startswith("."):
            try:
                bs = int(base[1:] or "1")
            except ValueError:
                bs = 1
        elif base in (",", "F"):
            bs = 1
        else:
            bs = 0
        pending_pre_bs[0] = hold + bs  # replaces the normal-path decision

    composer = (LiveComposer(lambda t: pp.run_pipeline(t, local_only=True),
                             lead=cont_lead, continuation=cont_lower,
                             keyword=(_resolve_keyword(lang2, pp)
                                      if saved_entry else None),
                             on_keyword=_on_keyword,
                             closed_words=closed_words,
                             fr_typography=(lang2 == "fr" and pp._env_bool(
                                 "DICTEE_PP_TYPOGRAPHY")))
                if args.granularity == "live" else None)
    typist = Typist()
    # Warm up the virtual keyboard now: uinput device registration by the
    # compositor costs hundreds of ms, better paid during setup than on the
    # first word.
    typist._dotool("")
    client = StreamClient(args.socket, lang=args.lang)

    # Fix E: queue declared before the audio-thread closure that captures it.
    frag_q = queue.Queue()

    stop = threading.Event()
    aborted = [False]
    last_voice = [time.monotonic()]
    last_text = [time.monotonic()]  # text-side activity (live pause boundary)
    sentence_start = [not cont_lower]
    # Focus guard reference: captured at the FIRST keystroke, not at process
    # start — during startup the OSD/notification may briefly hold the
    # (X)focus, which made the end-of-push rewrites silently skip.
    start_window = [None]
    first_typing_done = [False]

    def _consume_pre_backspaces():
        """Erase the previous push's trailing punctuation/indicator (raw
        keystrokes, outside `typed` accounting — that text belongs to the
        previous push). Runs once, just before the first real typing."""
        if not first_typing_done[0]:
            first_typing_done[0] = True
            start_window[0] = _active_window()
        if pending_pre_bs[0] > 0:
            typist._dotool("key backspace\n" * pending_pre_bs[0])
            pending_pre_bs[0] = 0

    def _focus_unchanged(context):
        """Focus guard for end-of-push rewrites: best effort, permissive on
        missing data (no tool, or no reference captured), and LOUD when it
        actually blocks — a silently skipped rewrite looks like a PP bug."""
        if start_window[0] is None:
            return True
        now = _active_window()
        if now is None or now == start_window[0]:
            return True
        sys.stderr.write(
            f"dictee-stream: focus changed ({start_window[0]} -> {now}), "
            f"skipping {context}\n")
        return False

    def _on_term(_sig, _frame):
        stop.set()

    def _on_abort(_sig, _frame):
        aborted[0] = True
        stop.set()

    signal.signal(signal.SIGTERM, _on_term)
    signal.signal(signal.SIGINT, _on_term)
    signal.signal(signal.SIGUSR1, _on_abort)

    rec_cmd = ["pw-record", "--rate=16000", "--channels=1", "--format=s16"]
    if args.source:
        rec_cmd += ["--target", args.source]
    rec_cmd.append("-")
    try:
        rec = subprocess.Popen(rec_cmd, stdout=subprocess.PIPE)
    except FileNotFoundError:
        raise SystemExit("dictee-stream: pw-record not found (pipewire required)")

    def _feed_audio():
        rms_thresh = float(os.environ.get("DICTEE_SILENCE_RMS", "0.03"))
        mic_eof = False
        try:
            while not stop.is_set():
                data = rec.stdout.read(3200)  # 100 ms @16k mono s16
                if not data:
                    mic_eof = True
                    break
                client.send_audio(data)
                if _rms_s16(data) > rms_thresh:
                    last_voice[0] = time.monotonic()
            # Key-up: the recorder pipe still holds the last captured audio
            # (the words spoken right before the key release). Drain it fully
            # before the sentinel or those words are lost. The finaliser
            # terminates pw-record, so EOF arrives promptly; cap at ~10 s of
            # audio as a safety bound.
            if not mic_eof and not aborted[0]:
                for _ in range(100):
                    data = rec.stdout.read(3200)
                    if not data:
                        break
                    client.send_audio(data)
        except OSError:
            pass
        # Put the marker BEFORE sending the sentinel so that it is impossible
        # for any post-sentinel network frame (flush fragment or final
        # transcript) to appear in the queue before this marker.
        frag_q.put(_SENTINEL_SENT)
        try:
            client.send_sentinel()
        except OSError:
            pass
        # Wake the main loop promptly on mic-EOF (e.g. fake mic file ending).
        if mic_eof and not stop.is_set():
            stop.set()

    audio_t = threading.Thread(target=_feed_audio, daemon=True)
    audio_t.start()

    def _read_loop():
        # Fix C: guard against daemon crash / socket close mid-session so the
        # main loop is woken promptly instead of spinning or producing traceback.
        try:
            while True:
                frag = client.read_fragment()
                frag_q.put(frag)
                if frag is None:
                    break
        except OSError:
            frag_q.put(None)

    reader_t = threading.Thread(target=_read_loop, daemon=True)
    reader_t.start()

    def _commit(unit):
        processed = pp.run_pipeline(unit, local_only=True)
        if not processed:
            return
        if not sentence_start[0]:
            processed = processed[:1].lower() + processed[1:]
        _consume_pre_backspaces()
        typist.type_text((" " if typist.typed_len else cont_lead) + processed)
        sentence_start[0] = bool(_SENT_END.search(processed[-1:]))

    def _feed(frag):
        if composer is not None:
            # Live: the composer owns the full target text; rewrite() only
            # touches what actually changed (frozen sentences never flicker).
            target = composer.feed(frag)
            if target:
                _consume_pre_backspaces()
                typist.rewrite(target)
        else:
            for sentence in seg.feed(frag):
                _commit(sentence)

    eof = False
    while not stop.is_set():
        try:
            frag = frag_q.get(timeout=0.1)
        except queue.Empty:
            frag = ""
        if frag is _SENTINEL_SENT:
            # Audio sentinel was sent; everything remaining in the queue is
            # post-sentinel (flush fragments + final transcript).  Stop feeding
            # and let the finalisation drain handle them.
            break
        if frag is None:
            eof = True
            break
        if frag:
            _feed(frag)
            last_text[0] = time.monotonic()
        if composer is not None:
            # Live pause boundary is TEXT-side (no new ASR output for a
            # while): freezing the tail costs no typing and shrinks the
            # rewrite window. Mic RMS would race the ASR latency.
            if (time.monotonic() - last_text[0]) * 1000 > args.pause_ms:
                composer.promote()
        elif (time.monotonic() - last_voice[0]) * 1000 > args.pause_ms:
            for unit in seg.flush():
                _commit(unit)

    stop.set()
    # Terminate the recorder BEFORE joining the audio thread: the thread may
    # be blocked in rec.stdout.read() (stalled audio device); killing
    # pw-record closes the pipe, the read returns EOF, and the thread can
    # send the end-of-stream sentinel within the join window.
    rec.terminate()
    audio_t.join(timeout=2)

    # Fix A (1): SIGUSR1 abort check — bail immediately after recorder teardown,
    # before draining, typing fragments, or rewriting anything.
    if aborted[0]:
        typist.close()
        client.close()
        return 0

    msgs = []
    while not eof:
        # Fix A (2): re-check abort at the top of each drain-loop iteration.
        if aborted[0]:
            client.close()
            return 0
        try:
            m = frag_q.get(timeout=5)
        except queue.Empty:
            break
        if m is _SENTINEL_SENT:
            # Marker arrived here instead of in the main loop (SIGTERM fired
            # before the audio thread enqueued it).  Skip it and keep draining.
            continue
        if m is None:
            break
        msgs.append(m)

    # Fix A (3): re-check abort before feeding flush fragments / seg.flush() commits.
    if aborted[0]:
        typist.close()
        client.close()
        return 0

    final_text = msgs[-1] if msgs else ""
    for frag in msgs[:-1]:
        _feed(frag)
    if composer is not None:
        # Force a last render: if the whole push was held as a possible
        # keyword prefix (user said just "minus…"), type it now.
        composer._kw_active = False
        target = composer.target()
        if target:
            _consume_pre_backspaces()
            typist.rewrite(target)
    else:
        for unit in seg.flush():
            _commit(unit)

    if args.final_pass and final_text.strip():
        # Fix A (4): re-check abort before final-pass rewrite block.
        if aborted[0]:
            client.close()
            return 0
        full = pp.run_pipeline(final_text, local_only=False)
        if _env_true("DICTEE_TRANSLATE"):
            full = _translate_via_dictee(full)
        full = _with_lead_of(typist.typed, typist.sanitize(full))
        if full != typist.typed and _focus_unchanged("final rewrite"):
            typist.rewrite(full)
    elif typist.typed.strip():
        # Fix A (5): re-check abort before short_text fixup rewrite block.
        if aborted[0]:
            client.close()
            return 0
        if pp._env_bool("DICTEE_PP_SHORT_TEXT"):
            _kc_on = pp._env_bool("DICTEE_PP_KEEPCAPS")
            _kc = pp.load_keepcaps() if _kc_on else None
            _ext = pp._env_bool("DICTEE_PP_KEEPCAPS_EXTENDED") if _kc_on else False
            fixed = pp.fix_short_text(typist.typed, keepcaps=_kc, extended=_ext)
            fixed = _with_lead_of(typist.typed, typist.sanitize(fixed))
            if fixed != typist.typed and _focus_unchanged("short-text fixup"):
                typist.rewrite(fixed)

    # Record how this push ended so the NEXT push (batch or streaming)
    # continues correctly (same file/format as the bash save_last_word).
    if typist.typed.strip():
        entry = _continuation_marker_for(typist.typed, lang2)
        # \x02 = explicit end-of-sentence ("point final" voice command):
        # marker becomes F and the indicator is suppressed (mirror of the
        # bash force_end). The marker byte survives in the composer's text
        # (it is only stripped at typing time).
        force_end = composer is not None and "\x02" in (
            composer.stable + composer.raw_tail)
        if entry and force_end:
            entry = "F:" + entry.partition(":")[2]
        elif entry:
            d = _indicator_decision(
                entry, closed_words,
                os.environ.get("DICTEE_CONTINUATION_INDICATOR", ">>"))
            if d:
                erase_n, indicator, entry = d
                # Replace the displayed punctuation with the indicator so
                # the user SEES the pending continuation (bash parity).
                typist.backspace(erase_n)
                typist.type_text(indicator)
        try:
            if entry:
                with open(_LAST_WORD_FILE, "w", encoding="utf-8") as f:
                    f.write(entry + "\n")
            elif os.path.exists(_LAST_WORD_FILE):
                os.unlink(_LAST_WORD_FILE)  # \n in text: pushes independent
        except OSError:
            pass

    typist.close()
    client.close()
    # Fix E: avoid zombie — wait instead of a second terminate().
    try:
        rec.wait(timeout=1)
    except subprocess.TimeoutExpired:
        rec.kill()
    return 0


if __name__ == "__main__":
    sys.exit(_main(sys.argv[1:]))
