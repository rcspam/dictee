#!/usr/bin/env python3
"""dictee-stream — streaming dictation orchestrator.

Spawned by the dictee shell at key-down (F9). Captures the microphone via
pw-record, streams raw s16le PCM to the Nemotron daemon in stream mode,
segments the append-only text into words or sentences, applies local
post-processing in-process, types incrementally via dotool, and finalises
on SIGTERM (key-up).

Signals:
  SIGTERM / SIGINT  — key-up: drain, optional final pass, type, exit.
  SIGUSR1           — cancel: stop immediately, type NOTHING more.

Settings read from environment (set by the dictee shell wrapper):
  DICTEE_STREAMING_GRANULARITY  sentence (default) | word
  DICTEE_STREAMING_FINAL_PASS   true | false
  DICTEE_STREAMING_PAUSE_MS     default 700
  DICTEE_SILENCE_RMS            default 0.03
  DICTEE_TRANSLATE              true | false
"""

import argparse
import array
import importlib.machinery
import importlib.util
import math
import os
import queue
import re
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

# Terminal punctuation that closes a sentence (Nemotron punctuates natively).
_SENT_END = re.compile(r"[.!?…]")

# Queue sentinel: marks the point at which the audio sentinel was sent to the
# daemon.  Any network frame arriving after this marker is post-sentinel
# (flush fragment or full final transcript) and must NOT be fed to the
# segmenter inside the main loop.
_SENTINEL_SENT = object()

# ---------------------------------------------------------------------------
# Typist
# ---------------------------------------------------------------------------

# dotool cannot type these; map to safe equivalents (mirror of dictee:246-256).
_DOTOOL_SUBST = {
    " ": " ",   # NBSP (U+00A0) -> space
    " ": " ",   # narrow NBSP (U+202F) -> space
    "…": "...",
    "—": "-",
    "–": "-",
}
# Control chars that map to key presses (mirror of dictee:265 awk: enter/tab/ctrl+j).
_KEY_SEGMENTS = {"\n": "key enter", "\t": "key tab", "\x01": "key ctrl+j"}


class Segmenter:
    """Splits the append-only ASR text stream into commit units.

    The ASR is monotone (append-only), so a word is 'stable' as soon as a
    following character arrives. Fragments already contain SentencePiece
    leading spaces, so we never inject spaces here.

    Note: the sentence split is intentionally naive (decimals like "3.14" and
    abbreviations will split early). This is acceptable because the final pass
    and the batch path correct it.
    """

    def __init__(self, granularity="sentence"):
        self.granularity = granularity
        self._buf = ""

    def feed(self, fragment):
        """Append a fragment, return the list of newly-complete units."""
        self._buf += fragment
        if self.granularity == "word":
            return self._emit_words()
        return self._emit_sentences()

    def _emit_words(self):
        parts = self._buf.split(" ")
        complete, self._buf = parts[:-1], parts[-1]
        return [w for w in complete if w]

    def _emit_sentences(self):
        out = []
        while True:
            m = _SENT_END.search(self._buf)
            if not m:
                break
            sentence = self._buf[:m.end()].strip()
            self._buf = self._buf[m.end():]
            if sentence:
                out.append(sentence)
        return out

    def flush(self):
        """Return any remaining buffered unit (soft boundary / key-up)."""
        rest = self._buf.strip()
        self._buf = ""
        return [rest] if rest else []


class Typist:
    """Incremental, append-only typing via dotool, with backspace support.

    Tracks the exact string typed since start so the final pass can rewrite
    it (backspace typed_len + retype). dry_run skips the dotool subprocess
    (tests).

    Invariant: `typed` holds exactly the post-sanitize text dotool emitted,
    so backspace counts are 1:1 with len(typed).
    """

    def __init__(self, dry_run=False):
        self.dry_run = dry_run
        self.typed = ""
        self._proc = None  # persistent dotool process (lazy)
        self._last_cmds = None  # last command batch (dry_run test capture)

    @property
    def typed_len(self):
        return len(self.typed)

    @staticmethod
    def sanitize(text):
        for bad, good in _DOTOOL_SUBST.items():
            text = text.replace(bad, good)
        # Keep the control chars that map to keys (\n, \t, \x01 = ctrl+j);
        # strip the rest. \x02 (end-of-sentence), \x03 (keepcaps), \x04
        # (audio-context reset) are batch-path bookkeeping read by
        # save_last_word — meaningless in streaming, dropped on purpose.
        return "".join(c for c in text if c in "\n\t\x01" or ord(c) >= 0x20)

    @staticmethod
    def build_commands(clean):
        """Convert sanitized text to dotool command lines."""
        cmds, buf = [], ""
        for c in clean:
            if c in _KEY_SEGMENTS:
                if buf:
                    cmds.append(f"type {buf}")
                    buf = ""
                cmds.append(_KEY_SEGMENTS[c])
            else:
                buf += c
        if buf:
            cmds.append(f"type {buf}")
        return cmds

    def _dotool_proc(self):
        """Persistent dotool process, (re)spawned lazily.

        A fresh dotool per call would create a new uinput virtual keyboard
        every time — device registration by the compositor costs hundreds of
        ms, which is paid PER WORD in word granularity. One long-lived
        process types everything for the session; dotool executes commands
        as lines arrive on stdin.
        """
        if self._proc is None or self._proc.poll() is not None:
            # `sg input -c dotool` fallback mirrors safe_dotool (dictee:221).
            # Note: this fallback only covers FileNotFoundError (dotool not on
            # PATH). Group-permission failures are expected to be prevented by
            # the dictee shell wrapper, which runs under the 'input' group.
            try:
                self._proc = subprocess.Popen(["dotool"], stdin=subprocess.PIPE)
            except FileNotFoundError:
                self._proc = subprocess.Popen(["sg", "input", "-c", "dotool"],
                                              stdin=subprocess.PIPE)
        return self._proc

    def _dotool(self, commands):
        if self.dry_run:
            self._last_cmds = commands  # captured for tests
            return
        proc = self._dotool_proc()
        try:
            proc.stdin.write(commands.encode())
            proc.stdin.flush()
        except (BrokenPipeError, OSError):
            # dotool died (e.g. uinput permission hiccup): respawn once and retry.
            self._proc = None
            proc = self._dotool_proc()
            try:
                proc.stdin.write(commands.encode())
                proc.stdin.flush()
            except (BrokenPipeError, OSError):
                sys.stderr.write("dictee-stream: dotool unavailable, dropping keystrokes\n")

    def close(self):
        """Flush and terminate the persistent dotool process."""
        if self._proc is not None:
            try:
                self._proc.stdin.close()
                self._proc.wait(timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                self._proc.kill()
            self._proc = None

    def type_text(self, text):
        clean = self.sanitize(text)
        if not clean:
            return
        cmds = self.build_commands(clean)
        self._dotool("\n".join(cmds) + "\n")
        self.typed += clean

    def backspace(self, n):
        if n <= 0:
            return
        self._dotool("key backspace\n" * n)
        self.typed = self.typed[:-n] if n <= len(self.typed) else ""

    @staticmethod
    def _common_prefix_len(a, b):
        n = min(len(a), len(b))
        i = 0
        while i < n and a[i] == b[i]:
            i += 1
        return i

    def rewrite(self, new_text):
        """Replace the typed text with new_text, minimally and fast.

        Keeps the common prefix (unchanged text never flickers), erases the
        differing tail and retypes the new one in a single zero-delay burst
        (dotool defaults are 2 ms delay + 8 ms hold PER KEY — a naive
        char-by-char rewrite of a long dictation takes seconds), then
        restores the default pacing for subsequent live typing.
        """
        clean = self.sanitize(new_text)
        keep = self._common_prefix_len(self.typed, clean)
        n_del = len(self.typed) - keep
        tail = clean[keep:]
        if n_del == 0 and not tail:
            return
        cmds = ["keydelay 0", "keyhold 0", "typedelay 0", "typehold 0"]
        cmds += ["key backspace"] * n_del
        cmds += self.build_commands(tail)
        cmds += ["keydelay 2", "keyhold 8", "typedelay 2", "typehold 8"]
        self._dotool("\n".join(cmds) + "\n")
        self.typed = self.typed[:keep] + tail


# ---------------------------------------------------------------------------
# StreamClient
# ---------------------------------------------------------------------------


def frame(payload: bytes) -> bytes:
    """4-byte big-endian length prefix + payload (matches src/stream_proto.rs)."""
    return struct.pack(">I", len(payload)) + payload


class StreamClient:
    """Connection to the daemon `stream` mode. Mirror of the Rust protocol
    in src/stream_proto.rs: framed audio out, framed text fragments in.
    After send_sentinel(), read until EOF; the last frame is the full
    transcript; EOF without frames after the sentinel = aborted session.
    """

    def __init__(self, sock_path, lang=None):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.sock.connect(sock_path)
        except OSError as e:
            raise SystemExit(
                f"dictee-stream: cannot connect to daemon socket {sock_path}: {e}"
            )
        handshake = "stream" if not lang else f"stream\tlang:{lang}"
        self.sock.sendall((handshake + "\n").encode())

    def send_audio(self, s16_bytes: bytes):
        self.sock.sendall(frame(s16_bytes))

    def send_sentinel(self):
        self.sock.sendall(frame(b""))

    def _read_exact(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                return None
            buf += chunk
        return buf

    def read_fragment(self):
        """Return the next text fragment, or None on EOF (blocking)."""
        head = self._read_exact(4)
        if head is None:
            return None
        n = struct.unpack(">I", head)[0]
        body = self._read_exact(n) if n else b""
        if body is None:
            return None
        return body.decode("utf-8", "replace")

    def close(self):
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        self.sock.close()


# ---------------------------------------------------------------------------
# Main loop helpers
# ---------------------------------------------------------------------------


def _env_true(var):
    return os.environ.get(var, "false").lower() in ("1", "true", "yes")


def _load_pp():
    """Import dictee-postprocess in-process (NEVER a subprocess per unit).

    Two candidates are tried in order:
    1. dictee_postprocess.py sibling (dev tree: spec_from_file_location works).
    2. /usr/bin/dictee-postprocess (installed: no .py extension, so
       spec_from_file_location returns None — use SourceFileLoader directly).
    """
    here = os.path.dirname(os.path.realpath(__file__))
    for cand in (os.path.join(here, "dictee_postprocess.py"),
                 "/usr/bin/dictee-postprocess"):
        if not os.path.exists(cand):
            continue
        # spec_from_file_location fails on extension-less paths (returns None).
        # Use SourceFileLoader for those to get a valid spec regardless.
        spec = importlib.util.spec_from_file_location("dictee_postprocess", cand)
        if spec is None:
            loader = importlib.machinery.SourceFileLoader("dictee_postprocess", cand)
            spec = importlib.util.spec_from_loader("dictee_postprocess", loader,
                                                   origin=cand)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    raise SystemExit("dictee-stream: cannot locate dictee-postprocess")


def _active_window():
    """Best-effort focused-window id for the rewrite focus-guard."""
    for cmd in (["kdotool", "getactivewindow"], ["xdotool", "getactivewindow"]):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=1)
            if out.returncode == 0:
                return out.stdout.strip()
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
    return None


def _rms_s16(data: bytes):
    a = array.array("h")
    a.frombytes(data[: len(data) // 2 * 2])
    if not a:
        return 0.0
    return math.sqrt(sum(x * x for x in a) / len(a)) / 32768.0


def _current_sentence_raw_len(typist):
    """Length of the raw text typed since the last sentence terminator.

    If typed ends with a terminator, treat it as part of the current sentence
    being rewritten (search for the PREVIOUS terminator in typed[:-1]).
    This way _resentence() at end-of-stream rewrites the whole last sentence.

    Note: '…' is already normalised to '...' by sanitize(), so the terminator
    set only needs '.', '!', '?' (no need for the ellipsis char itself).
    """
    tail = typist.typed
    if not tail:
        return 0
    # If the last char is a terminator, look for the previous boundary.
    if tail[-1] in ".!?":
        search_in = tail[:-1]
        idx = max((search_in.rfind(c) for c in ".!?"), default=-1)
        return len(tail) - (idx + 1)
    idx = max((tail.rfind(c) for c in ".!?"), default=-1)
    return len(tail) - (idx + 1) if idx >= 0 else len(tail)


def _translate_via_dictee(text):
    """Final-pass translation reuses dictee's translate() via a thin subcommand."""
    try:
        out = subprocess.run(["dictee", "--pp-translate"], input=text.encode(),
                             capture_output=True, timeout=30)
        return out.stdout.decode("utf-8", "replace").rstrip("\n") or text
    except (OSError, subprocess.TimeoutExpired):
        return text


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def _main(argv):
    ap = argparse.ArgumentParser()
    ap.add_argument("--socket", required=True)
    ap.add_argument("--lang", default=None)
    ap.add_argument("--source", default=None,
                    help="pw-record --target (mic node or app-capture node id)")
    ap.add_argument("--granularity",
                    choices=("sentence", "word"),
                    default=os.environ.get("DICTEE_STREAMING_GRANULARITY", "sentence"))
    ap.add_argument("--final-pass", action="store_true",
                    default=_env_true("DICTEE_STREAMING_FINAL_PASS"))
    ap.add_argument("--pause-ms", type=int,
                    default=int(os.environ.get("DICTEE_STREAMING_PAUSE_MS", "700")))
    args = ap.parse_args(argv)

    pp = _load_pp()
    seg = Segmenter(granularity=args.granularity)
    typist = Typist()
    # Warm up the virtual keyboard now: uinput device registration by the
    # compositor costs hundreds of ms, better paid during setup than on the
    # first word.
    typist._dotool("")
    client = StreamClient(args.socket, lang=args.lang)

    # Fix E: queue declared before the audio-thread closure that captures it.
    frag_q = queue.Queue()

    stop = threading.Event()
    aborted = [False]
    last_voice = [time.monotonic()]
    sentence_start = [True]
    start_window = _active_window()

    def _on_term(_sig, _frame):
        stop.set()

    def _on_abort(_sig, _frame):
        aborted[0] = True
        stop.set()

    signal.signal(signal.SIGTERM, _on_term)
    signal.signal(signal.SIGINT, _on_term)
    signal.signal(signal.SIGUSR1, _on_abort)

    rec_cmd = ["pw-record", "--rate=16000", "--channels=1", "--format=s16"]
    if args.source:
        rec_cmd += ["--target", args.source]
    rec_cmd.append("-")
    try:
        rec = subprocess.Popen(rec_cmd, stdout=subprocess.PIPE)
    except FileNotFoundError:
        raise SystemExit("dictee-stream: pw-record not found (pipewire required)")

    def _feed_audio():
        rms_thresh = float(os.environ.get("DICTEE_SILENCE_RMS", "0.03"))
        mic_eof = False
        try:
            while not stop.is_set():
                data = rec.stdout.read(3200)  # 100 ms @16k mono s16
                if not data:
                    mic_eof = True
                    break
                client.send_audio(data)
                if _rms_s16(data) > rms_thresh:
                    last_voice[0] = time.monotonic()
        except OSError:
            pass
        # Put the marker BEFORE sending the sentinel so that it is impossible
        # for any post-sentinel network frame (flush fragment or final
        # transcript) to appear in the queue before this marker.
        frag_q.put(_SENTINEL_SENT)
        try:
            client.send_sentinel()
        except OSError:
            pass
        # Wake the main loop promptly on mic-EOF (e.g. fake mic file ending).
        if mic_eof and not stop.is_set():
            stop.set()

    audio_t = threading.Thread(target=_feed_audio, daemon=True)
    audio_t.start()

    def _read_loop():
        # Fix C: guard against daemon crash / socket close mid-session so the
        # main loop is woken promptly instead of spinning or producing traceback.
        try:
            while True:
                frag = client.read_fragment()
                frag_q.put(frag)
                if frag is None:
                    break
        except OSError:
            frag_q.put(None)

    reader_t = threading.Thread(target=_read_loop, daemon=True)
    reader_t.start()

    def _commit(unit):
        if args.granularity == "word":
            typist.type_text((" " if typist.typed_len else "") + unit)
            return
        processed = pp.run_pipeline(unit, local_only=True)
        if not processed:
            return
        if not sentence_start[0]:
            processed = processed[:1].lower() + processed[1:]
        typist.type_text((" " if typist.typed_len else "") + processed)
        sentence_start[0] = bool(_SENT_END.search(processed[-1:]))

    def _resentence():
        raw_len = _current_sentence_raw_len(typist)
        if raw_len <= 0:
            return
        raw = typist.typed[-raw_len:]
        processed = pp.run_pipeline(raw.strip(), local_only=True)
        if processed and processed != raw.strip():
            # rewrite() diffs against the common prefix, so only the part of
            # the sentence the PP actually changed gets erased and retyped.
            prefix = typist.typed[:-raw_len]
            sep = " " if prefix else ""
            typist.rewrite(prefix + sep + processed)

    def _feed(frag):
        if args.granularity == "word":
            last_word = None
            for w in seg.feed(frag):
                _commit(w)
                last_word = w
            # Fix B: trigger _resentence() after committing a word that ends
            # with a terminator — the terminator is now in typed (not still in
            # the segmenter buffer), so the sentence is complete for rewriting.
            if last_word and _SENT_END.search(last_word[-1:]):
                _resentence()
        else:
            for sentence in seg.feed(frag):
                _commit(sentence)

    eof = False
    while not stop.is_set():
        try:
            frag = frag_q.get(timeout=0.1)
        except queue.Empty:
            frag = ""
        if frag is _SENTINEL_SENT:
            # Audio sentinel was sent; everything remaining in the queue is
            # post-sentinel (flush fragments + final transcript).  Stop feeding
            # and let the finalisation drain handle them.
            break
        if frag is None:
            eof = True
            break
        if frag:
            _feed(frag)
        if (time.monotonic() - last_voice[0]) * 1000 > args.pause_ms:
            for unit in seg.flush():
                _commit(unit)

    stop.set()
    # Terminate the recorder BEFORE joining the audio thread: the thread may
    # be blocked in rec.stdout.read() (stalled audio device); killing
    # pw-record closes the pipe, the read returns EOF, and the thread can
    # send the end-of-stream sentinel within the join window.
    rec.terminate()
    audio_t.join(timeout=2)

    # Fix A (1): SIGUSR1 abort check — bail immediately after recorder teardown,
    # before draining, typing fragments, or rewriting anything.
    if aborted[0]:
        typist.close()
        client.close()
        return 0

    msgs = []
    while not eof:
        # Fix A (2): re-check abort at the top of each drain-loop iteration.
        if aborted[0]:
            client.close()
            return 0
        try:
            m = frag_q.get(timeout=5)
        except queue.Empty:
            break
        if m is _SENTINEL_SENT:
            # Marker arrived here instead of in the main loop (SIGTERM fired
            # before the audio thread enqueued it).  Skip it and keep draining.
            continue
        if m is None:
            break
        msgs.append(m)

    # Fix A (3): re-check abort before feeding flush fragments / seg.flush() commits.
    if aborted[0]:
        typist.close()
        client.close()
        return 0

    final_text = msgs[-1] if msgs else ""
    for frag in msgs[:-1]:
        _feed(frag)
    for unit in seg.flush():
        _commit(unit)
    if args.granularity == "word":
        _resentence()

    if args.final_pass and final_text.strip():
        # Fix A (4): re-check abort before final-pass rewrite block.
        if aborted[0]:
            client.close()
            return 0
        full = pp.run_pipeline(final_text, local_only=False)
        if _env_true("DICTEE_TRANSLATE"):
            full = _translate_via_dictee(full)
        full = typist.sanitize(full)
        if full != typist.typed:
            if _active_window() == start_window:
                typist.rewrite(full)
            else:
                sys.stderr.write("dictee-stream: focus changed, skipping final rewrite\n")
    elif typist.typed.strip():
        # Fix A (5): re-check abort before short_text fixup rewrite block.
        if aborted[0]:
            client.close()
            return 0
        if pp._env_bool("DICTEE_PP_SHORT_TEXT"):
            _kc_on = pp._env_bool("DICTEE_PP_KEEPCAPS")
            _kc = pp.load_keepcaps() if _kc_on else None
            _ext = pp._env_bool("DICTEE_PP_KEEPCAPS_EXTENDED") if _kc_on else False
            fixed = pp.fix_short_text(typist.typed, keepcaps=_kc, extended=_ext)
            fixed = typist.sanitize(fixed)
            if fixed != typist.typed and _active_window() == start_window:
                typist.rewrite(fixed)

    typist.close()
    client.close()
    # Fix E: avoid zombie — wait instead of a second terminate().
    try:
        rec.wait(timeout=1)
    except subprocess.TimeoutExpired:
        rec.kill()
    return 0


if __name__ == "__main__":
    sys.exit(_main(sys.argv[1:]))
