#!/usr/bin/env python3
"""dictee-stream — streaming dictation orchestrator.

Spawned by the dictee shell at key-down (F9). Captures the microphone via
pw-record, streams raw s16le PCM to the Nemotron daemon in stream mode,
segments the append-only text into words or sentences, applies local
post-processing in-process, types incrementally via dotool, and finalises
on SIGTERM (key-up).

Signals:
  SIGTERM / SIGINT  — key-up: drain, optional final pass, type, exit.
  SIGUSR1           — cancel: stop immediately, type NOTHING more.

Settings read from environment (set by the dictee shell wrapper):
  DICTEE_STREAMING_GRANULARITY  sentence (default) | word
  DICTEE_STREAMING_FINAL_PASS   true | false
  DICTEE_STREAMING_PAUSE_MS     default 700
  DICTEE_SILENCE_RMS            default 0.03
  DICTEE_TRANSLATE              true | false
"""

import argparse
import array
import importlib.machinery
import importlib.util
import math
import os
import queue
import re
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

# Terminal punctuation that closes a sentence (Nemotron punctuates natively).
_SENT_END = re.compile(r"[.!?…]")

# Queue sentinel: marks the point at which the audio sentinel was sent to the
# daemon.  Any network frame arriving after this marker is post-sentinel
# (flush fragment or full final transcript) and must NOT be fed to the
# segmenter inside the main loop.
_SENTINEL_SENT = object()

# ---------------------------------------------------------------------------
# Typist
# ---------------------------------------------------------------------------

# dotool cannot type these; map to safe equivalents (mirror of dictee:246-256).
_DOTOOL_SUBST = {
    " ": " ",   # NBSP (U+00A0) -> space
    " ": " ",   # narrow NBSP (U+202F) -> space
    "…": "...",
    "—": "-",
    "–": "-",
}
# Control chars that map to key presses (mirror of dictee:265 awk: enter/tab/ctrl+j).
_KEY_SEGMENTS = {"\n": "key enter", "\t": "key tab", "\x01": "key ctrl+j"}


class Segmenter:
    """Splits the append-only ASR text stream into commit units.

    The ASR is monotone (append-only), so a word is 'stable' as soon as a
    following character arrives. Fragments already contain SentencePiece
    leading spaces, so we never inject spaces here.

    Note: the sentence split is intentionally naive (decimals like "3.14" and
    abbreviations will split early). This is acceptable because the final pass
    and the batch path correct it.
    """

    def __init__(self, granularity="sentence"):
        self.granularity = granularity
        self._buf = ""

    def feed(self, fragment):
        """Append a fragment, return the list of newly-complete units."""
        self._buf += fragment
        if self.granularity == "word":
            return self._emit_words()
        return self._emit_sentences()

    def _emit_words(self):
        parts = self._buf.split(" ")
        complete, self._buf = parts[:-1], parts[-1]
        return [w for w in complete if w]

    def _emit_sentences(self):
        out = []
        while True:
            m = _SENT_END.search(self._buf)
            if not m:
                break
            sentence = self._buf[:m.end()].strip()
            self._buf = self._buf[m.end():]
            if sentence:
                out.append(sentence)
        return out

    def flush(self):
        """Return any remaining buffered unit (soft boundary / key-up)."""
        rest = self._buf.strip()
        self._buf = ""
        return [rest] if rest else []


class LiveComposer:
    """Live granularity: completed sentences are frozen, the in-progress
    sentence is re-post-processed and re-rendered on every fragment.

    The composer owns the FULL target text; the caller renders it with
    Typist.rewrite(), whose common-prefix diff guarantees the frozen part
    never flickers — only the volatile tail (the current sentence) gets
    erased/retyped, and only where the PP actually changed it.
    """

    def __init__(self, pp_fn):
        self.pp = pp_fn          # text -> locally post-processed text
        self.stable = ""         # frozen, final text (completed sentences)
        self.raw_tail = ""       # raw ASR text of the in-progress sentence
        # True when `stable` ends mid-sentence (pause promotion): the next
        # rendered text continues that sentence and must not be capitalized.
        self.open_continuation = False

    # No separator space before these when joining stable + next unit:
    # closing punctuation produced by voice commands ("point final" -> ".")
    # and rule-emitted newlines ("à la ligne" -> "\n").
    _NO_SPACE_BEFORE = ".,;:!?…\n"
    # The PP'd tail freezes when it ends with one of these.
    _FREEZE_END = ".!?…\n"
    # Marker bytes the rules may emit (\x02 end-of-sentence, etc.); ignored
    # when testing for a terminator (Typist.sanitize strips them anyway).
    _MARKERS = "\x01\x02\x03\x04"

    def _casing(self, s):
        if self.open_continuation and s:
            return s[:1].lower() + s[1:]
        return s

    def _join(self, left, right):
        if not left:
            return right
        if right and right[0] in self._NO_SPACE_BEFORE:
            return left + right
        return left + " " + right

    def _render_tail(self):
        tail = self.raw_tail.strip()
        if not tail:
            return ""
        # Strip trailing spaces (rules like "point final" emit ". " with a
        # trailing space) but keep a trailing newline ("à la ligne").
        return self._casing(self.pp(tail) or tail).rstrip(" ")

    def feed(self, fragment):
        """Absorb a fragment, return the full target text.

        Sentence freezing happens on the POST-PROCESSED text, not the raw
        ASR text: a dictated voice command ("point final") only becomes a
        terminator after the rules ran. The whole tail freezes when its
        PP'd form ends with a terminator; internal terminators stay
        volatile (the raw<->pp position mapping is unknowable) — the PP
        handles multi-sentence blocks natively, exactly like a batch push.
        """
        self.raw_tail += fragment
        vol = self._render_tail()
        if vol:
            # Strip markers and spaces only — a trailing \n IS a terminator
            # ("à la ligne") and must stay visible to the freeze test.
            clean = "".join(c for c in vol if c not in self._MARKERS).rstrip(" ")
            if clean and clean[-1] in self._FREEZE_END:
                self.stable = self._join(self.stable, vol)
                self.raw_tail = ""
                self.open_continuation = False
                return self.stable
        return self.target(vol)

    def target(self, vol=None):
        """Full text to display right now."""
        if vol is None:
            vol = self._render_tail()
        if not vol:
            return self.stable
        return self._join(self.stable, vol)

    def promote(self):
        """Pause boundary: freeze the current volatile tail as already
        rendered; the sentence stays open (continuation casing applies to
        what follows). Costs no typing — the text is already on screen."""
        vol = self._render_tail()
        if not vol:
            return
        self.stable = self._join(self.stable, vol)
        self.raw_tail = ""
        self.open_continuation = True


class Typist:
    """Incremental, append-only typing via dotool, with backspace support.

    Tracks the exact string typed since start so the final pass can rewrite
    it (backspace typed_len + retype). dry_run skips the dotool subprocess
    (tests).

    Invariant: `typed` holds exactly the post-sanitize text dotool emitted,
    so backspace counts are 1:1 with len(typed).
    """

    def __init__(self, dry_run=False):
        self.dry_run = dry_run
        self.typed = ""
        self._proc = None  # persistent dotool process (lazy)
        self._last_cmds = None  # last command batch (dry_run test capture)

    @property
    def typed_len(self):
        return len(self.typed)

    @staticmethod
    def sanitize(text):
        for bad, good in _DOTOOL_SUBST.items():
            text = text.replace(bad, good)
        # Keep the control chars that map to keys (\n, \t, \x01 = ctrl+j);
        # strip the rest. \x02 (end-of-sentence), \x03 (keepcaps), \x04
        # (audio-context reset) are batch-path bookkeeping read by
        # save_last_word — meaningless in streaming, dropped on purpose.
        return "".join(c for c in text if c in "\n\t\x01" or ord(c) >= 0x20)

    @staticmethod
    def build_commands(clean):
        """Convert sanitized text to dotool command lines."""
        cmds, buf = [], ""
        for c in clean:
            if c in _KEY_SEGMENTS:
                if buf:
                    cmds.append(f"type {buf}")
                    buf = ""
                cmds.append(_KEY_SEGMENTS[c])
            else:
                buf += c
        if buf:
            cmds.append(f"type {buf}")
        return cmds

    def _dotool_proc(self):
        """Persistent dotool process, (re)spawned lazily.

        A fresh dotool per call would create a new uinput virtual keyboard
        every time — device registration by the compositor costs hundreds of
        ms, which is paid PER WORD in word granularity. One long-lived
        process types everything for the session; dotool executes commands
        as lines arrive on stdin.
        """
        if self._proc is None or self._proc.poll() is not None:
            # `sg input -c dotool` fallback mirrors safe_dotool (dictee:221).
            # Note: this fallback only covers FileNotFoundError (dotool not on
            # PATH). Group-permission failures are expected to be prevented by
            # the dictee shell wrapper, which runs under the 'input' group.
            try:
                self._proc = subprocess.Popen(["dotool"], stdin=subprocess.PIPE)
            except FileNotFoundError:
                self._proc = subprocess.Popen(["sg", "input", "-c", "dotool"],
                                              stdin=subprocess.PIPE)
        return self._proc

    def _dotool(self, commands):
        if self.dry_run:
            self._last_cmds = commands  # captured for tests
            return
        proc = self._dotool_proc()
        try:
            proc.stdin.write(commands.encode())
            proc.stdin.flush()
        except (BrokenPipeError, OSError):
            # dotool died (e.g. uinput permission hiccup): respawn once and retry.
            self._proc = None
            proc = self._dotool_proc()
            try:
                proc.stdin.write(commands.encode())
                proc.stdin.flush()
            except (BrokenPipeError, OSError):
                sys.stderr.write("dictee-stream: dotool unavailable, dropping keystrokes\n")

    def close(self):
        """Flush and terminate the persistent dotool process.

        Typing is asynchronous now: dotool may still be replaying queued
        keystrokes (default pacing is ~10 ms per key). Killing it early
        would swallow the end of the dictation, so wait generously — it
        exits on its own at stdin EOF once everything is typed.
        """
        if self._proc is not None:
            try:
                self._proc.stdin.close()
                self._proc.wait(timeout=15)
            except (OSError, subprocess.TimeoutExpired):
                self._proc.kill()
            self._proc = None

    def type_text(self, text):
        clean = self.sanitize(text)
        if not clean:
            return
        cmds = self.build_commands(clean)
        self._dotool("\n".join(cmds) + "\n")
        self.typed += clean

    def backspace(self, n):
        if n <= 0:
            return
        self._dotool("key backspace\n" * n)
        self.typed = self.typed[:-n] if n <= len(self.typed) else ""

    @staticmethod
    def _common_prefix_len(a, b):
        n = min(len(a), len(b))
        i = 0
        while i < n and a[i] == b[i]:
            i += 1
        return i

    def rewrite(self, new_text):
        """Replace the typed text with new_text, minimally and fast.

        Keeps the common prefix (unchanged text never flickers), erases the
        differing tail and retypes the new one in a single zero-delay burst
        (dotool defaults are 2 ms delay + 8 ms hold PER KEY — a naive
        char-by-char rewrite of a long dictation takes seconds), then
        restores the default pacing for subsequent live typing.
        """
        clean = self.sanitize(new_text)
        keep = self._common_prefix_len(self.typed, clean)
        n_del = len(self.typed) - keep
        tail = clean[keep:]
        if n_del == 0 and not tail:
            return
        # Zero-delay is safe for backspaces only (plain key, no keymap
        # change). Typing at 0 ms scrambles accented characters: dotool
        # remaps its virtual keyboard for chars absent from the layout and
        # the compositor applies that keymap asynchronously — observed as
        # "contrôle" rendering like "ôcontrle". The retype therefore runs
        # at default pacing; the prefix diff keeps it short.
        cmds = ["keydelay 0", "keyhold 0"]
        cmds += ["key backspace"] * n_del
        cmds += ["keydelay 2", "keyhold 8"]
        cmds += self.build_commands(tail)
        self._dotool("\n".join(cmds) + "\n")
        self.typed = self.typed[:keep] + tail


# ---------------------------------------------------------------------------
# StreamClient
# ---------------------------------------------------------------------------


def frame(payload: bytes) -> bytes:
    """4-byte big-endian length prefix + payload (matches src/stream_proto.rs)."""
    return struct.pack(">I", len(payload)) + payload


class StreamClient:
    """Connection to the daemon `stream` mode. Mirror of the Rust protocol
    in src/stream_proto.rs: framed audio out, framed text fragments in.
    After send_sentinel(), read until EOF; the last frame is the full
    transcript; EOF without frames after the sentinel = aborted session.
    """

    def __init__(self, sock_path, lang=None):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.sock.connect(sock_path)
        except OSError as e:
            raise SystemExit(
                f"dictee-stream: cannot connect to daemon socket {sock_path}: {e}"
            )
        handshake = "stream" if not lang else f"stream\tlang:{lang}"
        self.sock.sendall((handshake + "\n").encode())

    def send_audio(self, s16_bytes: bytes):
        self.sock.sendall(frame(s16_bytes))

    def send_sentinel(self):
        self.sock.sendall(frame(b""))

    def _read_exact(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                return None
            buf += chunk
        return buf

    def read_fragment(self):
        """Return the next text fragment, or None on EOF (blocking)."""
        head = self._read_exact(4)
        if head is None:
            return None
        n = struct.unpack(">I", head)[0]
        body = self._read_exact(n) if n else b""
        if body is None:
            return None
        return body.decode("utf-8", "replace")

    def close(self):
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        self.sock.close()


