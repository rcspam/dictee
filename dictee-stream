# Terminal punctuation that closes a sentence (Nemotron punctuates natively).
_SENT_END = re.compile(r"[.!?…]")

# Queue sentinel: marks the point at which the audio sentinel was sent to the
# daemon.  Any network frame arriving after this marker is post-sentinel
# (flush fragment or full final transcript) and must NOT be fed to the
# segmenter inside the main loop.
_SENTINEL_SENT = object()

# ---------------------------------------------------------------------------
# Typist
# ---------------------------------------------------------------------------

# dotool cannot type these; map to safe equivalents (mirror of dictee:246-256).
_DOTOOL_SUBST = {
    " ": " ",   # NBSP (U+00A0) -> space
    " ": " ",   # narrow NBSP (U+202F) -> space
    "…": "...",
    "—": "-",
    "–": "-",
}
# Control chars that map to key presses (mirror of dictee:265 awk: enter/tab/ctrl+j).
_KEY_SEGMENTS = {"\n": "key enter", "\t": "key tab", "\x01": "key ctrl+j"}

# Key pacings, calibrated 2026-06-11 on this machine (Qt sandbox + Konsole
# TUI, automated probe/verify): plain keys (backspace, arrows) are reliable
# down to 1-2 ms; text typing breaks at 0 ms (dead-key/keymap-remap race,
# "ôôcontrle" measured) but holds at 2/4. ZERO delays stay forbidden —
# drops and scrambling were measured there in both environments.
_PACE_EDIT_ON = "keydelay 1\nkeyhold 2"
_PACE_EDIT_OFF = "keydelay 2\nkeyhold 8"
_PACE_INIT = "typedelay 2\ntypehold 4\nkeydelay 2\nkeyhold 8"


class Segmenter:
    """Splits the append-only ASR text stream into commit units.

    The ASR is monotone (append-only), so a word is 'stable' as soon as a
    following character arrives. Fragments already contain SentencePiece
    leading spaces, so we never inject spaces here.

    Note: the sentence split is intentionally naive (decimals like "3.14" and
    abbreviations will split early). This is acceptable because the final pass
    and the batch path correct it.
    """

    def __init__(self, granularity="sentence"):
        self.granularity = granularity
        self._buf = ""

    def feed(self, fragment):
        """Append a fragment, return the list of newly-complete units."""
        self._buf += fragment
        if self.granularity == "word":
            return self._emit_words()
        return self._emit_sentences()

    def _emit_words(self):
        parts = self._buf.split(" ")
        complete, self._buf = parts[:-1], parts[-1]
        return [w for w in complete if w]

    def _emit_sentences(self):
        out = []
        while True:
            m = _SENT_END.search(self._buf)
            if not m:
                break
            sentence = self._buf[:m.end()].strip()
            self._buf = self._buf[m.end():]
            if sentence:
                out.append(sentence)
        return out

    def flush(self):
        """Return any remaining buffered unit (soft boundary / key-up)."""
        rest = self._buf.strip()
        self._buf = ""
        return [rest] if rest else []


class LiveComposer:
    """Live granularity: completed sentences are frozen, the in-progress
    sentence is re-post-processed and re-rendered on every fragment.

    The composer owns the FULL target text; the caller renders it with
    Typist.rewrite(), whose common-prefix diff guarantees the frozen part
    never flickers — only the volatile tail (the current sentence) gets
    erased/retyped, and only where the PP actually changed it.
    """

    def __init__(self, pp_fn, lead="", continuation=False,
                 keyword=None, on_keyword=None, closed_words=frozenset(),
                 fr_typography=False):
        self.pp = pp_fn          # text -> locally post-processed text
        self.stable = ""         # frozen, final text (completed sentences)
        self.raw_tail = ""       # raw ASR text of the in-progress sentence
        # Cross-push continuation (read from LAST_WORD_FILE): `lead` is
        # typed before the first unit (separates us from the previous
        # push's text), `continuation` starts the session mid-sentence.
        self.lead = lead
        # True when `stable` ends mid-sentence (pause promotion or
        # cross-push continuation): the next rendered text continues that
        # sentence and must not be capitalized.
        self.open_continuation = continuation
        # Continuation voice keyword ("minuscule…"): when the push STARTS
        # with it, the previous push's punctuation is erased and the text
        # continues lowercase. The keyword arrives fragment by fragment, so
        # rendering is HELD while the tail is still a possible prefix of it.
        if keyword:
            self._kw_full, self._kw_prefix = _build_keyword_matchers(keyword)
        else:
            self._kw_full, self._kw_prefix = None, None
        self._kw_active = bool(keyword)
        self._on_keyword = on_keyword
        # Closed-class words: a period right after one of these is probably
        # spurious (fix_continuation removes it once the next words arrive),
        # so the tail must NOT freeze on it.
        self._closed_words = closed_words
        # French typography: join high punctuation with the (narrow)
        # no-break space, like fix_french_typography would inside a block.
        self.fr_typography = fr_typography

    # No separator space before these when joining stable + next unit:
    # closing punctuation produced by voice commands ("point final" -> ".")
    # and rule-emitted newlines ("à la ligne" -> "\n").
    _NO_SPACE_BEFORE = ".,;:!?…\n"
    # The PP'd tail freezes when it ends with one of these.
    _FREEZE_END = ".!?…\n"
    # Marker bytes the rules may emit (\x02 end-of-sentence, etc.); ignored
    # when testing for a terminator (Typist.sanitize strips them anyway).
    _MARKERS = "\x01\x02\x03\x04"

    def _casing(self, s):
        if self.open_continuation and s:
            # Never de-capitalize an acronym (dictionary entries like "API"):
            # if the second letter is uppercase too, the word is a sigle.
            if s[1:2].isupper():
                return s
            return s[:1].lower() + s[1:]
        return s

    def _join(self, left, right):
        if right and right[0] in self._NO_SPACE_BEFORE:
            # French typography: a (narrow) no-break space before high
            # punctuation when it joins from a separate fragment — what
            # fix_french_typography does inside a block, and what the bash
            # apply_continuation does across pushes (dictee:514-520).
            if self.fr_typography and left and not left.endswith(" "):
                if right[0] in "!?;":
                    return left + " " + right
                if right[0] == ":":
                    return left + " " + right
            # Other punctuation glues leftward — even across pushes (a
            # dictated "point final" at push start attaches to the previous
            # text).
            return left + right
        if not left:
            return self.lead + right
        if left.endswith(("\n", "\t", "\x01", "\x04")):
            # No separator after a line break / tab / ctrl+j / reset marker:
            # the next text starts the new line or field directly (a space
            # there would indent the new line).
            return left + right
        return left + " " + right

    def _render_tail(self):
        tail = self.raw_tail.strip()
        if not tail:
            return ""
        # Strip trailing spaces (rules like "point final" emit ". " with a
        # trailing space) but keep a trailing newline ("à la ligne").
        return self._casing(self.pp(tail) or tail).rstrip(" ")

    def feed(self, fragment):
        """Absorb a fragment, return the full target text.

        Sentence freezing happens on the POST-PROCESSED text, not the raw
        ASR text: a dictated voice command ("point final") only becomes a
        terminator after the rules ran. The whole tail freezes when its
        PP'd form ends with a terminator; internal terminators stay
        volatile (the raw<->pp position mapping is unknowable) — the PP
        handles multi-sentence blocks natively, exactly like a batch push.
        """
        self.raw_tail += fragment
        if self._kw_active and not self.stable:
            tail = self.raw_tail.strip()
            if tail:
                m = self._kw_full.match(tail)
                if m:
                    # Keyword spoken at push start: drop it, force the
                    # continuation casing, let the caller erase the previous
                    # push's punctuation.
                    self.raw_tail = tail[m.end():]
                    self.open_continuation = True
                    self._kw_active = False
                    if self._on_keyword:
                        self._on_keyword()
                elif self._kw_prefix(tail):
                    return self.stable  # hold: could still become the keyword
                else:
                    self._kw_active = False
        # The model emits its native end-of-sequence punctuation when the
        # daemon finalizes; if the user already dictated the punctuation
        # ("point final" -> '.' frozen in stable), that native mark is a
        # duplicate ('confirmé..', 'vraiment ?.') — swallow it. A batch push
        # never shows this because the command rule eats adjacent [,.\s]*
        # within one text. Kept when stable has no trailing punctuation
        # (the native period is then a welcome bonus).
        if self.stable and self.raw_tail:
            tail_clean = "".join(
                c for c in self.raw_tail if c not in self._MARKERS).strip()
            stable_clean = "".join(
                c for c in self.stable if c not in self._MARKERS).rstrip()
            if (tail_clean and all(c in ".!?…" for c in tail_clean)
                    and stable_clean and stable_clean[-1] in ".!?…\n"):
                self.raw_tail = ""
                return self.stable

        vol = self._render_tail()
        if vol:
            # Strip markers and spaces only — a trailing \n IS a terminator
            # ("à la ligne") and must stay visible to the freeze test.
            clean = "".join(c for c in vol if c not in self._MARKERS).rstrip(" ")
            if clean and clean[-1] == "." and self._closed_words:
                # Period right after a closed-class word ("je vais le."):
                # probably spurious — fix_continuation removes it once the
                # next words arrive. Keep the tail volatile so the block
                # re-PP can do that.
                last = clean[:-1].rstrip().rsplit(" ", 1)[-1]
                if "-" in last:
                    last = last.rsplit("-", 1)[-1]
                if last.lower() in self._closed_words:
                    return self.target(vol)
            if clean and clean[-1] in self._FREEZE_END:
                self.stable = self._join(self.stable, vol)
                self.raw_tail = ""
                self.open_continuation = False
                return self.stable
        return self.target(vol)

    def target(self, vol=None):
        """Full text to display right now."""
        if vol is None:
            vol = self._render_tail()
        if not vol:
            return self.stable
        return self._join(self.stable, vol)

    def promote(self):
        """Pause boundary: freeze the current volatile tail as already
        rendered; the sentence stays open (continuation casing applies to
        what follows). Costs no typing — the text is already on screen."""
        vol = self._render_tail()
        if not vol:
            return
        self.stable = self._join(self.stable, vol)
        self.raw_tail = ""
        self.open_continuation = True


class Typist:
    """Incremental, append-only typing via dotool, with backspace support.

    Tracks the exact string typed since start so the final pass can rewrite
    it (backspace typed_len + retype). dry_run skips the dotool subprocess
    (tests).

    Invariant: `typed` holds exactly the post-sanitize text dotool emitted,
    so backspace counts are 1:1 with len(typed).
    """

    def __init__(self, dry_run=False):
        self.dry_run = dry_run
        self.typed = ""
        self._proc = None  # persistent dotool process (lazy)
        self._last_cmds = None  # last command batch (dry_run test capture)

    @property
    def typed_len(self):
        return len(self.typed)

    @staticmethod
    def sanitize(text):
        for bad, good in _DOTOOL_SUBST.items():
            text = text.replace(bad, good)
        # Keep the control chars that map to keys (\n, \t, \x01 = ctrl+j);
        # strip the rest. \x02 (end-of-sentence), \x03 (keepcaps), \x04
        # (audio-context reset) are batch-path bookkeeping read by
        # save_last_word — meaningless in streaming, dropped on purpose.
        return "".join(c for c in text if c in "\n\t\x01" or ord(c) >= 0x20)

    @staticmethod
    def build_commands(clean):
        """Convert sanitized text to dotool command lines."""
        cmds, buf = [], ""
        for c in clean:
            if c in _KEY_SEGMENTS:
                if buf:
                    cmds.append(f"type {buf}")
                    buf = ""
                cmds.append(_KEY_SEGMENTS[c])
            else:
                buf += c
        if buf:
            cmds.append(f"type {buf}")
        return cmds

    def _dotool_proc(self):
        """Persistent dotool process, (re)spawned lazily.

        A fresh dotool per call would create a new uinput virtual keyboard
        every time — device registration by the compositor costs hundreds of
        ms, which is paid PER WORD in word granularity. One long-lived
        process types everything for the session; dotool executes commands
        as lines arrive on stdin.
        """
        if self._proc is None or self._proc.poll() is not None:
            # `sg input -c dotool` fallback mirrors safe_dotool (dictee:221).
            # Note: this fallback only covers FileNotFoundError (dotool not on
            # PATH). Group-permission failures are expected to be prevented by
            # the dictee shell wrapper, which runs under the 'input' group.
            try:
                self._proc = subprocess.Popen(["dotool"], stdin=subprocess.PIPE)
            except FileNotFoundError:
                self._proc = subprocess.Popen(["sg", "input", "-c", "dotool"],
                                              stdin=subprocess.PIPE)
            # Calibrated session pacing (text at 2/4 instead of 2/8).
            try:
                self._proc.stdin.write((_PACE_INIT + "\n").encode())
                self._proc.stdin.flush()
            except (BrokenPipeError, OSError):
                pass
        return self._proc

    def _dotool(self, commands):
        if self.dry_run:
            self._last_cmds = commands  # captured for tests
            return
        proc = self._dotool_proc()
        try:
            proc.stdin.write(commands.encode())
            proc.stdin.flush()
        except (BrokenPipeError, OSError):
            # dotool died (e.g. uinput permission hiccup): respawn once and retry.
            self._proc = None
            proc = self._dotool_proc()
            try:
                proc.stdin.write(commands.encode())
                proc.stdin.flush()
            except (BrokenPipeError, OSError):
                sys.stderr.write("dictee-stream: dotool unavailable, dropping keystrokes\n")

    def close(self):
        """Flush and terminate the persistent dotool process.

        Typing is asynchronous now: dotool may still be replaying queued
        keystrokes (default pacing is ~10 ms per key). Killing it early
        would swallow the end of the dictation, so wait generously — it
        exits on its own at stdin EOF once everything is typed.
        """
        if self._proc is not None:
            try:
                self._proc.stdin.close()
                self._proc.wait(timeout=15)
            except (OSError, subprocess.TimeoutExpired):
                self._proc.kill()
            self._proc = None

    def type_text(self, text):
        clean = self.sanitize(text)
        if not clean:
            return
        cmds = self.build_commands(clean)
        self._dotool("\n".join(cmds) + "\n")
        self.typed += clean

    def backspace(self, n):
        if n <= 0:
            return
        self._dotool(_PACE_EDIT_ON + "\n"
                     + "key backspace\n" * n
                     + _PACE_EDIT_OFF + "\n")
        self.typed = self.typed[:-n] if n <= len(self.typed) else ""

    @staticmethod
    def _common_prefix_len(a, b):
        n = min(len(a), len(b))
        i = 0
        while i < n and a[i] == b[i]:
            i += 1
        return i

    @staticmethod
    def _common_suffix_len(a, b):
        n = min(len(a), len(b))
        i = 0
        while i < n and a[len(a) - 1 - i] == b[len(b) - 1 - i]:
            i += 1
        return i

    def rewrite(self, new_text):
        """Replace the typed text with new_text, minimally.

        Diffs against BOTH ends: the common prefix never flickers, and when
        the change is an island in the middle (the dominant final-pass
        case: a few corrected words inside a long dictation), the common
        suffix is preserved too — navigate left over it, edit only the
        island, come back. The cheaper of the two strategies (tail rewrite
        vs island edit) is chosen by keystroke count.

        Everything runs at dotool's default pacing: zero-delay bursts
        proved unreliable on this desktop — typed characters scrambled
        ("contrôle" → "ôcontrle", keymap-remap race for non-layout chars)
        AND backspaces were dropped (zero-hold press/release pairs get
        coalesced). Minimal diffs are what keep rewrites fast.
        """
        clean = self.sanitize(new_text)
        if clean == self.typed:
            return
        keep = self._common_prefix_len(self.typed, clean)
        old_rest = self.typed[keep:]
        new_rest = clean[keep:]
        suf = self._common_suffix_len(old_rest, new_rest)
        old_mid = old_rest[:len(old_rest) - suf]
        new_mid = new_rest[:len(new_rest) - suf]
        # Keystroke counts are mathematically EQUAL (2×suffix both ways:
        # traverse+return vs erase+retype), so the island edit wins on other
        # grounds: the preserved suffix never flickers, and arrows/backspace
        # are plain keys that a faster calibrated pacing can drive safely,
        # while retyping text (dead-key accents) must stay at safe pacing.
        cost_tail = len(old_rest) + len(new_rest)
        cost_island = suf + len(old_mid) + len(new_mid) + suf
        if suf and cost_island <= cost_tail:
            cmds = [_PACE_EDIT_ON]
            cmds += ["key left"] * suf
            cmds += ["key backspace"] * len(old_mid)
            cmds += [_PACE_EDIT_OFF]
            cmds += self.build_commands(new_mid)
            cmds += [_PACE_EDIT_ON]
            cmds += ["key right"] * suf
            cmds += [_PACE_EDIT_OFF]
        else:
            cmds = [_PACE_EDIT_ON]
            cmds += ["key backspace"] * len(old_rest)
            cmds += [_PACE_EDIT_OFF]
            cmds += self.build_commands(new_rest)
        if not cmds:
            return
        self._dotool("\n".join(cmds) + "\n")
        self.typed = clean


