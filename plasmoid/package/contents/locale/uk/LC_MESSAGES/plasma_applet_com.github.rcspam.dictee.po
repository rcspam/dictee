#: plasmoid/package/contents/ui/main.qml:454
msgid "Vosk runs on CPU by design"
msgstr "Vosk працює на CPU за задумом"

#: plasmoid/package/contents/ui/main.qml:458
msgid "Parakeet INT8 is CPU-optimized (GPU is 5× slower)"
msgstr "Parakeet INT8 оптимізований для CPU (GPU у 5× повільніший)"

#: plasmoid/package/contents/ui/main.qml:462
msgid "No NVIDIA GPU detected"
msgstr "Графічний процесор NVIDIA не виявлено"

#: plasmoid/package/contents/ui/FullRepresentation.qml:286
