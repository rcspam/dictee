#: dictee-setup.py:12756
msgid "Elisions"
msgstr "Elisiones"

#: dictee-setup.py:12759
msgid ""
"Applies French elision rules.\n"
"Example: \"le arbre\" → \"l'arbre\",\n"
"\"de eau\" → \"d'eau\""
msgstr ""
