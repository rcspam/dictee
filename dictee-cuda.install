# Arch install hook for dictee-cuda. Mirrors the postinst .deb / %post .rpm
# behaviour: creates two pip venvs (text2num for postprocess, nvidia-*-cu12
# for CUDA runtime libs), symlinks the NVIDIA .so files into /usr/lib/dictee/
# so ldconfig + ORT_DYLIB_PATH pick them up, and runs ldconfig.

_install_uinput_drop_in() {
    # The AUR `dotool` package ships /usr/lib/udev/rules.d/80-dotool.rules
    # with MODE="0620" (write-only for the input group). python-evdev opens
    # /dev/uinput with O_RDWR, which fails with that mode → dictee-ptt
    # crashes with "could not open uinput device in write mode" and the
    # PTT shortcut silently doesn't work. Drop a higher-priority override
    # in /etc/ (overrides /usr/lib/, survives pacman -S dotool upgrades).
    DROP_IN="/etc/udev/rules.d/81-dictee-uinput.rules"
    cat > "$DROP_IN" <<'RULES'
# Drop-in installed by dictee-cuda. Overrides MODE from /usr/lib/udev/rules.d/80-dotool.rules.
# python-evdev (used by dictee-ptt) opens /dev/uinput with O_RDWR, so we need
# read+write for the input group, not just write (0620).
KERNEL=="uinput", MODE="0660"
RULES
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --action=change /dev/uinput 2>/dev/null || true
}

_drop_stale_user_units() {
    # ~/.config/systemd/user wins over /usr/lib/systemd/user, so units left by a
    # previous TARBALL install silently shadow the ones this package ships — and
    # they point at /usr/local/bin, which pacman never populates. Measured here:
    # a July tarball left a unit calling /usr/local/bin/sg, dictee-ptt failed 27
    # times with 203/EXEC, and push-to-talk never worked after installing.
    for uid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $2}' | sort -u); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [ "$user" = "root" ] && continue
        home=$(getent passwd "$user" | cut -d: -f6)
        [ -d "$home/.config/systemd/user" ] || continue
        removed=0
        for unit in dictee dictee-tray dictee-ptt dotoold dictee-vosk dictee-whisper dictee-canary; do
            [ -f "$home/.config/systemd/user/$unit.service" ] || continue
            rm -f "$home/.config/systemd/user/$unit.service" && removed=$((removed + 1))
        done
        if [ "$removed" -gt 0 ]; then
            echo "✓ $removed stale tarball unit(s) removed for $user"
            sudo -u "$user" XDG_RUNTIME_DIR="/run/user/$uid" \
                DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                systemctl --user daemon-reload 2>/dev/null || true
        fi
    done
}

_restart_user_services() {
    # Same block as the .deb postinst and the .rpm %post: for every logged-in
    # user, reload the user manager, apply the presets, enable the essential
    # services, restart them so they pick up the binaries just installed, and
    # start the ASR daemon the user's dictee.conf asks for. Without it an
    # upgrade leaves the previous daemon running, and a move from a tarball
    # install to this package (whose stale units _drop_stale_user_units just
    # removed) leaves no daemon at all: tray offline, nothing transcribes.
    for uid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $2}' | sort -u); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [ "$user" = "root" ] && continue
        [ -d "/run/user/$uid" ] || continue
        _run="sudo -u $user XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus"
        $_run systemctl --user daemon-reload 2>/dev/null || true
        $_run systemctl --user preset dictee dictee-vosk dictee-whisper dictee-canary dictee-ptt dictee-tray dotoold 2>/dev/null || true
        $_run systemctl --user enable dictee-ptt dictee-tray 2>/dev/null || true
        # dotoold, dotool's daemon, is nothing dictee talks to: the text is typed
        # through the one-shot dotool. Earlier versions enabled it anyway, and
        # started right after the install it could not open /dev/uinput before the
        # next login and failed in a loop. Switch off the one they left enabled.
        # Stopped, it exits 143 (its trap ends with the status of the interrupted
        # wait), which systemd records as a failure: clear it, or the unit stays
        # "failed" and the user manager "degraded".
        $_run systemctl --user disable --now dotoold 2>/dev/null || true
        $_run systemctl --user reset-failed dotoold 2>/dev/null || true
        $_run systemctl --user restart dictee-ptt 2>/dev/null || true
        _user_home=$(getent passwd "$user" | cut -d: -f6)
        if [ -f "$_user_home/.config/dictee.conf" ]; then
            $_run systemctl --user restart dictee-tray 2>/dev/null || true
        else
            echo "  dictee-tray: waiting for configuration (dictee-setup)"
        fi
        # Start the ASR daemon the user configured, never a hardcoded one.
        _asr_backend="parakeet"
        if [ -f "$_user_home/.config/dictee.conf" ]; then
            _asr_backend=$(grep -s '^DICTEE_ASR_BACKEND=' "$_user_home/.config/dictee.conf" | cut -d= -f2)
        fi
        case "$_asr_backend" in
            vosk)    _asr_svc="dictee-vosk" ;;
            whisper) _asr_svc="dictee-whisper" ;;
            canary)  _asr_svc="dictee-canary" ;;
            *)       _asr_svc="dictee" ;;
        esac
        $_run systemctl --user stop dictee dictee-vosk dictee-whisper dictee-canary 2>/dev/null || true
        $_run systemctl --user disable dictee dictee-vosk dictee-whisper dictee-canary 2>/dev/null || true
        $_run systemctl --user enable "$_asr_svc" 2>/dev/null || true
        $_run systemctl --user start "$_asr_svc" 2>/dev/null || true
        echo "✓ services restarted for $user ($_asr_svc, backend: $_asr_backend)"
    done
}

_stop_user_services() {
    # Same as the .deb postrm: stop and disable the user services before the
    # binaries go, so nothing keeps running against deleted files.
    for uid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $2}' | sort -u); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [ "$user" = "root" ] && continue
        [ -d "/run/user/$uid" ] || continue
        _run="sudo -u $user XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus"
        $_run systemctl --user stop dictee-ptt dictee-tray dotoold dictee dictee-vosk dictee-whisper dictee-canary 2>/dev/null || true
        $_run systemctl --user disable dictee-ptt dictee-tray dotoold dictee dictee-vosk dictee-whisper dictee-canary 2>/dev/null || true
        $_run systemctl --user daemon-reload 2>/dev/null || true
    done
}

_enable_gnome_appindicator() {
    # Same as the .deb postinst and the .rpm %post: on GNOME the tray icon
    # only shows through the AppIndicator extension (install.sh installs it
    # on GNOME). Enabling is per user and needs the session bus; a desktop
    # without the extension just ignores this.
    for uid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $2}' | sort -u); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [ "$user" = "root" ] && continue
        [ -d "/run/user/$uid" ] || continue
        sudo -u "$user" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            gnome-extensions enable appindicatorsupport@rgcjonas.gmail.com 2>/dev/null \
            && echo "✓ GNOME AppIndicator extension enabled for $user" || true
    done
}

_setup_user_groups() {
    # Add logged-in users to the 'input' group (dotool / dictee-ptt
    # need /dev/uinput access) and 'docker' group when docker is
    # available (LibreTranslate runs in Docker). Mirrors postinst .deb
    # and %post .rpm so an Arch user gets the same default behaviour
    # as Debian/Ubuntu/Fedora installs.
    for uid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $2}' | sort -u); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [ "$user" = "root" ] && continue
        if ! id -nG "$user" | grep -qw input; then
            usermod -aG input "$user"
            echo "✓ $user added to group 'input' (dotool / PTT)"
        fi
        if command -v docker >/dev/null 2>&1; then
            if ! id -nG "$user" | grep -qw docker; then
                usermod -aG docker "$user"
                echo "✓ $user added to group 'docker' (LibreTranslate)"
            fi
        fi
    done
}

_install_postprocess_venv() {
    PP_VENV="/usr/share/dictee/postprocess-env"
    if command -v python3 >/dev/null 2>&1; then
        if [ ! -d "$PP_VENV" ]; then
            if python3 -m venv "$PP_VENV" 2>/dev/null; then
                "$PP_VENV/bin/pip" install --quiet --upgrade pip 2>/dev/null || true
                "$PP_VENV/bin/pip" install --quiet text2num 2>/dev/null || \
                    echo "Warning: text2num install failed (check internet)"
            fi
        fi
    fi
}

_upgrade_postprocess_venv() {
    PP_VENV="/usr/share/dictee/postprocess-env"
    if [ -d "$PP_VENV" ] && command -v python3 >/dev/null 2>&1; then
        "$PP_VENV/bin/pip" install --quiet --upgrade pip 2>/dev/null || true
        "$PP_VENV/bin/pip" install --quiet --upgrade text2num 2>/dev/null || true
    else
        _install_postprocess_venv
    fi
}

_install_cuda_venv() {
    # CUDA setup centralized in the shared script (GPU detection → right cuDNN per
    # compute_cap: Pascal/older → 9.0.0.312, Turing+ → latest; skip if no GPU).
    if [ -f /usr/lib/dictee/setup-cuda-venv.sh ]; then
        bash /usr/lib/dictee/setup-cuda-venv.sh || echo "Warning: CUDA setup incomplete."
    fi
}

post_install() {
    # Load uinput now so dotool & dictee-ptt work without a reboot.
    # /etc/modules-load.d/dictee-uinput.conf handles subsequent boots.
    modprobe uinput 2>/dev/null || true

    _install_uinput_drop_in
    _drop_stale_user_units
    _setup_user_groups
    _restart_user_services
    _enable_gnome_appindicator
    _install_postprocess_venv
    _install_cuda_venv
}

post_upgrade() {
    modprobe uinput 2>/dev/null || true

    _install_uinput_drop_in
    _drop_stale_user_units
    _setup_user_groups
    _restart_user_services
    _enable_gnome_appindicator
    _upgrade_postprocess_venv
    _install_cuda_venv
}

pre_remove() {
    _stop_user_services
    rm -rf /usr/share/dictee/postprocess-env
    rm -rf /opt/dictee/cuda-venv
    # setup-cuda-venv.sh linked the venv's NVIDIA libraries into
    # /usr/lib/dictee; pacman does not own those links, so without this they
    # would dangle there after the removal (same cleanup as the deb postrm
    # and the rpm %postun).
    if [ -d /usr/lib/dictee ]; then
        find /usr/lib/dictee -maxdepth 1 -type l ! -exec test -e '{}' \; -delete 2>/dev/null || true
    fi
    rmdir /opt/dictee 2>/dev/null || true
    rm -f /etc/udev/rules.d/81-dictee-uinput.rules
}
